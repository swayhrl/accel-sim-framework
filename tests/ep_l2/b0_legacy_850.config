# EP-L2 Target Baseline B0-Legacy overlay.  Apply after QV100 gpgpusim.config.
# C1-C3 only: no WAD, Payload RAM, unified payload, RO/TVD, bypass, or EPL2B0V1.

# C2: fixed 64 KiB L1D = 4 sets x 128 ways x 128 B; preserve QV100 internals.
-gpgpu_adaptive_cache_config 0
-gpgpu_ep_l2_assert_fixed_l1_assoc 1
-gpgpu_cache:dl1 S:4:128:128,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_l1_banks 4
-gpgpu_l1_latency 20

# C1/C3: 64 x 16 sector-tag L2 (1024 resident lines), 128 line MSHRs, and a
# separately configured 256-entry persistent descriptor pool / 32 per line.
# A:128:1 is only the legacy parser carrier for the 128 line entries: it is
# explicitly NOT the descriptor capacity or per-line target-chain definition.
-gpgpu_cache:dl2 S:64:128:16,L:B:m:L:P,A:128:1,128:0,32
-gpgpu_ep_l2_descriptor_pool_size 256
-gpgpu_ep_l2_descriptor_per_line_cap 32

# C1 fixed boundary queues: ICNT->L2 : L2->DRAM : DRAM->L2 : L2->ICNT.
-gpgpu_dram_partition_queues 64:128:64:64
-gpgpu_frfcfs_dram_sched_queue_size 128
-gpgpu_dram_return_queue_size 192
-gpgpu_clock_domains 1132.0:1132.0:1132.0:850.0

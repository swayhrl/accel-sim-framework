-gpgpu_n_mem 16
-gpgpu_n_sub_partition_per_mchannel 1
-gpgpu_memory_partition_indexing 0
-gpgpu_dram_partition_queues 64:1:64:64
-gpgpu_frfcfs_dram_sched_queue_size 1
-gpgpu_l2_char_dram_issue_hold_after_issues 1
-gpgpu_l2_char_dram_issue_hold_cycles 100
-gpgpu_cache:dl2 S:64:128:1,L:B:m:L:L,A:2:4,2:0,1

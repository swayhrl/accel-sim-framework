# Deterministic L2CHARV1 C4 DataPort arm.  One linear-mapped subpartition
# receives the existing dirty-eviction trace; a one-byte data port makes the
# real dirty-victim data read overlap subsequent frontend requests.
-gpgpu_n_mem 1
-gpgpu_n_sub_partition_per_mchannel 1
-gpgpu_memory_partition_indexing 0
-gpgpu_dram_partition_queues 64:2:1:64
-gpgpu_frfcfs_dram_sched_queue_size 1
-gpgpu_dram_return_queue_size 1
-gpgpu_l2_wb_progress_credit 1
-gpgpu_cache:dl2 S:32:128:1,L:B:m:L:P,A:2:1,2:0,1
-gpgpu_l2_char_enable 1
-gpgpu_l2_char_window 16
-gpgpu_l2_char_set_detail 1
-gpgpu_l2_char_emit_windows 1

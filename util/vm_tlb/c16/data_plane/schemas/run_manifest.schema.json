{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at_utc", "scientific_status", "producer", "git", "model", "input", "scenario", "runtime", "capture", "artifacts"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1}, "run_id": {"type": "string", "pattern": "^C16R_"}, "created_at_utc": {"type": "string"}, "scientific_status": {"enum": ["FORMAL", "MECHANISM_ONLY", "DIAGNOSTIC", "PRE_FIX", "OBSOLETE", "INVALID"]},
    "producer": {"type": "object", "required": ["hostname", "gpu_name", "gpu_uuid", "driver", "cuda"]}, "git": {"type": "object", "required": ["repository", "commit", "dirty"]}, "model": {"type": "object", "required": ["model_id", "revision", "asset_receipt_sha256"]}, "input": {"type": "object", "required": ["binding_id", "authority_status", "receipt_sha256", "token_ids_sha256_or_semantic_hash"]},
    "scenario": {"type": "object", "required": ["batch", "prefill_tokens", "decode_tokens", "input_class", "phase"]}, "runtime": {"type": "object", "required": ["python", "torch", "transformers", "dtype", "attention_backend"]}, "capture": {"type": "object", "required": ["instrument", "tool_version", "target", "exact_argv"]},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["relative_path", "size_bytes", "sha256"]}}
  }
}

-gpgpu_dtc_l1_logical_sets 64
-gpgpu_dtc_l1_logical_ways 8
-gpgpu_dtc_l1_invalidate_on_source_event 0
-gpgpu_dtc_l1_progressive_wakeup 0
-gpgpu_dtc_l1_mode 3
-gpgpu_dtc_l1_tag_hash_bankrow 1

# V2 CPU-only planned Physical x OO-PIB combination; no science launch authority.
-gpgpu_dtc_l1_physical_lines 1024
-gpgpu_dtc_l1_oo_pib_entries 192

+  bool reclaim_one_idle_tag(uint64_t cycle) {
+    if (m_cross_reclaim_cycle == cycle) return false;
+    tag_entry *chosen = nullptr;
+    for (tag_entry &tag : m_tags) {
+      if (!tag.valid || tag.physical.id >= m_phys.size()) continue;
+      const physical_line &physical = m_phys[tag.physical.id];
+      if (!physical.allocated || !physical.ready || !physical.tag_valid ||
+          physical.ref_count || !physical.waiters.empty() ||
+          physical.generation != tag.physical.generation) continue;
+      bool pending_return = false;
+      for (const auto &pending : m_service_returns)
+        pending_return |= pending.physical.id == tag.physical.id &&
+                          pending.physical.generation == tag.physical.generation;
+      if (pending_return) continue;
+      if (!chosen || tag.lru < chosen->lru) chosen = &tag;
+    }
+    if (!chosen) return false;
+    const physical_identity identity = chosen->physical;
+    m_phys[identity.id].tag_valid = false;
+    chosen->valid = false;
+    if (m_cfg.finite_service) m_service_map_loss[identity.id] = cycle;
+    ++m_tag_evictions;
+    ++m_immediate_reclaims;
+    release(identity, cycle);
+    m_cross_reclaim_cycle = cycle;
+    ++m_cross_reclaims;
+    return true;
+  }
+  uint64_t m_cross_reclaim_cycle = UINT64_MAX;
+  uint64_t m_cross_reclaims = 0;

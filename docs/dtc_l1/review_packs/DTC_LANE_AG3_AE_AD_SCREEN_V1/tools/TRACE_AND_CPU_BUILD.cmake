# Isolated AG recipe, original Framework sources; no Python binding fetch.
cmake_minimum_required(VERSION 3.17)
project(AG_TRACE_AND_CPU_OPTIONS LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_BUILD_TYPE Release)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
string(REPLACE "-DNDEBUG" "" CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE}")
foreach(required CORE_ROOT FRAMEWORK_ROOT CORE_BUILD CORE_SHA FRAMEWORK_SHA AG_SCRIPTS)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
file(WRITE "${CMAKE_BINARY_DIR}/accelsim_version.h"
 "const char *g_accelsim_version=\"accelsim-AG-framework-${FRAMEWORK_SHA}-core-${CORE_SHA}\";\n")
set(trace_root "${FRAMEWORK_ROOT}/gpu-simulator")
include_directories("${CORE_ROOT}/src" "${CORE_ROOT}/libcuda" "/usr/local/cuda-11.8/include"
 "${CMAKE_BINARY_DIR}" "${trace_root}/ISA_Def" "${trace_root}/trace-driven" "${trace_root}/trace-parser"
 "${FRAMEWORK_ROOT}/util/tracer_nvbit/tracer_tool")
file(GLOB driven_sources "${trace_root}/trace-driven/*.cc")
file(GLOB parser_sources "${trace_root}/trace-parser/*.cc")
add_library(ag_trace_objects OBJECT ${driven_sources} ${parser_sources})
target_compile_definitions(ag_trace_objects PRIVATE DEBUG=0)
add_executable(accel-sim.out "${trace_root}/accel-sim.cc" "${trace_root}/main.cc" $<TARGET_OBJECTS:ag_trace_objects>)
add_executable(ag-options-cpu-probe "${AG_SCRIPTS}/options_cpu_probe.cc" $<TARGET_OBJECTS:ag_trace_objects>)
foreach(target accel-sim.out ag-options-cpu-probe)
 target_compile_definitions(${target} PRIVATE DEBUG=0)
 target_link_libraries(${target} PRIVATE "${CORE_BUILD}/libcudart.so" m z GL zstd pthread dl)
 set_target_properties(${target} PROPERTIES BUILD_RPATH "${CORE_BUILD}")
endforeach()

+++ b/tests/dtc_l1_progressive_ldst_test.cc
@@ -0,0 +1,151 @@
+// CPU component fixture for actual production LDST response/selection/collection/
+// RF WB/ledger retirement/K1/normal-print paths. -fno-access-control is a setup
+// seam only. No kernel, trace body, GPU cycle(), native run or runtime thread.
+#include "gpgpu-sim/gpu-sim.h"
+#include "gpgpu-sim/shader.h"
+#include "gpgpu-sim/icnt_wrapper.h"
+#include "gpgpu-sim/scoreboard.h"
+#include "gpgpu_context.h"
+#include "gpgpusim_entrypoint.h"
+#include "option_parser.h"
+#include <csignal>
+#include <functional>
+#include <ctime>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+static void rejects(const std::function<void()> &f) {
+  auto pid=fork(); assert(pid>=0);
+  if(!pid) { std::signal(SIGABRT,SIG_DFL); f(); _exit(0); }
+  int status; assert(waitpid(pid,&status,0)==pid);
+  assert(WIFSIGNALED(status) && WTERMSIG(status)==SIGABRT);
+}
+int main(int argc, const char **argv) {
+  assert(argc==2); rlimit limit{0,0}; setrlimit(RLIMIT_CORE,&limit);
+  gpgpu_context ctx; gpgpu_sim_config cfg(&ctx);
+  auto parser=option_parser_create(); cfg.reg_options(parser); icnt_reg_options(parser);
+  ctx.ptx_reg_options(parser); ctx.func_sim->ptx_opcocde_latency_options(parser);
+  assert(!cfg.m_shader_config.dtc_l1_progressive_wakeup);
+  option_parser_cfgfile(parser,argv[1]);
+  const char *opts[]={"AD_CPU", "-gpgpu_n_clusters","1", "-gpgpu_n_cores_per_cluster","1",
+    "-gpgpu_n_mem","1", "-gpgpu_n_sub_partition_per_mchannel","1",
+    "-gpgpu_shader_core_pipeline","64:32", "-gpgpu_shader_cta","2",
+    "-gpgpu_smem_latency","2", "-network_mode","2", "-gpgpu_dtc_l1_mode","3",
+    "-gpgpu_dtc_l1_finite_service","1", "-gpgpu_dtc_l1_progressive_wakeup","1",
+    "-gpgpu_dtc_l1_invalidate_on_source_event","1",
+    "-gpgpu_l1_cache_write_ratio","0", "-gpgpu_gmem_skip_L1D","0",
+    "-enable_ptx_file_line_stats","0", "-gpgpu_dtc_l1_debug_event_limit","0",
+    "-power_simulation_enabled","0", "-visualizer_enabled","0",
+    "-gpgpu_clock_domains","1410.0:1410.0:1410.0:850.0"};
+  option_parser_cmdline(parser,sizeof(opts)/sizeof(opts[0]),opts); cfg.init();
+  ctx.the_gpgpusim->g_simulation_starttime=std::time(nullptr);
+  auto *gpu=new exec_gpgpu_sim(cfg,&ctx); gpu->init();
+  auto *core=gpu->get_simt_core_clusters()[0]->get_shader_cores()[0];
+  auto *ld=core->m_ldst_unit; auto &f=*ld->m_dtc_l1_oo_frontend;
+  auto *rf=dynamic_cast<opndcoll_rfu_t *>(ld->m_operand_collector); assert(rf);
+  const auto *sc=gpu->getShaderCoreConfig();
+  auto inst=[&](unsigned uid, bool reg=false) {
+    warp_inst_t i(sc);
+    // Real decoders initialize every output slot; inst_t's constructor only
+    // zeros sizeof(unsigned) bytes. Synthetic instructions must do the rest.
+    std::fill(std::begin(i.out),std::end(i.out),0U);
+    active_mask_t active; active.set(0);
+    i.issue(active,0,1,0,0,0); i.m_uid=uid; i.pc=0; i.op=LOAD_OP; i.op_pipe=MEM__OP;
+    i.space=memory_space_t(global_space); i.cache_op=CACHE_ALL;
+    if(reg) { i.out[0]=1; i.arch_reg.dst[0]=1; }
+    return i;
+  };
+  auto fence=inst(90); fence.m_is_proxy_fence=true;
+  assert(ld->dtc_l1_m4_observe_admit(fence,ldst_unit::dtc_l1_m4_operation::PROXY_FENCE));
+  auto admit=[&](unsigned uid) {
+    auto i=inst(uid,uid==100); assert(f.admit(uid));
+    if(uid==100) { ld->m_pending_writes[0][1]=1; ld->m_scoreboard->reserveRegisters(&i); }
+    const std::vector<dtc_l1::line_reference> refs{{0,1}};
+    ld->dtc_l1_r4c0_record_issue(i,refs,1);
+    // Source issue accounting for these explicitly injected CPU instructions.
+    ++ld->m_dtc_l1_oo_completion_dependencies;
+    ld->m_dtc_l1_oo_pib.push_back({i,refs,1});
+    ld->dtc_l1_r4c0_record_pib(i,refs,"OO");
+    return f.access(gpu->global_cycle(),uid,0).physical;
+  };
+  gpu->gpu_sim_cycle=10; f.advance_service(10);
+  dtc_l1::physical_identity id{};
+  for(unsigned uid=100;uid<109;++uid) id=admit(uid);
+  auto root=[&](dtc_l1::physical_identity identity) {
+    mem_access_t access(GLOBAL_ACC_R,0,128,false,&ctx);
+    auto *r=new mem_fetch(access,(const warp_inst_t *)nullptr,0,8,0,0,0,&cfg.m_memory_config,gpu->global_cycle());
+    assert(gpu->dtc_l1_try_acquire_lower_request());
+    // This CPU fixture injects the already-created, already-issued root.
+    ++ld->m_dtc_l1_oo_lower_created; ++ld->m_dtc_l1_oo_lower_issued;
+    assert(ld->m_dtc_l1_oo_inflight.emplace(r->get_request_uid(),
+        ldst_unit::dtc_l1_oo_inflight{identity,0,100,15,0}).second);
+    return r;
+  };
+  auto sector=[&](mem_fetch *r,unsigned n,bool write=false) {
+    mem_access_t access(write?GLOBAL_ACC_W:GLOBAL_ACC_R,n*32,32,write,&ctx);
+    auto *s=new mem_fetch(access,(const warp_inst_t *)nullptr,0,8,0,0,0,&cfg.m_memory_config,gpu->global_cycle(),r);
+    s->set_reply(); assert(ld->dtc_l1_oo_consume_response(s));
+  };
+  auto *r=root(id);
+  sector(r,0); assert(f.wakeups()==0 && !f.entry_returns_complete_for(100));
+  rejects([&]{sector(r,0);}); // duplicate sector reaches real consume assertion
+  rejects([&]{sector(r,4);}); // out-of-line sector
+  rejects([&]{sector(r,1,true);}); // write reply is not a load fill
+  sector(r,2); sector(r,1);
+  assert(!f.entry_ready_for(100) && !f.entry_returns_complete_for(100));
+  sector(r,3); assert(f.entry_returns_complete_for(100) && f.wakeups()==0);
+  f.advance_service(10); assert(!f.entry_ready_for(100));
+  gpu->gpu_sim_cycle=11; f.advance_service(11);
+  assert(f.entry_ready_for(100) && !f.entry_ready_for(104));
+  uint64_t selected=0;
+  assert(!ld->dtc_l1_oo_select_ready(&selected)); // same-warp fence still gates
+  ld->dtc_l1_m4_observe_complete(fence);
+  assert(ld->dtc_l1_oo_writeback_ready()); // fence sidecar, no data WB/Ref
+  assert(!ld->dtc_l1_oo_writeback_ready()); // one retirement per cycle
+  auto *first=ld->dtc_l1_oo_find_entry(100); first->next_reference=0;
+  assert(ld->dtc_l1_oo_select_ready(&selected) && selected==101); // partial admission excluded
+  first->next_reference=1;
+  assert(ld->dtc_l1_oo_select_ready(&selected) && selected==100);
+  assert(admit(109).id==id.id && !f.entry_ready_for(109)); // late merge consumes future quota
+  f.advance_service(11); assert(f.wakeups()==4 && !f.entry_ready_for(109));
+  // Hold ordinary pending-commit; K1 hides lookup NOW, preserves return/Ref.
+  ld->m_L1D->m_extra_mf_fields.emplace(nullptr,baseline_cache::extra_mf_fields());
+  ld->invalidate(dtc_l1::invalidation_source::IDLE_CLUSTER);
+  assert(!f.tag_visible(id) && f.ref_count(id)==10 && ld->m_L1D->m_invalidate_pending);
+  ld->cycle(); // actual LDST sample observes own-ready at 11; no collection at ready edge
+  assert(first->service.ready_cycle==11 && first->service.admitted_returns_cycle==11);
+  assert(first->service.collect_done_cycle==UINT64_MAX && f.ref_count(id)==10);
+  gpu->gpu_sim_cycle=12; rf->process_banks(); ld->cycle();
+  assert(f.wakeups()==8 && !f.entry_ready_for(108) && !f.entry_ready_for(109));
+  assert(first->service.collect_done_cycle==12 && f.ref_count(id)==10);
+  gpu->gpu_sim_cycle=13; rf->process_banks();
+  auto competing=inst(999,true); assert(rf->writeback(competing)); // real RF bank reservation
+  ld->cycle();
+  assert(f.wakeups()==10 && f.entry_ready_for(109));
+  assert(ld->m_dtc_l1_oo_ready_but_wb_blocked_cycles==1 && f.ref_count(id)==10);
+  assert(ld->m_pending_writes[0][1]==1 && ld->m_dtc_l1_r4c0_completion_trace.count(100)==1);
+  assert(ld->m_L1D->m_extra_mf_fields.erase(nullptr)==1);
+  gpu->gpu_sim_cycle=14; rf->process_banks(); ld->cycle();
+  assert(!ld->dtc_l1_oo_find_entry(100) && f.ref_count(id)==9);
+  assert(ld->m_pending_writes[0].count(1)==0 && ld->m_dtc_l1_r4c1_retired_history.at(100).closed_dependencies==1);
+  for(unsigned cycle=15;!ld->m_dtc_l1_oo_pib.empty();++cycle) {
+    assert(cycle<50); gpu->gpu_sim_cycle=cycle; rf->process_banks(); ld->cycle();
+  }
+  assert(!f.is_allocated(id) && f.active_refs()==0 && f.final_ref_reclaims()==1);
+  assert(gpu->dtc_l1_lower_outstanding()==0 && ld->m_dtc_service_retired==10);
+  assert(ld->m_dtc_progressive_collectable_entries==10);
+  // Stale physical/generation via actual LDST complete after four legal sectors.
+  rejects([&]{auto *stale=root(id); for(unsigned s=0;s<4;++s) sector(stale,s);});
+  f.assert_shadow_refs();
+  auto *stream=tmpfile(); assert(stream);
+  auto print=[&] { gpu->shader_print_dtc_l1_stats(stream); fflush(stream); };
+  print(); auto size=ftell(stream); auto counters=ld->m_dtc_progressive_returns_to_retire_sum;
+  print(); assert(ftell(stream)==size*2 && counters==ld->m_dtc_progressive_returns_to_retire_sum);
+  rewind(stream); char buffer[4096]; while(auto n=fread(buffer,1,sizeof(buffer),stream)) fwrite(buffer,1,n,stdout);
+  fclose(stream);
+  gpu->gpu_print_stat(0); // actual normal entrypoint, no GPU cycle()/kernel
+  std::printf("AD_HOST_LAYOUT physical_line=%zu entry=%zu config=%zu service=%zu frontend=%zu ldst=%zu\n",
+      sizeof(dtc_l1::oo_frontend::physical_line), sizeof(dtc_l1::oo_frontend::entry),
+      sizeof(dtc_l1::config), sizeof(dtc_l1::service_entry), sizeof(dtc_l1::oo_frontend), sizeof(ldst_unit));
+  std::puts("PASS real_LDST legal_4x32 sectors duplicate illegal stale_generation plus1 own_ready late_merge partial_admission collection RF_WB_backpressure ledger_retire K1 final_ref fence_sidecar normal_export_repeat_readonly kernels=0 gpu_cycle_calls=0 threads_started=0 payload_values=UNPROVEN");
+}
diff --git a/tests/dtc_l1_progressive_wakeup_test.cc b/tests/dtc_l1_progressive_wakeup_test.cc
new file mode 100644
index 00000000..d36398ac
--- /dev/null
+++ b/tests/dtc_l1_progressive_wakeup_test.cc
@@ -0,0 +1,131 @@
+// CPU-only production-header state machine checks; no payload/value oracle.
+#include "dtc-l1-common.h"
+#include <csignal>
+#include <functional>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+using namespace dtc_l1;
+static config settings(bool enabled = true) {
+  config c;
+  c.selected_mode = mode::PAPER_OO;
+  c.finite_service = true;
+  c.progressive_wakeup = enabled;
+  c.oo_pib_entries = 16;
+  c.physical_lines = 2;
+  c.logical_sets = c.logical_ways = 1;
+  return c;
+}
+static void rejects(const std::function<void()> &f) {
+  const pid_t pid = fork(); assert(pid >= 0);
+  if (!pid) { f(); _exit(0); }
+  int status; assert(waitpid(pid, &status, 0) == pid);
+  assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT);
+}
+static void fanout(unsigned n, bool on) {
+  oo_frontend f(settings(on));
+  f.advance_service(10);
+  physical_identity id{};
+  for (unsigned uid = 1; uid <= n; ++uid) {
+    assert(f.admit(uid)); id = f.access(10, uid, 0).physical;
+  }
+  f.complete(id);
+  assert(!f.entry_ready_for(1));
+  f.advance_service(10); // complete->advance cannot collapse the +1 boundary
+  assert(!f.entry_ready_for(1) && f.wakeups() == 0);
+  for (unsigned edge = 1; edge <= (n + 3) / 4; ++edge) {
+    f.advance_service(10 + edge);
+    const unsigned notified = std::min(n, edge * 4);
+    assert(f.wakeups() == notified && f.ref_count(id) == n);
+    for (unsigned uid = 1; uid <= n; ++uid)
+      assert(f.entry_ready_for(uid) == (on ? uid <= notified : notified == n));
+    f.advance_service(10 + edge);
+    assert(f.wakeups() == notified); // no same-cycle quota reuse
+  }
+  for (unsigned uid = 1; uid <= n; ++uid) {
+    assert(f.retire_ready_uid(20 + uid, uid));
+    if (uid != n) assert(!f.retire_ready_uid(20 + uid, uid + 1));
+  }
+  assert(f.ref_count(id) == 0 && f.is_allocated(id));
+  assert(f.invalidate_lookup(50).reclaimed == 1 && !f.is_allocated(id));
+  std::printf("PASS fanout=%u progressive=%u quota=4 plus1=preserved\n", n, on);
+}
+static void lifecycle() {
+  oo_frontend f(settings());
+  f.advance_service(1);
+  physical_identity old{};
+  for (unsigned uid = 1; uid <= 9; ++uid) {
+    assert(f.admit(uid)); old = f.access(1, uid, 0).physical;
+  }
+  f.complete(old); f.advance_service(2);
+  const auto slot = f.entry_slot(1); const auto gen = f.entry_slot_generation(1);
+  assert(f.retire_ready_uid(2, 1)); // leaves processed stale waiter slot behind
+  assert(f.admit(10) && f.entry_slot(10) == slot && f.entry_slot_generation(10) > gen);
+  assert(f.access(2, 10, 0).kind == io_access_kind::PENDING_HIT);
+  // Repeated same-ref admission is not a second waiter/Ref.
+  f.access(2, 10, 0);
+  assert(!f.entry_ready_for(10) && f.ref_count(old) == 9);
+  f.advance_service(2); assert(f.wakeups() == 4 && !f.entry_ready_for(10));
+  const auto lost = f.invalidate_lookup(2);
+  assert(lost.changed == 1 && lost.retained == 1 && !f.tag_visible(old));
+  assert(f.admit(11));
+  const auto newer = f.access(3, 11, 0).physical;
+  assert(newer.id != old.id && f.is_allocated(old));
+  f.complete(newer);
+  f.advance_service(3); assert(f.wakeups() == 8 && !f.entry_ready_for(9) && !f.entry_ready_for(10));
+  f.advance_service(4); assert(f.wakeups() == 11 && f.entry_ready_for(10) && f.entry_ready_for(11));
+  for (unsigned uid = 2; uid <= 10; ++uid) assert(f.retire_ready_uid(10 + uid, uid));
+  assert(!f.is_allocated(old) && f.is_allocated(newer));
+  assert(f.retire_ready_uid(21, 11));
+  assert(f.admit(12));
+  assert(f.access(22, 12, 0).kind == io_access_kind::VALID_HIT);
+  assert(f.entry_ready_for(12) && f.wakeups() == 11); // after end: no new broadcast
+  f.add_external_dependency(12); assert(!f.entry_ready_for(12));
+  f.complete_external_dependency(12); assert(f.entry_ready_for(12));
+  f.invalidate_lookup(23); f.advance_service(24); assert(f.retire_ready_uid(24, 12));
+  assert(f.allocated_lines() == 0 && f.active_refs() == 0);
+  // Recycle the physical slot. An old return must fail, never wake new owners.
+  assert(f.admit(13)); f.access(25, 13, 128);
+  assert(f.admit(14)); f.access(26, 14, 256);
+  assert(!f.fill_identity_matches(old));
+  rejects([&]{ f.complete(old); });
+  f.print_progressive_summary(stdout, 0);
+  std::puts("PASS late_merge slot_reuse generation K1 old_return final_ref external_dependency");
+}
+static void multi_reference_and_replacement() {
+  oo_frontend f(settings()); f.advance_service(1);
+  assert(f.admit(1)); auto a = f.access(1, 1, 0).physical;
+  auto b = f.access(1, 1, 128).physical; // tag victim retains old physical Ref
+  assert(!f.tag_visible(a) && f.ref_count(a) == 1);
+  assert(f.admit(2));
+  assert(f.access(1, 2, 256).kind == io_access_kind::NO_FREE_LINE); // partial admission: no rollback
+  assert(f.ref_count(a) == 1 && f.ref_count(b) == 1);
+  f.complete(a); f.advance_service(2); assert(!f.entry_ready_for(1));
+  f.complete(b); f.advance_service(3); assert(f.entry_ready_for(1));
+  // Successful retirement is the only ref decrement; readiness did not free a.
+  assert(f.ref_count(a) == 1 && f.is_allocated(a));
+  f.advance_service(4);
+  assert(f.retire_ready_uid(4, 1) && !f.is_allocated(a));
+  assert(f.access(4, 2, 256).kind == io_access_kind::NEW_MISS);
+  f.assert_shadow_refs();
+  std::puts("PASS multiple_allocations partial_allocation tag_victim last_ref");
+}
+int main() {
+  rlimit limit{0, 0}; setrlimit(RLIMIT_CORE, &limit);
+  for (unsigned n : {4, 5, 8, 9}) for (bool on : {false, true}) fanout(n, on);
+  lifecycle(); multi_reference_and_replacement();
+  for (unsigned selected = 0; selected <= 4; ++selected)
+    for (bool finite : {false, true}) {
+      if (selected == 3 && finite) continue;
+      rejects([=]{ check_progressive_wakeup_mode(true, selected, finite); });
+    }
+  rejects([]{ config c=settings(); io_frontend wrong(c); });
+  rejects([]{ config c=settings(); sector_oo_frontend wrong(c); });
+  rejects([]{ config c=settings(); paper_frontend wrong(c); });
+  rejects([]{ oo_frontend f(settings()); f.advance_service(1); f.admit(1);
+    auto id=f.access(1,1,0).physical; f.complete(id); f.complete(id); });
+  assert(!response_sector_is_new(15, 1, 0));
+  assert(!response_sector_is_new(15, 0, 4));
+  std::printf("PASS fail_closed sizeof_config=%zu sizeof_service_entry=%zu sizeof_oo=%zu\n",
+      sizeof(config), sizeof(service_entry), sizeof(oo_frontend));
+}
diff --git a/tests/dtc_l1_tag_hash_bankrow_test.cc b/tests/dtc_l1_tag_hash_bankrow_test.cc
new file mode 100644
index 00000000..067a062a
--- /dev/null
+++ b/tests/dtc_l1_tag_hash_bankrow_test.cc
@@ -0,0 +1,109 @@
+// CPU-only directed production-frontend test; no kernel/native application.
+// Compile the SAME source against the fixed baseline and AE include roots.
+// -fno-access-control exposes snapshots without changing production headers.
+#include "dtc-l1-common.h"
+#include "option_parser.cc"  // Actual parser, one translation unit per build.
+#include <iostream>
+#include <string>
+#include <sys/resource.h>
+
+#ifdef NDEBUG
+#error Assertions required for this CPU qualification
+#endif
+using namespace dtc_l1;
+static config settings(unsigned sets,unsigned ways,int setting){
+ config c;c.selected_mode=mode::PAPER_OO;c.finite_service=true;
+ c.logical_sets=sets;c.logical_ways=ways;
+#ifdef DTC_AE_NEW
+ if(setting>=0)c.tag_hash_bankrow=setting;
+#else
+ assert(setting<=0);
+#endif
+ return c;
+}
+static unsigned actual_set(const oo_frontend&f,uint64_t a){
+#ifdef DTC_AE_NEW
+ return f.tag_set(a);
+#else
+ return static_cast<unsigned>((a/128)%f.m_cfg.logical_sets);
+#endif
+}
+static void state(const oo_frontend&f,const char*phase,uint64_t cycle,uint64_t uid,uint64_t a,int kind){
+ f.assert_shadow_refs();std::cout<<"{\"phase\":\""<<phase<<"\",\"cycle\":"<<cycle<<",\"uid\":"<<uid<<",\"address\":"<<a<<",\"set\":"<<actual_set(f,a)<<",\"kind\":"<<kind<<",\"misses\":"<<f.new_misses()<<",\"hits\":"<<f.valid_hits()<<",\"pending\":"<<f.pending_hits()<<",\"evictions\":"<<f.tag_evictions()<<",\"allocated\":"<<f.allocated_lines()<<",\"refs\":"<<f.active_refs()<<",\"pib\":"<<f.occupancy()<<",\"clock\":"<<f.m_lru_clock<<",\"rr\":"<<f.m_rr_next<<",\"tag_requests\":"<<f.tag_requests()<<",\"conflicts\":"<<f.tag_conflicts()<<",\"map_loss\":["<<f.map_loss_to_free_sum()<<","<<f.map_loss_to_free_count()<<"],\"tags\":[";
+ bool comma=false;for(unsigned i=0;i<f.m_tags.size();++i){const auto&t=f.m_tags[i];if(!t.valid)continue;if(comma)std::cout<<",";comma=true;std::cout<<"["<<i<<","<<t.line<<","<<t.physical.id<<","<<t.physical.generation<<","<<t.lru<<"]";}
+ std::cout<<"],\"physical\":[";comma=false;for(unsigned i=0;i<f.m_phys.size();++i){const auto&p=f.m_phys[i];if(!p.allocated)continue;if(comma)std::cout<<",";comma=true;std::cout<<"["<<i<<","<<p.generation<<","<<p.tag_valid<<","<<p.ref_count<<","<<p.ready<<","<<p.waiters.size()<<"]";}std::cout<<"]}\n";
+}
+static io_access_result transaction(oo_frontend&f,uint64_t uid,uint64_t address){
+ const uint64_t t=4*uid;f.advance_service(t);assert(f.try_serve_tag(t,address));
+ service_entry service;service.tag_grant_cycle=t;assert(!service.tag_can_commit(t)&&service.tag_can_commit(t+1));
+ // Preserve historical precheck recency, even though this test has no full queue.
+ bool miss=f.will_new_miss(address);assert(f.admit(uid));f.advance_service(t+1);
+ auto r=f.access(t+1,uid,address);assert((r.kind==io_access_kind::NEW_MISS)==miss);
+ assert(r.kind!=io_access_kind::NO_FREE_LINE);if(miss)f.complete(r.physical);
+ f.advance_service(t+2);assert(f.entry_ready_for(uid));assert(f.retire_ready_uid(t+3,uid));
+ state(f,"request",t+3,uid,address,static_cast<int>(r.kind));return r;
+}
+static void trace(config c,const std::string&sequence){
+ oo_frontend f(c);uint64_t uid=0;
+ for(unsigned pass=0;pass<3;++pass){unsigned count=sequence=="adversary"?c.logical_ways+1:32;
+  for(unsigned k=0;k<count;++k){uint64_t line=sequence=="stride4096"?32ULL*k:sequence=="neutral"?k:4ULL*k+uint64_t(k)*c.logical_sets;transaction(f,++uid,line*128);}}
+ std::cout<<"{\"summary\":\"trace\",\"sequence\":\""<<sequence<<"\",\"requests\":"<<uid<<",\"misses\":"<<f.new_misses()<<",\"hits\":"<<f.valid_hits()<<",\"evictions\":"<<f.tag_evictions()<<",\"allocated\":"<<f.allocated_lines()<<",\"refs\":"<<f.active_refs()<<",\"tag_count\":"<<f.m_tags.size()<<",\"physical_capacity\":"<<f.m_phys.size()<<",\"pib_capacity\":"<<f.m_slots.size()<<",\"tag_entry_bytes\":"<<sizeof(f.m_tags[0])<<",\"physical_entry_bytes\":"<<sizeof(f.m_phys[0])<<"}\n";
+}
+static void mappings(config c){
+ oo_frontend f(c);uint64_t digest=14695981039346656037ULL,count=0;
+ auto visit=[&](uint64_t address){unsigned set=actual_set(f,address);assert(set<c.logical_sets);for(unsigned i=0;i<8;++i){digest^=(address>>(8*i))&255;digest*=1099511628211ULL;}for(unsigned i=0;i<4;++i){digest^=(set>>(8*i))&255;digest*=1099511628211ULL;}++count;};
+ for(uint64_t line=0;line<4096;++line)for(unsigned offset:{0U,1U,127U})visit(line*128+offset);
+ uint64_t x=0x123456789abcdef0ULL;for(unsigned i=0;i<64;++i){x^=x<<13;x^=x>>7;x^=x<<17;visit((x&((1ULL<<57)-1))<<7);}
+ std::cout<<"{\"summary\":\"mapping\",\"count\":"<<count<<",\"fnv64\":"<<digest<<",\"stride_sets\":[";
+ for(unsigned bank=0;bank<4;++bank){if(bank)std::cout<<",";std::cout<<"[";for(unsigned k=0;k<32;++k){if(k)std::cout<<",";std::cout<<actual_set(f,4096ULL*k+128*bank);}std::cout<<"]";}
+ std::cout<<"]}\n";
+}
+static void conflicts(config c){
+ oo_frontend f(c);for(unsigned bank=0;bank<4;++bank){assert(f.try_serve_tag(1,128*bank));assert(!f.try_serve_tag(1,4096+128*bank));}
+ assert(f.tag_requests()==4&&f.tag_conflicts()==4);
+ c.tag_requests_per_cycle=1;oo_frontend narrow(c);assert(narrow.try_serve_tag(1,0));assert(!narrow.try_serve_tag(1,128));assert(narrow.try_serve_tag(2,128));
+ std::cout<<"{\"summary\":\"conflicts\",\"default_granted\":"<<f.tag_requests()<<",\"default_denied\":"<<f.tag_conflicts()<<",\"global1_granted\":"<<narrow.tag_requests()<<",\"global1_denied\":"<<narrow.tag_conflicts()<<"}\n";
+}
+static void lru(config c){
+ oo_frontend f(c);std::vector<uint64_t>a;for(uint64_t line=0;line<65536&&a.size()<c.logical_ways+1;++line)if(actual_set(f,line*128)==0)a.push_back(line*128);assert(a.size()==c.logical_ways+1);
+ for(unsigned i=0;i<c.logical_ways;++i)transaction(f,i+1,a[i]);
+ auto clock=f.m_lru_clock;assert(!f.will_new_miss(a[0]));assert(f.m_lru_clock==clock+1);assert(f.select_victim(a.back())->line==a[1]);
+ transaction(f,c.logical_ways+1,a.back());assert(f.will_new_miss(a[1]));assert(!f.will_new_miss(a[0]));
+ std::cout<<"{\"summary\":\"lru\",\"evicted_address\":"<<a[1]<<",\"probe_promoted_address\":"<<a[0]<<",\"evictions\":"<<f.tag_evictions()<<",\"precheck_recency_preserved\":true}\n";
+}
+static void late(config c){
+ oo_frontend f(c);physical_identity old{};
+ for(unsigned uid=1;uid<=6;++uid){f.advance_service(2*uid);assert(f.try_serve_tag(2*uid,0));assert(f.admit(uid));f.advance_service(2*uid+1);auto r=f.access(2*uid+1,uid,0);if(uid==1){assert(r.kind==io_access_kind::NEW_MISS);old=r.physical;}else assert(r.kind==io_access_kind::PENDING_HIT);}
+ assert(f.try_serve_tag(13,0));service_entry grant;grant.tag_grant_cycle=13;f.complete(old);f.advance_service(14);assert(f.wakeups()==4&&!f.entry_ready_for(1));assert(grant.tag_can_commit(14));assert(f.admit(7));assert(f.access(14,7,0).kind==io_access_kind::PENDING_HIT);
+ auto e=f.invalidate_lookup(14);assert(e.changed==1&&e.retained==1&&e.reclaimed==0);assert(f.ref_count(old)==7&&!f.tag_visible(old));assert(f.will_new_miss(0));assert(!f.invalidate_lookup(14).changed);state(f,"old_hidden",14,7,0,-1);
+ assert(f.try_serve_tag(14,0));f.advance_service(15);assert(f.wakeups()==7);assert(f.admit(8));auto next=f.access(15,8,0);assert(next.kind==io_access_kind::NEW_MISS&&next.physical.id!=old.id);assert(f.ref_count(old)==7&&f.fill_identity_matches(old));f.complete(next.physical);state(f,"same_address_new",15,8,0,int(next.kind));
+ for(unsigned uid=1;uid<=7;++uid){f.advance_service(15+uid);assert(f.retire_ready_uid(15+uid,uid));assert(f.is_allocated(old)==(uid!=7));}
+ f.advance_service(23);assert(f.retire_ready_uid(23,8));assert(f.invalidate_lookup(24).reclaimed==1);assert(f.active_refs()==0&&f.allocated_lines()==0&&f.occupancy()==0);assert(f.map_loss_to_free_sum()==8&&f.map_loss_to_free_count()==2);
+ std::cout<<"{\"summary\":\"late_k1\",\"wakeups\":"<<f.wakeups()<<",\"pending_hits\":"<<f.pending_hits()<<",\"misses\":"<<f.new_misses()<<",\"retired\":"<<f.retires()<<",\"refs\":"<<f.active_refs()<<",\"allocated\":"<<f.allocated_lines()<<",\"map_loss_sum\":"<<f.map_loss_to_free_sum()<<",\"map_loss_count\":"<<f.map_loss_to_free_count()<<"}\n";
+}
+int main(int argc,const char**argv){
+ rlimit limit{0,0};setrlimit(RLIMIT_CORE,&limit);if(argc<2)return 64;std::string test=argv[1];
+ if(test=="options"){

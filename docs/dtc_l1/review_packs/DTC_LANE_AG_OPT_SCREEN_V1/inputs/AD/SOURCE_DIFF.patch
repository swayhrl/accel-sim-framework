+  ld->m_L1D->m_extra_mf_fields.emplace(nullptr,baseline_cache::extra_mf_fields());
+  ld->invalidate(dtc_l1::invalidation_source::IDLE_CLUSTER);
+  assert(!f.tag_visible(id) && f.ref_count(id)==10 && ld->m_L1D->m_invalidate_pending);

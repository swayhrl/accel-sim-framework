+  };
+  gpu->gpu_sim_cycle=10; f.advance_service(10);
+  dtc_l1::physical_identity id{};
+  for(unsigned uid=100;uid<109;++uid) id=admit(uid);
+  auto root=[&](dtc_l1::physical_identity identity) {

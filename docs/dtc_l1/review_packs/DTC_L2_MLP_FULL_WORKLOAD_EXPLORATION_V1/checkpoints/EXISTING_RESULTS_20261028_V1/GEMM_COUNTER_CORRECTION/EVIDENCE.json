          "last_line": 138,
          "lines": [
            "__global__ void gemm_kernel(DATA_TYPE *a, DATA_TYPE *b, DATA_TYPE *c)",
            "{",
            "\tint j = blockIdx.x * blockDim.x + threadIdx.x;",
            "\tint i = blockIdx.y * blockDim.y + threadIdx.y;",
            "",
            "\tif ((i < NI) && (j < NJ))",
            "\t{\t",
            "\t\tc[i * NJ + j] *= BETA;",
            "\t\tint k;",
            "\t\tfor(k=0; k < NK; k++)",
            "\t\t{",
            "\t\t\tc[i * NJ + j] += ALPHA * a[i * NK + k] * b[k * NJ +j];",
            "\t\t}",
            "\t}",
            "}"

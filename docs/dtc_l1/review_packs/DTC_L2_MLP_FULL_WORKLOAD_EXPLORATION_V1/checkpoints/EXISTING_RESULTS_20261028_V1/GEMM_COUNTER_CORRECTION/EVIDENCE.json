            "#define NI 512",
            "#define NJ 512",
            "#define NK 512",
            "",
            "/* Thread block dimensions */",
            "#define DIM_THREAD_BLOCK_X 32",
            "#define DIM_THREAD_BLOCK_Y 8",
            "",
            "/* Declared constant values for ALPHA and BETA (same as values in PolyBench 2.0) */"

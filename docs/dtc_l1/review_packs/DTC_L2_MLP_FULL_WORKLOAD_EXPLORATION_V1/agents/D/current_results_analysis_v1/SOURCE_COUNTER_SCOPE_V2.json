              "line": 3045,
              "text": "         service.collect_done_cycle != UINT64_MAX && !service.sectors_left);"
            },
            {
              "line": 3046,
              "text": "  m_dtc_service_retire.commit(cycle);"
            },
            {
              "line": 3047,
              "text": "  m_dtc_service_ready_to_complete_sum += cycle - service.ready_cycle;"
            },
            {
              "line": 3048,
              "text": "  m_dtc_service_ready_to_collect_sum += service.collect_start_cycle - service.ready_cycle;"
            },
            {
              "line": 3049,
              "text": "  m_dtc_service_collection_cycles += service.collect_done_cycle - service.collect_start_cycle + 1;"
            },
            {
              "line": 3050,
              "text": "  m_dtc_service_wb_wait += cycle - service.collect_done_cycle - 1;"
            },
            {
              "line": 3051,
              "text": "  if (m_config->dtc_l1_progressive_wakeup) {"

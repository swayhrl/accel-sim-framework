              "line": 3041,
              "text": "void ldst_unit::dtc_l1_service_retired(const dtc_l1::service_entry &service) {"
            },
            {
              "line": 3042,
              "text": "  if (!dtc_l1_finite_service_active()) return;"
            },
            {
              "line": 3043,
              "text": "  const uint64_t cycle = m_core->get_gpu()->global_cycle();"
            },
            {
              "line": 3044,
              "text": "  assert(service.ready_cycle != UINT64_MAX &&"
            },

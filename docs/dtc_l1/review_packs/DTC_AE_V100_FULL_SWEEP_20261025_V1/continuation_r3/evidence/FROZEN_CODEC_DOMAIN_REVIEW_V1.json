        "",
        "  for (int s = 0; s < 32; s++) {",
        "    if (mask.test(s) && !first_bit1_found) {",
        "      first_bit1_found = true;",
        "      base_addr = addrs[s];",
        "      if (s < 31 && mask.test(s + 1))",
        "        stride = addrs[s + 1] - addrs[s];",

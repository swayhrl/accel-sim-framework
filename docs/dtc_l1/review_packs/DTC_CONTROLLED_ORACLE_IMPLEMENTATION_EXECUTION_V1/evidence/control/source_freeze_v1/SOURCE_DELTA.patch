diff --git a/src/gpgpu-sim/dtc-oracle-l1.h b/src/gpgpu-sim/dtc-oracle-l1.h
new file mode 100644
index 0000000..d829f4f
--- /dev/null
+++ b/src/gpgpu-sim/dtc-oracle-l1.h
@@ -0,0 +1,79 @@
+// Controlled counterfactual L1 data-availability ownership. No mem_fetch,
+// ordinary lower credits, or fabricated responses are created by this queue.
+#ifndef DTC_ORACLE_L1_H
+#define DTC_ORACLE_L1_H
+#include <cassert>
+#include <cstdint>
+#include <deque>
+#include "dtc-l1-common.h"
+namespace dtc_l1 {
+class oracle_l1_events {
+ public:
+  struct event {
+    uint64_t uid;
+    physical_identity physical;
+    uint64_t line_address;
+    unsigned owner_kernel_uid;
+    uint64_t admitted_cycle;
+    uint64_t ready_cycle;
+  };
+  explicit oracle_l1_events(unsigned capacity = 640) : m_capacity(capacity) {
+    assert(capacity);
+  }
+  void enqueue(uint64_t cycle, physical_identity identity, uint64_t address,
+               unsigned owner_kernel_uid) {
+    assert(identity.generation && !(address & (kLogicalLineBytes - 1)));
+    assert(cycle != UINT64_MAX && m_pending.size() < m_capacity);
+    for (const auto &other : m_pending)
+      assert((other.physical.id != identity.id ||
+              other.physical.generation != identity.generation) &&
+             "one virtual event per physical generation");
+    assert(m_pending.empty() || m_pending.back().admitted_cycle <= cycle);
+    m_pending.push_back({++m_enqueued, identity, address, owner_kernel_uid,
+                         cycle, cycle + 1});
+    assert_conservation();
+  }
+  // Created only by the existing finite Tag/allocation pipeline. All due
+  // generations can become available together; original complete() still
+  // applies finite notifications. No extra refill/return service is claimed.
+  template <class Frontend>
+  void deliver(uint64_t cycle, Frontend &frontend) {
+    if (cycle == m_last_delivery_cycle) return;
+    assert(m_last_delivery_cycle == UINT64_MAX || cycle > m_last_delivery_cycle);
+    m_last_delivery_cycle = cycle;
+    while (!m_pending.empty() && m_pending.front().ready_cycle <= cycle) {
+      const event current = m_pending.front();
+      assert(cycle > current.admitted_cycle);
+      assert(frontend.fill_identity_matches(current.physical) &&
+             "virtual event must match original live physical generation");
+      frontend.complete(current.physical);
+      m_pending.pop_front();
+      ++m_delivered;
+      assert_conservation();
+    }
+  }
+  bool pending(unsigned kernel_uid = 0) const {
+    if (!kernel_uid) return !m_pending.empty();
+    for (const auto &current : m_pending)
+      if (current.owner_kernel_uid == kernel_uid) return true;
+    return false;
+  }
+  size_t size() const { return m_pending.size(); }
+  uint64_t enqueued() const { return m_enqueued; }
+  uint64_t delivered() const { return m_delivered; }
+  void assert_conservation() const {
+    assert(m_enqueued == m_delivered + m_pending.size());
+  }
+  void assert_drained() const {
+    assert_conservation();
+    assert(m_pending.empty() && m_enqueued == m_delivered);
+  }
+ private:
+  unsigned m_capacity;
+  std::deque<event> m_pending;
+  uint64_t m_enqueued = 0;
+  uint64_t m_delivered = 0;
+  uint64_t m_last_delivery_cycle = UINT64_MAX;
+};
+}  // namespace dtc_l1
+#endif
diff --git a/src/gpgpu-sim/dtc-oracle-m.h b/src/gpgpu-sim/dtc-oracle-m.h
new file mode 100644
index 0000000..7689cb0
--- /dev/null
+++ b/src/gpgpu-sim/dtc-oracle-m.h
@@ -0,0 +1,79 @@
+#ifndef DTC_CONTROLLED_ORACLE_M_H
+#define DTC_CONTROLLED_ORACLE_M_H
+#include <cassert>
+#include <cstdint>
+#include <deque>
+#include <set>
+#include <algorithm>
+namespace dtc_oracle {
+// Exactly one finite parent descriptor per already-admitted lower credit.
+// No payload cache and no additional request admission are implemented here.
+template <class Parent> class finite_read_sequencer {
+ public:
+  struct parent {
+    Parent *request;
+    unsigned uid;
+    uint64_t accepted_tick;
+    uint8_t required;
+    uint8_t transferred = 0;
+  };
+  struct sector { Parent *request; unsigned index; };
+  explicit finite_read_sequencer(unsigned capacity = 1) : m_capacity(capacity) {
+    assert(capacity);
+  }
+  void set_capacity(unsigned n) { assert(n && empty()); m_capacity = n; }
+  void enqueue(Parent *request, unsigned uid, uint8_t mask, uint64_t tick) {
+    assert(request && mask && !(mask & ~0xFU));
+    assert(m_parents.size() < m_capacity);
+    assert(m_uids.insert(uid).second && "duplicate oracle parent");
+    m_parents.push_back({request, uid, tick, mask, 0});
+    ++parents_enqueued;
+    for (unsigned s = 0; s < 4; ++s) required_sectors += !!(mask & (1U << s));
+    peak_parents = std::max(peak_parents, m_parents.size());
+  }
+  bool ready(uint64_t tick) const {
+    if (tick == m_last_transfer_tick) return false;
+    for (const parent &p : m_parents) if (tick > p.accepted_tick) return true;
+    return false;
+  }
+  sector next(uint64_t tick) {
+    assert(ready(tick));
+    // Rotation both selects an eligible parent and provides bounded RR fairness.
+    while (!(tick > m_parents.front().accepted_tick)) rotate();
+    const parent &p = m_parents.front();
+    unsigned s = 0;
+    while (!(p.required & (1U << s)) || (p.transferred & (1U << s))) ++s;
+    assert(s < 4);
+    return {p.request, s};
+  }
+  void commit(uint64_t tick, const sector &sent) {
+    assert(ready(tick) && !m_parents.empty());
+    parent &p = m_parents.front();
+    assert(p.request == sent.request && sent.index < 4);
+    const uint8_t bit = static_cast<uint8_t>(1U << sent.index);
+    assert((p.required & bit) && !(p.transferred & bit));
+    p.transferred |= bit;
+    ++sectors_enqueued;
+    m_last_transfer_tick = tick;
+    if (p.transferred == p.required) {
+      assert(m_uids.erase(p.uid) == 1);
+      m_parents.pop_front();
+      ++parents_transferred;
+    } else {
+      rotate();
+    }
+  }
+  bool empty() const { return m_parents.empty(); }
+  size_t size() const { return m_parents.size(); }
+  uint64_t parents_enqueued = 0, required_sectors = 0, sectors_enqueued = 0;
+  uint64_t parents_transferred = 0;
+  size_t peak_parents = 0;
+ private:
+  void rotate() { m_parents.push_back(m_parents.front()); m_parents.pop_front(); }
+  unsigned m_capacity;
+  uint64_t m_last_transfer_tick = UINT64_MAX;
+  std::deque<parent> m_parents;
+  std::set<unsigned> m_uids;
+};
+}  // namespace dtc_oracle
+#endif

# CM5 diagnostic only; never enters CM3 FAST12 primary aggregation.
# Exact conventional data capacity: 128 sets * 5 ways * 128 B = 81,920 B
# = 80 KiB = 640 lines.  The 128-set count is power-of-two and source-legal
# for the frozen linear index implementation, as audited in CM0.
-gpgpu_cache:dl1 S:128:128:5,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_cache:dl1PrefL1 S:128:128:5,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_cache:dl1PrefShared S:128:128:5,L:T:m:L:L,A:512:8,16:0,32
# Required by l1d_cache_config's configured-capacity divisibility check.
-gpgpu_unified_l1d_size 80

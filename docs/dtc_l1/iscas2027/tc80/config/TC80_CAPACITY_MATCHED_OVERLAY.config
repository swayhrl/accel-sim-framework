# TC80 canonical overlay.  Invoke after the frozen FAST64_BASE.config.
# CM0 selected 32 sets x 20 ways x 128 B = 640 searchable conventional lines.
# All three L1D preference strings change together because change_cache_config()
# may select any of them at a kernel boundary.
-gpgpu_cache:dl1 S:32:128:20,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_cache:dl1PrefL1 S:32:128:20,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_cache:dl1PrefShared S:32:128:20,L:T:m:L:L,A:512:8,16:0,32
# Required by l1d_cache_config::get_max_cache_multiplier(): 80 KiB divides
# the selected 80-KiB conventional L1 exactly, avoiding a source change.
-gpgpu_unified_l1d_size 80

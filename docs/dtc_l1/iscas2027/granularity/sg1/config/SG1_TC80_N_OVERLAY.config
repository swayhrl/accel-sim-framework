# SG1 TC80-N whole-line conventional control.
# Invoke after frozen configs/dtc_l1/fast64/FAST64_BASE.config.
# The only semantic change from TC80-S is cache type S -> N.  The existing
# exact-80-KiB geometry and required unified-size companion remain unchanged.
-gpgpu_cache:dl1 N:32:128:20,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_cache:dl1PrefL1 N:32:128:20,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_cache:dl1PrefShared N:32:128:20,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_unified_l1d_size 80

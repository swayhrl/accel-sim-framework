+++ b/src/gpgpu-sim/src/gpgpu-sim/intrawarp_translation_reference.cc
@@ -0,0 +1,168 @@
+#include "intrawarp_translation_reference.h"
+
+#include <assert.h>
+#include <stdlib.h>
+#include <map>
+#include <set>
+
+namespace awma_intrawarp {
+namespace {
+struct runtime_request_key {
+  unsigned sid; uint64_t uid;
+  bool operator<(const runtime_request_key &o) const {
+    return sid != o.sid ? sid < o.sid : uid < o.uid;
+  }
+};
+struct runtime_instruction_key {
+  unsigned sid; uint64_t uid;
+  bool operator<(const runtime_instruction_key &o) const {
+    return sid != o.sid ? sid < o.sid : uid < o.uid;
+  }
+};
+struct stable_warp_key {
+  uint64_t cta; unsigned warp;
+  bool operator<(const stable_warp_key &o) const {
+    return cta != o.cta ? cta < o.cta : warp < o.warp;
+  }
+};
+struct identity {
+  unsigned asid; uint64_t vpn, page_size, generation;
+  vm_translation::translation_access access;
+  bool operator<(const identity &o) const {
+    if (asid != o.asid) return asid < o.asid;
+    if (vpn != o.vpn) return vpn < o.vpn;
+    if (page_size != o.page_size) return page_size < o.page_size;
+    if (generation != o.generation) return generation < o.generation;
+    return access < o.access;
+  }
+};
+struct request_meta {
+  uint64_t cta; unsigned warp; uint64_t instruction_ordinal, pc;
+  identity key; bool classic_coverable; uint64_t stable_hash;
+};
+struct cycle_activity {
+  uint64_t cycle, compares, leaders, registrations, ready_reads, consumes;
+  cycle_activity() : cycle(~0ULL), compares(0), leaders(0), registrations(0),
+                     ready_reads(0), consumes(0) {}
+};
+uint64_t mix(uint64_t h, uint64_t v) {
+  for (unsigned i = 0; i < 8; ++i) { h ^= v & 0xff; h *= 1099511628211ULL; v >>= 8; }
+  return h;
+}
+uint64_t hash_request(const request_meta &m, const request_descriptor &r) {
+  uint64_t h = 1469598103934665603ULL;
+  h=mix(h,m.cta); h=mix(h,m.warp); h=mix(h,m.instruction_ordinal); h=mix(h,m.pc);
+  h=mix(h,r.sim_va); h=mix(h,r.bytes); h=mix(h,r.lane_mask);
+  h=mix(h,r.sector_mask); h=mix(h,r.byte_mask_hash); h=mix(h,r.asid);
+  h=mix(h,r.page_size); h=mix(h,r.generation); h=mix(h,r.access); return h;
+}
+bool env_enabled(const char *name) {
+  const char *t=getenv(name); return t && t[0] && strtoul(t,0,10)!=0;
+}
+}  // namespace
+
+struct observer::implementation {
+  std::map<runtime_request_key,request_meta> requests;
+  std::set<runtime_instruction_key> instructions;
+  std::map<stable_warp_key,uint64_t> next_ordinal;
+  std::map<unsigned,cycle_activity> activity;
+  std::map<identity,uint64_t> mappings;
+  uint64_t instruction_count,request_count,classic_groups,classic_coverable;
+  uint64_t stable_xor,stable_sum,prel1_compares,prel1_followers;
+  uint64_t source_same_instruction,source_same_warp_other_instruction;
+  uint64_t source_other_warp_same_cta,source_other_cta,source_unknown;
+  uint64_t exact_intersection,prel1_only,prel1_leaders,follower_wait_polls;
+  uint64_t follower_ready_reads,follower_consumes,ref_groups,ref_group_members;
+  uint64_t ref_followers,ref_leader_attempts,ref_leader_ready;
+  uint64_t ref_follower_deliveries,ref_head_wait_cycles,group_hwm;
+  uint64_t compares_per_sid_cycle_hwm,leaders_per_sid_cycle_hwm;
+  uint64_t registrations_per_sid_cycle_hwm,ready_reads_per_sid_cycle_hwm;
+  uint64_t consumes_per_sid_cycle_hwm;
+  uint64_t mapping_xor,mapping_sum,mapping_conflicts;
+  implementation() : instruction_count(0),request_count(0),classic_groups(0),
+    classic_coverable(0),stable_xor(0),stable_sum(0),prel1_compares(0),
+    prel1_followers(0),source_same_instruction(0),
+    source_same_warp_other_instruction(0),source_other_warp_same_cta(0),
+    source_other_cta(0),source_unknown(0),exact_intersection(0),prel1_only(0),
+    prel1_leaders(0),follower_wait_polls(0),follower_ready_reads(0),
+    follower_consumes(0),ref_groups(0),ref_group_members(0),ref_followers(0),
+    ref_leader_attempts(0),ref_leader_ready(0),ref_follower_deliveries(0),
+    ref_head_wait_cycles(0),group_hwm(0),compares_per_sid_cycle_hwm(0),
+    leaders_per_sid_cycle_hwm(0),registrations_per_sid_cycle_hwm(0),
+    ready_reads_per_sid_cycle_hwm(0),consumes_per_sid_cycle_hwm(0),
+    mapping_xor(0),mapping_sum(0),mapping_conflicts(0) {}
+  cycle_activity &at(unsigned sid,uint64_t cycle) {
+    cycle_activity &r=activity[sid]; if(r.cycle!=cycle){r=cycle_activity();r.cycle=cycle;} return r;
+  }
+};
+
+observer::observer():m_impl(new implementation()){}
+observer &observer::instance(){static observer x;return x;}
+bool observer::enabled()const{return env_enabled("GPGPUSIM_AWMA_INTRAWARP_SOURCE_OBSERVER")||reference_enabled();}
+bool observer::reference_enabled()const{return vm_translation::awma_candidate_mode()==vm_translation::AWMA_TRANSLATION_CANDIDATE_WARP_VPN_DEDUP_REFERENCE;}
+
+void observer::note_instruction(unsigned sid,uint64_t ruid,uint64_t cta,
+ unsigned warp,uint64_t pc,const std::vector<request_descriptor>&d){
+ if(!enabled())return; runtime_instruction_key rk={sid,ruid};
+ if(!m_impl->instructions.insert(rk).second)return; ++m_impl->instruction_count;
+ stable_warp_key wk={cta,warp}; uint64_t ord=m_impl->next_ordinal[wk]++;
+ std::map<identity,uint64_t> leader; std::map<identity,unsigned> size;
+ for(std::vector<request_descriptor>::const_reverse_iterator i=d.rbegin();i!=d.rend();++i){
+  identity k={i->asid,i->sim_va/i->page_size,i->page_size,i->generation,i->access};
+  if(leader.find(k)==leader.end())leader[k]=i->uid; ++size[k];
+ }
+ for(std::map<identity,unsigned>::const_iterator i=size.begin();i!=size.end();++i)
+  if(i->second>1){++m_impl->classic_groups;m_impl->classic_coverable+=i->second-1;
+   if(reference_enabled()){++m_impl->ref_groups;m_impl->ref_group_members+=i->second;
+    m_impl->ref_followers+=i->second-1;}
+   if(i->second>m_impl->group_hwm)m_impl->group_hwm=i->second;}
+ for(std::vector<request_descriptor>::const_iterator i=d.begin();i!=d.end();++i){
+  request_meta m; m.cta=cta;m.warp=warp;m.instruction_ordinal=ord;m.pc=pc;
+  m.key=identity{i->asid,i->sim_va/i->page_size,i->page_size,i->generation,i->access};
+  m.classic_coverable=size[m.key]>1&&leader[m.key]!=i->uid;m.stable_hash=hash_request(m,*i);
+  runtime_request_key q={sid,i->uid};assert(m_impl->requests.insert(std::make_pair(q,m)).second);
+  ++m_impl->request_count;m_impl->stable_xor^=m.stable_hash;m_impl->stable_sum+=m.stable_hash;
+ }
+}
+void observer::note_prel1_compare(unsigned sid,uint64_t c){if(!enabled())return;++m_impl->prel1_compares;cycle_activity&r=m_impl->at(sid,c);if(++r.compares>m_impl->compares_per_sid_cycle_hwm)m_impl->compares_per_sid_cycle_hwm=r.compares;}
+void observer::note_prel1_follower(unsigned ls,uint64_t lu,unsigned fs,uint64_t fu,uint64_t c){
+ if(!enabled())return;++m_impl->prel1_followers;cycle_activity&r=m_impl->at(fs,c);
+ if(++r.registrations>m_impl->registrations_per_sid_cycle_hwm)m_impl->registrations_per_sid_cycle_hwm=r.registrations;
+ std::map<runtime_request_key,request_meta>::const_iterator l=m_impl->requests.find(runtime_request_key{ls,lu});
+ std::map<runtime_request_key,request_meta>::const_iterator f=m_impl->requests.find(runtime_request_key{fs,fu});
+ if(l==m_impl->requests.end()||f==m_impl->requests.end()){++m_impl->source_unknown;++m_impl->prel1_only;return;}
+ if(l->second.cta==f->second.cta&&l->second.warp==f->second.warp&&l->second.instruction_ordinal==f->second.instruction_ordinal)++m_impl->source_same_instruction;
+ else if(l->second.cta==f->second.cta&&l->second.warp==f->second.warp)++m_impl->source_same_warp_other_instruction;
+ else if(l->second.cta==f->second.cta)++m_impl->source_other_warp_same_cta; else ++m_impl->source_other_cta;
+ if(f->second.classic_coverable)++m_impl->exact_intersection;else ++m_impl->prel1_only;
+}
+void observer::note_prel1_leader_launch(unsigned s,uint64_t,uint64_t c){if(!enabled())return;++m_impl->prel1_leaders;cycle_activity&r=m_impl->at(s,c);if(++r.leaders>m_impl->leaders_per_sid_cycle_hwm)m_impl->leaders_per_sid_cycle_hwm=r.leaders;}
+void observer::note_prel1_follower_poll(unsigned s,uint64_t,uint64_t c,bool ready,bool consume){if(!enabled())return;cycle_activity&r=m_impl->at(s,c);if(!ready){++m_impl->follower_wait_polls;return;}++m_impl->follower_ready_reads;if(++r.ready_reads>m_impl->ready_reads_per_sid_cycle_hwm)m_impl->ready_reads_per_sid_cycle_hwm=r.ready_reads;if(consume){++m_impl->follower_consumes;if(++r.consumes>m_impl->consumes_per_sid_cycle_hwm)m_impl->consumes_per_sid_cycle_hwm=r.consumes;}}
+void observer::note_reference_group(unsigned,uint64_t,unsigned n){if(!reference_enabled())return;++m_impl->ref_groups;m_impl->ref_group_members+=n;m_impl->ref_followers+=n-1;if(n>m_impl->group_hwm)m_impl->group_hwm=n;}
+void observer::note_reference_leader_attempt(unsigned,uint64_t){if(reference_enabled())++m_impl->ref_leader_attempts;}
+void observer::note_reference_leader_ready(unsigned,uint64_t){if(reference_enabled())++m_impl->ref_leader_ready;}
+void observer::note_reference_follower_delivery(unsigned,uint64_t,unsigned n){if(reference_enabled())m_impl->ref_follower_deliveries+=n;}
+void observer::note_reference_head_wait(unsigned,uint64_t){if(reference_enabled())++m_impl->ref_head_wait_cycles;}
+void observer::note_functional_mapping(unsigned asid,uint64_t vpn,uint64_t page,uint64_t gen,vm_translation::translation_access access,uint64_t ppn){
+ if(!enabled())return;identity k={asid,vpn,page,gen,access};
+ std::map<identity,uint64_t>::const_iterator found=m_impl->mappings.find(k);
+ if(found!=m_impl->mappings.end()){if(found->second!=ppn)++m_impl->mapping_conflicts;return;}
+ m_impl->mappings[k]=ppn;uint64_t h=1469598103934665603ULL;h=mix(h,asid);h=mix(h,vpn);h=mix(h,page);h=mix(h,gen);h=mix(h,access);h=mix(h,ppn);m_impl->mapping_xor^=h;m_impl->mapping_sum+=h;
+}
+void observer::print(FILE*f)const{if(!enabled())return;
+#define P(n) fprintf(f,"awma_intrawarp_"#n" = %llu\n",(unsigned long long)m_impl->n)
+ fprintf(f,"awma_intrawarp_source_observer_enabled = %u\n",env_enabled("GPGPUSIM_AWMA_INTRAWARP_SOURCE_OBSERVER")?1U:0U);
+ fprintf(f,"awma_intrawarp_reference_enabled = %u\n",reference_enabled()?1U:0U);
+ P(instruction_count);P(request_count);P(classic_groups);P(classic_coverable);P(stable_xor);P(stable_sum);
+ P(prel1_compares);P(prel1_followers);P(source_same_instruction);P(source_same_warp_other_instruction);
+ P(source_other_warp_same_cta);P(source_other_cta);P(source_unknown);P(exact_intersection);P(prel1_only);
+ fprintf(f,"awma_intrawarp_warp_only = %llu\n",(unsigned long long)(m_impl->classic_coverable>=m_impl->exact_intersection?m_impl->classic_coverable-m_impl->exact_intersection:0));
+ P(prel1_leaders);P(follower_wait_polls);P(follower_ready_reads);P(follower_consumes);
+ P(ref_groups);P(ref_group_members);P(ref_followers);P(ref_leader_attempts);P(ref_leader_ready);
+ P(ref_follower_deliveries);P(ref_head_wait_cycles);P(group_hwm);P(compares_per_sid_cycle_hwm);
+ P(leaders_per_sid_cycle_hwm);P(registrations_per_sid_cycle_hwm);P(ready_reads_per_sid_cycle_hwm);P(consumes_per_sid_cycle_hwm);
+ fprintf(f,"awma_intrawarp_mapping_unique = %llu\n",(unsigned long long)m_impl->mappings.size());P(mapping_xor);P(mapping_sum);P(mapping_conflicts);
+ fprintf(f,"awma_intrawarp_terminal_quiescent = 1\n");
+#undef P
+}
+}  // namespace awma_intrawarp

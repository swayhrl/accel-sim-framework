+#ifndef AWMA_INTRAWARP_TRANSLATION_REFERENCE_H
+#define AWMA_INTRAWARP_TRANSLATION_REFERENCE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <vector>
+#include "vm_translation.h"
+
+namespace awma_intrawarp {
+struct request_descriptor {
+  uint64_t uid, sim_va, bytes;
+  unsigned asid;
+  uint64_t page_size, generation;
+  vm_translation::translation_access access;
+  uint64_t lane_mask, sector_mask, byte_mask_hash;
+};
+
+class observer {
+ public:
+  static observer &instance();
+  bool enabled() const;
+  bool reference_enabled() const;
+  void note_instruction(unsigned sid, uint64_t runtime_instruction_uid,
+                        uint64_t stable_cta, unsigned warp_in_cta, uint64_t pc,
+                        const std::vector<request_descriptor> &requests);
+  void note_prel1_compare(unsigned sid, uint64_t cycle);
+  void note_prel1_follower(unsigned leader_sid, uint64_t leader_uid,
+                           unsigned follower_sid, uint64_t follower_uid,
+                           uint64_t cycle);
+  void note_prel1_leader_launch(unsigned sid, uint64_t uid, uint64_t cycle);
+  void note_prel1_follower_poll(unsigned sid, uint64_t uid, uint64_t cycle,
+                                bool ready, bool consume);
+  void note_reference_group(unsigned sid, uint64_t cycle, unsigned members);
+  void note_reference_leader_attempt(unsigned sid, uint64_t cycle);
+  void note_reference_leader_ready(unsigned sid, uint64_t cycle);
+  void note_reference_follower_delivery(unsigned sid, uint64_t cycle,
+                                        unsigned count);
+  void note_reference_head_wait(unsigned sid, uint64_t cycle);
+  void note_functional_mapping(unsigned asid, uint64_t vpn,
+                               uint64_t page_size, uint64_t generation,
+                               vm_translation::translation_access access,
+                               uint64_t ppn);
+  void print(FILE *fout) const;
+ private:
+  observer();
+  observer(const observer &);
+  observer &operator=(const observer &);
+  struct implementation;
+  implementation *m_impl;
+};
+}  // namespace awma_intrawarp
+#endif

+struct awma_s1_probe_result {
+  awma_s1_probe_result()
+      : atomic(false), unsupported(false), ordinary_read(false),
+        ordinary_write(false), ldgsts(false), semantic_candidate(false) {}
+  awma_transient_l2::service_access classification;
+  bool atomic;
+  bool unsupported;
+  bool ordinary_read;
+  bool ordinary_write;
+  bool ldgsts;
+  bool semantic_candidate;
+};
+
+awma_s1_probe_result awma_s1_probe(mem_fetch *mf) {
+  awma_s1_probe_result result;
+  awma_transient_l2_controller &controller = awma_transient_l2_instance();
+  result.classification =
+      controller.classify_service_access(mf->get_sim_va(),
+                                         mf->get_access_size());
+  result.atomic = mf->isatomic();
+  const bool has_instruction = !mf->get_inst().empty();
+  result.ordinary_read =
+      has_instruction && mf->get_access_type() == GLOBAL_ACC_R &&
+      !mf->is_write();
+  result.ordinary_write =
+      has_instruction && mf->get_access_type() == GLOBAL_ACC_W &&
+      mf->is_write() && !mf->get_inst().m_is_ldgsts;
+  result.unsupported =
+      !(result.ordinary_read || result.ordinary_write) ||
+      mf->get_access_size() != SECTOR_SIZE;
+  result.ldgsts =
+      result.ordinary_read && mf->get_inst().m_is_ldgsts;
+  awma_r101r3_s1::request_semantics semantics;
+  semantics.atomic = result.atomic;
+  semantics.ordinary_read = result.ordinary_read;
+  semantics.ordinary_write = result.ordinary_write;
+  semantics.request_bytes = mf->get_access_size();
+  result.semantic_candidate =
+      awma_r101r3_s1::supported(result.classification, semantics);
+  if (result.classification.intersects_transient()) {
+    assert(mf->get_sim_va() == mf->get_sim_pa());
+    assert(mf->get_sim_pa() == mf->get_addr());
+  }
+  return result;
+}

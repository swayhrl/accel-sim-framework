@@ -0,0 +1,75 @@
+#ifndef AWMA_R101R3_S1_SERVICE_H
+#define AWMA_R101R3_S1_SERVICE_H
+
+#include <assert.h>
+
+#include "awma_transient_l2_policy.h"
+
+namespace awma_r101r3_s1 {
+
+static const unsigned kSectorBytes = 32;
+
+struct request_semantics {
+  request_semantics()
+      : atomic(false), ordinary_read(false), ordinary_write(false),
+        request_bytes(0) {}
+  bool atomic;
+  bool ordinary_read;
+  bool ordinary_write;
+  unsigned request_bytes;
+};
+
+inline bool supported(const awma_transient_l2::service_access &classification,
+                      const request_semantics &semantics) {
+  return classification.oracle_eligible() && !semantics.atomic &&
+         (semantics.ordinary_read || semantics.ordinary_write) &&
+         semantics.request_bytes == kSectorBytes;
+}
+
+struct bounded_path_state {
+  bounded_path_state()
+      : dram_queue_full(false), return_queue_full(false),
+        data_port_busy(false) {}
+  bool dram_queue_full;
+  bool return_queue_full;
+  bool data_port_busy;
+  bool can_accept() const {
+    return !dram_queue_full && !return_queue_full && !data_port_busy;
+  }
+};
+
+struct accounting {
+  accounting()
+      : reads(0), writes(0), ldgsts_reads(0), fallbacks(0),
+        duplicates(0), request_bytes(0), active_bytes(0) {}
+
+  unsigned long long reads;
+  unsigned long long writes;
+  unsigned long long ldgsts_reads;
+  unsigned long long fallbacks;
+  unsigned long long duplicates;
+  unsigned long long request_bytes;
+  unsigned long long active_bytes;
+
+  void serve(bool write, bool ldgsts, unsigned request,
+             unsigned active) {
+    assert(request == kSectorBytes && active <= request);
+    if (write) {
+      assert(!ldgsts);
+      ++writes;
+    } else {
+      ++reads;
+      if (ldgsts) ++ldgsts_reads;
+    }
+    request_bytes += request;
+    active_bytes += active;
+  }
+
+  bool exact() const {
+    return ldgsts_reads <= reads && duplicates == 0;
+  }
+};
+
+}  // namespace awma_r101r3_s1
+
+#endif

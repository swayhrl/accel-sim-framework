+void awma_transient_l2_controller::note_s1_head(
+    bool qualified, unsigned ingress_depth, unsigned return_depth,
+    bool dram_queue_full, bool return_queue_full, bool data_port_busy) {
+  if (!s1_partition_hit_selected()) return;
+  if (ingress_depth > m_s1_max_ingress_depth)
+    m_s1_max_ingress_depth = ingress_depth;
+  if (return_depth > m_s1_max_return_depth)
+    m_s1_max_return_depth = return_depth;
+  if (!qualified) return;
+  if (!s1_window_active()) {
+    ++m_s1_inactive_intersections;
+    return;
+  }
+  ++m_s1_head_qualified_cycles;
+  if (!m_r3_diagnostics) return;
+  if (dram_queue_full) ++m_s1_dram_queue_full_cycles;
+  if (return_queue_full) ++m_s1_return_queue_full_cycles;
+  if (data_port_busy) ++m_s1_data_port_busy_cycles;
+}
+
+void awma_transient_l2_controller::note_s1_fallback(
+    awma_transient_l2::service_access_kind kind, bool atomic,
+    bool unsupported_operation, unsigned bytes) {
+  (void)bytes;
+  assert(s1_window_active());
+  ++m_s1_fallback_requests;
+  if (atomic) ++m_s1_atomic_fail_closed;
+  if (unsupported_operation) ++m_s1_unsupported_fail_closed;
+  if (kind == awma_transient_l2::SERVICE_ACCESS_DEAD_TRANSIENT)
+    ++m_s1_dead_fail_closed;
+  else if (kind == awma_transient_l2::SERVICE_ACCESS_PARTIAL_TRANSIENT)
+    ++m_s1_partial_fail_closed;
+  else if (kind == awma_transient_l2::SERVICE_ACCESS_MULTIPLE_REGIONS)
+    ++m_s1_multi_region_fail_closed;
+  else if (kind == awma_transient_l2::SERVICE_ACCESS_INVALID_RANGE)
+    ++m_s1_invalid_range_fail_closed;
+}
+
+void awma_transient_l2_controller::note_s1_served(
+    const awma_transient_l2::line_metadata &metadata, bool write,
+    bool ldgsts, unsigned request_bytes, unsigned active_bytes,
+    unsigned sub_partition) {
+  assert(s1_window_active());
+  assert(m_policy.is_live(metadata));
+  assert(request_bytes > 0 && sub_partition < 64);
+  m_s1_subpartition_mask |= 1ULL << sub_partition;
+  m_s1_served_request_bytes += request_bytes;
+  m_s1_served_active_bytes += active_bytes;
+  if (m_active_kernel_ordinal <= m_context_end_ordinal)
+    ++m_s1_context_served;
+  if (write) {
+    assert(!ldgsts);
+    ++m_s1_served_writes;
+  } else {
+    ++m_s1_served_reads;
+    if (ldgsts)
+      ++m_s1_served_ldgsts_reads;
+    else
+      ++m_s1_served_ldg_reads;
+  }
+}

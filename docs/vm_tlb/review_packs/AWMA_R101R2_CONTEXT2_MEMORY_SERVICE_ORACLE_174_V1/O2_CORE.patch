+  static void hash_u64(uint64_t &hash, uint64_t value) {
+    for (unsigned byte = 0; byte < 8; ++byte) {
+      hash ^= (value >> (byte * 8)) & UINT64_C(0xff);
+      hash *= UINT64_C(1099511628211);
+    }
+  }

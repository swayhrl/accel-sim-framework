+void awma_transient_l2_controller::note_service_inactive_observation(
+    awma_transient_l2::service_access_kind kind, unsigned bytes) {
+  if (!service_oracle_selected()) return;
+  if (kind == awma_transient_l2::SERVICE_ACCESS_NON_TRANSIENT) return;
+  ++m_service_inactive_intersections;
+  m_service_inactive_bytes += bytes;
+}
+
+void awma_transient_l2_controller::note_service_fail_closed(
+    awma_transient_l2::service_access_kind kind, bool atomic,
+    bool unsupported_operation, unsigned bytes) {
+  assert(service_window_active());
+  if (atomic) ++m_service_atomic_fail_closed;
+  if (unsupported_operation) ++m_service_unsupported_fail_closed;
+  if (kind == awma_transient_l2::SERVICE_ACCESS_DEAD_TRANSIENT)
+    ++m_service_dead_skips;
+  else if (kind == awma_transient_l2::SERVICE_ACCESS_PARTIAL_TRANSIENT)
+    ++m_service_partial_skips;
+  else if (kind == awma_transient_l2::SERVICE_ACCESS_MULTIPLE_REGIONS)
+    ++m_service_multi_region_skips;
+  else if (kind == awma_transient_l2::SERVICE_ACCESS_INVALID_RANGE)
+    ++m_service_invalid_range_skips;
+  m_service_fail_closed_bytes += bytes;
+}
+
+void awma_transient_l2_controller::note_service_admission(
+    const awma_transient_l2::line_metadata &metadata, bool write,
+    bool ldgsts,
+    unsigned request_bytes, unsigned active_bytes,
+    unsigned long long cycle) {
+  (void)cycle;
+  assert(service_window_active());
+  assert(m_policy.is_live(metadata));
+  assert(request_bytes > 0);
+  if (write) {
+    assert(!ldgsts);
+    ++m_service_qualified_writes;
+    m_service_qualified_write_bytes += request_bytes;
+    m_service_qualified_write_active_bytes += active_bytes;
+  } else {
+    ++m_service_qualified_reads;
+    if (ldgsts) {
+      ++m_service_qualified_ldgsts_reads;
+      m_service_qualified_ldgsts_bytes += request_bytes;
+    } else {
+      ++m_service_qualified_ldg_reads;
+    }
+    m_service_qualified_read_bytes += request_bytes;
+    m_service_qualified_read_active_bytes += active_bytes;
+  }
+  ++m_service_scheduled;
+  ++m_service_outstanding;
+}
+
+void awma_transient_l2_controller::note_service_ready(
+    const awma_transient_l2::line_metadata &metadata, bool write,
+    unsigned long long admission_cycle, unsigned long long ready_cycle,
+    unsigned long long observed_cycle) {
+  (void)write;
+  assert(m_service_outstanding > 0);
+  if (!m_policy.is_live(metadata)) ++m_service_stale_token_violations;
+  if (ready_cycle != admission_cycle + 1 || observed_cycle != ready_cycle)
+    ++m_service_latency_violations;
+  ++m_service_one_cycle_ready;
+}
+
+void awma_transient_l2_controller::note_service_retired(bool write,
+                                                         bool ldgsts) {
+  assert(m_service_outstanding > 0);
+  --m_service_outstanding;
+  if (write) {
+    assert(!ldgsts);
+    ++m_service_retired_writes;
+  } else {
+    ++m_service_retired_reads;
+    if (ldgsts)
+      ++m_service_retired_ldgsts_reads;
+    else
+      ++m_service_retired_ldg_reads;
+  }
+}
+
+void awma_transient_l2_controller::note_service_queue_depth(
+    unsigned scheduled, unsigned ready) {
+  if (scheduled > m_service_max_scheduled_depth)
+    m_service_max_scheduled_depth = scheduled;
+  if (ready > m_service_max_ready_depth)
+    m_service_max_ready_depth = ready;
+}

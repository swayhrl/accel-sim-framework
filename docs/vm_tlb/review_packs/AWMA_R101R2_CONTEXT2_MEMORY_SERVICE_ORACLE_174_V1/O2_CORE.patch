+#ifndef AWMA_R101R2_O2_SERVICE_H
+#define AWMA_R101R2_O2_SERVICE_H
+
+#include <assert.h>
+#include <stdint.h>
+
+namespace awma_r101r2_o2 {
+
+enum service_state { SERVICE_SCHEDULED = 0, SERVICE_READY, SERVICE_RETIRED };
+
+enum read_dependency_kind {
+  READ_REGISTER_SCOREBOARD = 0,
+  READ_LDGSTS_DEPBAR
+};
+
+static const unsigned kSectorSize = 32;
+
+inline unsigned long long one_cycle_ready(unsigned long long admission_cycle) {
+  assert(admission_cycle != ~0ULL);
+  return admission_cycle + 1;
+}
+
+inline bool is_exact_one_cycle(unsigned long long admission_cycle,
+                               unsigned long long ready_cycle,
+                               unsigned long long observed_cycle) {
+  return ready_cycle == admission_cycle + 1 && observed_cycle == ready_cycle;
+}
+
+inline unsigned store_ack_tokens(bool bypass_l1, bool sector_associative,
+                                 unsigned data_size) {
+  if (bypass_l1 || !sector_associative) return 1;
+  assert(data_size != 0 && data_size % kSectorSize == 0);
+  return data_size / kSectorSize;
+}
+
+inline read_dependency_kind read_dependency(bool is_ldgsts) {
+  return is_ldgsts ? READ_LDGSTS_DEPBAR : READ_REGISTER_SCOREBOARD;
+}
+
+struct accounting {
+  accounting()
+      : admitted(0), ready(0), retired(0), duplicate(0), outstanding(0) {}
+  unsigned long long admitted;
+  unsigned long long ready;
+  unsigned long long retired;
+  unsigned long long duplicate;
+  unsigned long long outstanding;
+  void admit() {
+    ++admitted;
+    ++outstanding;
+  }
+  void make_ready(service_state &state) {
+    if (state != SERVICE_SCHEDULED) {
+      ++duplicate;
+      return;
+    }
+    state = SERVICE_READY;
+    ++ready;
+  }
+  void retire(service_state &state) {
+    if (state != SERVICE_READY || outstanding == 0) {
+      ++duplicate;
+      return;
+    }
+    state = SERVICE_RETIRED;
+    ++retired;
+    --outstanding;
+  }
+  bool quiescent() const {
+    return admitted == ready && ready == retired && duplicate == 0 &&
+           outstanding == 0;
+  }
+};
+
+}  // namespace awma_r101r2_o2
+
+#endif

+bool ldst_unit::awma_o2_try_admit(warp_inst_t &inst, mem_access_t &access,
+                                  bool bypass_l1) {
+  awma_transient_l2_controller &controller = awma_transient_l2_instance();
+  if (!controller.service_oracle_selected()) return false;
+
+  const awma_transient_l2::service_access classification =
+      controller.classify_service_access(access.get_sim_va(),
+                                         access.get_size());
+  if (!controller.service_window_active()) {
+    if (classification.kind !=
+            awma_transient_l2::SERVICE_ACCESS_NON_TRANSIENT &&
+        access.mark_awma_o2_service_observed())
+      controller.note_service_inactive_observation(classification.kind,
+                                                   access.get_size());
+    return false;
+  }
+  if (classification.kind ==
+      awma_transient_l2::SERVICE_ACCESS_NON_TRANSIENT)
+    return false;
+
+  const bool atomic = inst.isatomic();
+  const bool ordinary_read =
+      inst.space.get_type() == global_space && inst.is_load() &&
+      !inst.is_store() && !access.is_write() &&
+      access.get_type() == GLOBAL_ACC_R;
+  const bool ordinary_write =
+      inst.space.get_type() == global_space && inst.is_store() &&
+      !inst.is_load() && access.is_write() &&
+      access.get_type() == GLOBAL_ACC_W && !inst.m_is_ldgsts;
+  const bool unsupported_operation = !(ordinary_read || ordinary_write);
+  const bool ldgsts = ordinary_read && inst.m_is_ldgsts;
+  if (atomic || unsupported_operation || !classification.oracle_eligible()) {
+    if (access.mark_awma_o2_service_observed())
+      controller.note_service_fail_closed(
+          classification.kind, atomic, unsupported_operation,
+          access.get_size());
+    return false;
+  }
+
+  const unsigned long long now =
+      m_core->get_gpu()->gpu_sim_cycle +
+      m_core->get_gpu()->gpu_tot_sim_cycle;
+  vm_cov_note(m_core, access);
+  mem_fetch *mf = m_mf_allocator->alloc(inst, access, now);
+  unsigned ack_tokens = 0;
+  if (ordinary_write) {
+    ack_tokens = awma_r101r2_o2::store_ack_tokens(
+        bypass_l1,
+        m_config->m_L1D_config.get_mshr_type() == SECTOR_ASSOC,
+        mf->get_data_size());
+    for (unsigned i = 0; i < ack_tokens; ++i)
+      m_core->inc_store_req(inst.warp_id());
+  }
+  controller.note_service_admission(
+      classification.metadata, ordinary_write, ldgsts, access.get_size(),
+      access.get_byte_mask().count(), now);
+  m_awma_o2_scheduled.push_back(awma_o2_service_entry(
+      mf, classification.metadata, ordinary_write, ldgsts, ack_tokens, now));
+  controller.note_service_queue_depth(m_awma_o2_scheduled.size(),
+                                      m_awma_o2_ready.size());
+  inst.accessq_pop_back();
+  return true;
+}
+
+void ldst_unit::awma_o2_service_cycle() {
+  if (m_awma_o2_scheduled.empty()) return;
+  const unsigned long long now =
+      m_core->get_gpu()->gpu_sim_cycle +
+      m_core->get_gpu()->gpu_tot_sim_cycle;
+  awma_transient_l2_controller &controller = awma_transient_l2_instance();
+  while (!m_awma_o2_scheduled.empty() &&
+         m_awma_o2_scheduled.front().ready_cycle <= now) {
+    awma_o2_service_entry entry = m_awma_o2_scheduled.front();
+    m_awma_o2_scheduled.pop_front();
+    if (entry.state != awma_r101r2_o2::SERVICE_SCHEDULED) {
+      controller.note_service_duplicate_completion();
+      continue;
+    }
+    entry.state = awma_r101r2_o2::SERVICE_READY;
+    controller.note_service_ready(
+        entry.metadata, entry.write, entry.admission_cycle, entry.ready_cycle,
+        now);
+    entry.mf->set_reply();
+    if (entry.write) {
+      for (unsigned i = 0; i < entry.ack_tokens; ++i)
+        m_core->store_ack(entry.mf);
+      entry.state = awma_r101r2_o2::SERVICE_RETIRED;
+      controller.note_service_retired(true, false);
+      delete entry.mf;
+    } else {
+      m_awma_o2_ready.push_back(entry);
+    }
+  }
+  controller.note_service_queue_depth(m_awma_o2_scheduled.size(),
+                                      m_awma_o2_ready.size());
+}

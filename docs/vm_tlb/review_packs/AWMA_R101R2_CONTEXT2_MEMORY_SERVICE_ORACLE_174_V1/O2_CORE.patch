+  service_access classify_access(uint64_t address, uint64_t size) const {
+    service_access result;
+    if (size == 0 || address > UINT64_MAX - size) {
+      result.kind = SERVICE_ACCESS_INVALID_RANGE;
+      return result;
+    }
+    const uint64_t limit = address + size;
+    for (unsigned i = 0; i < kMaxRegions; ++i) {
+      const descriptor &region = m_regions[i];
+      if (!region.valid || limit <= region.base || region.limit <= address)
+        continue;
+      ++result.intersection_count;
+      if (result.intersection_count == 1) {
+        result.metadata.region_plus_one = static_cast<uint8_t>(i + 1);
+        result.metadata.generation = region.generation;
+        result.fully_contained = region.base <= address && limit <= region.limit;
+      } else {
+        result.fully_contained = false;
+      }
+    }
+    if (result.intersection_count == 0) {
+      result.kind = SERVICE_ACCESS_NON_TRANSIENT;
+    } else if (result.intersection_count > 1) {
+      result.kind = SERVICE_ACCESS_MULTIPLE_REGIONS;
+    } else if (!result.fully_contained) {
+      result.kind = SERVICE_ACCESS_PARTIAL_TRANSIENT;
+    } else {
+      result.kind = is_live(result.metadata) ? SERVICE_ACCESS_LIVE_TRANSIENT
+                                             : SERVICE_ACCESS_DEAD_TRANSIENT;
+    }
+    return result;
+  }
+
+  uint64_t lifecycle_hash() const {
+    uint64_t hash = UINT64_C(1469598103934665603);
+    for (unsigned i = 0; i < kMaxRegions; ++i) {
+      const descriptor &region = m_regions[i];
+      hash_u64(hash, i);
+      hash_u64(hash, region.base);
+      hash_u64(hash, region.limit);
+      hash_u64(hash, region.region_id);
+      hash_u64(hash, region.generation);
+      hash_u64(hash, region.valid ? 1 : 0);
+      hash_u64(hash, region.live ? 1 : 0);
+    }
+    return hash;
+  }
+

+  if (m_c16_baseline_policy ==
+      c16_strong_baselines::POLICY_PRIORITY_ALL)
+    return true;
+  if (m_c16_baseline_policy ==
+      c16_strong_baselines::POLICY_PRIORITY_STABLE)
+    return c16_strong_baselines::stable_selected(local_class, line_index);
+  return false;
+}

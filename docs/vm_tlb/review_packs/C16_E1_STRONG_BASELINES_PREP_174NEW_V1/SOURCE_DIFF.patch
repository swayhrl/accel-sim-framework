diff --git a/src/gpgpu-sim/tests/test_c16_strong_baselines.cc b/src/gpgpu-sim/tests/test_c16_strong_baselines.cc
new file mode 100644
index 0000000..350b0e1
--- /dev/null
+++ b/src/gpgpu-sim/tests/test_c16_strong_baselines.cc
@@ -0,0 +1,129 @@
+#include "../c16_strong_baselines.h"
+
+#include <assert.h>
+#include <stdint.h>
+
+#include <iostream>
+#include <vector>
+
+using namespace c16_strong_baselines;
+
+static candidate row(unsigned index, bool invalid, bool priority,
+                     unsigned rrpv, uint64_t lru) {
+  candidate value = {index, invalid, priority, rrpv, lru, lru};
+  return value;
+}
+
+static void test_priority() {
+  std::vector<candidate> rows;
+  rows.push_back(row(0, false, true, 0, 1));
+  rows.push_back(row(1, false, false, 0, 10));
+  rows.push_back(row(2, false, false, 0, 5));
+  victim_result ordinary = choose_priority_victim(rows, true);
+  assert(ordinary.found && ordinary.index == 2 &&
+         ordinary.kind == VICTIM_ORDINARY);
+  rows[1].priority = rows[2].priority = true;
+  victim_result fallback = choose_priority_victim(rows, true);
+  assert(fallback.found && fallback.index == 0 &&
+         fallback.kind == VICTIM_PRIORITY);
+  rows.push_back(row(3, true, false, 0, 0));
+  rows.push_back(row(4, true, false, 0, 0));
+  victim_result invalid = choose_priority_victim(rows, true);
+  assert(invalid.found && invalid.index == 4 &&
+         invalid.kind == VICTIM_INVALID);
+  diagnostics state;
+  assert(state.priority_resident == 0 && state.priority_pending == 0);
+}
+
+static void test_stable_selector() {
+  assert(std::string(stable_hash_version()) ==
+         "C16_M1F_STABLE_ADMISSION_HASH_V1");
+  assert(stable_hash_seed() == 0x6a09e667f3bcc908ULL);
+  assert(stable_hash_threshold() == 0x0484baf3b723b966ULL);
+  assert(stable_hash(1, 1186) == 0xd92231f51d5c2efbULL);
+  assert(stable_hash(15, 2) == 0xc69c317586b04f9eULL);
+  assert(stable_hash(28, 1193) == 0xfcf49fc4e0bf282dULL);
+  bool saw_selected = false, saw_filtered = false;
+  for (uint64_t line = 0; line < 4096; ++line) {
+    const bool first = stable_selected(7, line);
+    assert(first == stable_selected(7, line));
+    assert(first == (stable_hash(7, line) < stable_hash_threshold()));
+    saw_selected |= first;
+    saw_filtered |= !first;
+  }
+  assert(saw_selected && saw_filtered);
+}
+
+static void test_drrip() {
+  unsigned srrip = 0, brrip = 0;
+  for (unsigned set = 0; set < 2048; ++set) {
+    leader_role role = drrip_leader_role(set, 2048);
+    srrip += role == SRRIP_LEADER_SET;
+    brrip += role == BRRIP_LEADER_SET;
+  }
+  assert(srrip == 32 && brrip == 32);
+  for (unsigned slot = 0; slot < 64; ++slot)
+    assert(drrip_leader_role(slot * 32, 2048) ==
+           ((slot & 1) ? BRRIP_LEADER_SET : SRRIP_LEADER_SET));
+
+  unsigned psel = 512;
+  drrip_train_psel(SRRIP_LEADER_SET, &psel);
+  assert(psel == 513);
+  drrip_train_psel(BRRIP_LEADER_SET, &psel);
+  assert(psel == 512);
+  for (unsigned i = 0; i < 2000; ++i)
+    drrip_train_psel(SRRIP_LEADER_SET, &psel);
+  assert(psel == 1023);
+  for (unsigned i = 0; i < 2000; ++i)
+    drrip_train_psel(BRRIP_LEADER_SET, &psel);
+  assert(psel == 0);
+
+  uint64_t counter = 0;
+  bool used_brrip = false;
+  for (unsigned i = 0; i < 64; ++i) {
+    const unsigned rrpv = drrip_insertion_rrpv(
+        BRRIP_LEADER_SET, 0, &counter, &used_brrip);
+    assert(used_brrip);
+    assert(rrpv == ((i % 32 == 0) ? 2U : 3U));
+  }
+  assert(counter == 64);
+  assert(drrip_insertion_rrpv(SRRIP_LEADER_SET, 1023, &counter,
+                              &used_brrip) == 2);
+  assert(!used_brrip && counter == 64);
+
+  std::vector<candidate> rows;
+  rows.push_back(row(0, false, false, 1, 0));
+  rows.push_back(row(1, false, false, 2, 0));
+  rows.push_back(row(2, false, false, 2, 0));
+  victim_result aged = choose_drrip_victim(&rows);
+  assert(aged.found && aged.index == 1 && aged.aging_rounds == 1);
+  assert(rows[0].rrpv == 2 && rows[1].rrpv == 3 && rows[2].rrpv == 3);
+  rows.push_back(row(7, true, false, 0, 0));
+  rows.push_back(row(8, true, false, 0, 0));
+  victim_result invalid = choose_drrip_victim(&rows);
+  assert(invalid.index == 8 && invalid.kind == VICTIM_INVALID);
+}
+
+static void test_gpu_event_contract() {
+  assert(event_promotes(EVENT_TRUE_VALID_SECTOR_HIT));
+  assert(!event_promotes(EVENT_SAME_TAG_SECTOR_MISS));
+  assert(!event_promotes(EVENT_HIT_RESERVED_MSHR_MERGE));
+  assert(!event_promotes(EVENT_RESERVATION_FAIL_RETRY));
+  assert(!event_promotes(EVENT_FILL));
+  assert(!event_promotes(EVENT_WRITEBACK_HIT));
+  assert(event_inserts(EVENT_NEW_LINE_ALLOCATION));
+  assert(!event_inserts(EVENT_SAME_TAG_SECTOR_MISS));
+  assert(!event_inserts(EVENT_HIT_RESERVED_MSHR_MERGE));
+  assert(!event_inserts(EVENT_RESERVATION_FAIL_RETRY));
+}
+
+int main() {
+  assert(policy_value_valid(POLICY_SHIP_SW));
+  assert(!ship_sw_contract_complete());
+  test_priority();
+  test_stable_selector();
+  test_drrip();
+  test_gpu_event_contract();
+  std::cout << "C16_STRONG_BASELINES_POLICY_TEST_PASS\n";
+  return 0;
+}
diff --git a/src/gpgpu-sim/tests/test_c16_strong_baselines_tag_array.cc b/src/gpgpu-sim/tests/test_c16_strong_baselines_tag_array.cc
new file mode 100644
index 0000000..ad1672e
--- /dev/null
+++ b/src/gpgpu-sim/tests/test_c16_strong_baselines_tag_array.cc
@@ -0,0 +1,131 @@
+#include "../gpu-cache.h"
+
+#include <assert.h>
+
+#include <fstream>
+#include <iostream>
+#include <string>
+
+class exposed_c16_tag_array : public tag_array {
+ public:
+  explicit exposed_c16_tag_array(cache_config &config)
+      : tag_array(config, 0, 0) {}
+
+  void install(unsigned index, new_addr_type address, unsigned rrpv,
+               bool priority) {
+    mem_access_sector_mask_t sector;
+    sector.set(0);
+    mem_access_byte_mask_t bytes;
+    cache_block_t *block = get_block(index);
+    block->allocate(address, address, 1, sector);
+    block->fill(2, sector, bytes);
+    m_c16_rrpv[index] = rrpv;
+    if (priority) {
+      m_c16_priority_state[index] = 2;
+      ++m_c16_diagnostics.priority_resident;
+      m_c16_diagnostics.priority_peak_resident =
+          m_c16_diagnostics.priority_resident;
+      m_c16_diagnostics.priority_peak_resident_plus_pending =
+          m_c16_diagnostics.priority_resident;
+    }
+    c16_baseline_verify();
+  }
+
+  cache_request_status probe_sector(new_addr_type address, unsigned sector,
+                                    unsigned *index, bool probe_mode) const {
+    mem_access_sector_mask_t mask;
+    mask.set(sector);
+    return c16_baseline_probe(address, *index, mask, false, probe_mode, NULL);
+  }
+
+  unsigned rrpv(unsigned index) const { return m_c16_rrpv[index]; }
+  uint64_t resident() const { return m_c16_diagnostics.priority_resident; }
+};
+
+static std::string write_sidecar(const char *path) {
+  std::ofstream out(path, std::ios::binary);
+  out << "ORACLE_ELASTIC_QWEIGHT_RESIDENCY_V1\t1\tMODELED_L2_GET_ADDR\n";
+  const uint64_t region_bytes = 265216ULL * 128;
+  const uint64_t stride = region_bytes + 128;
+  for (unsigned target_class = 1; target_class <= 28; ++target_class) {
+    const uint64_t begin = 0x100000000ULL + (target_class - 1) * stride;
+    out << "0x" << std::hex << begin << "\t0x" << begin + region_bytes
+        << std::dec << "\tlayer" << target_class - 1 << "\t"
+        << target_class << "\n";
+  }
+  out.close();
+  return oracle_elastic_residency::oracle_config::sha256_file(path);
+}
+
+static cache_config make_config(unsigned policy, const char *sidecar,
+                                const char *digest) {
+  static char config_string[] = "S:64:128:4,L:B:m:L:L,A:8:8,8:8,32";
+  cache_config config;
+  config.m_config_string = config_string;
+  config.init(config_string, FuncCachePreferNone);
+  config.m_oracle_elastic_enable = false;
+  config.m_oracle_elastic_sidecar = const_cast<char *>(sidecar);
+  config.m_oracle_elastic_sidecar_sha256 = const_cast<char *>(digest);
+  config.init_oracle_elastic(1);
+  config.m_c16_baseline_enable = true;
+  config.m_c16_baseline_policy = policy;
+  config.m_c16_baseline_diagnostics = true;
+  config.init_c16_strong_baseline(1);
+  return config;
+}
+
+int main() {
+  const char *sidecar = "/tmp/c16_strong_baseline_sidecar.tsv";
+  const std::string digest = write_sidecar(sidecar);
+
+  cache_config priority = make_config(
+      c16_strong_baselines::POLICY_PRIORITY_STABLE, sidecar, digest.c_str());
+  assert(priority.c16_baseline_enabled());
+  assert(std::string(priority.c16_baseline_policy_name()) ==
+         "PRIORITY_STABLE");
+  exposed_c16_tag_array priority_tags(priority);
+  priority_tags.install(0, 0x1000, 3, true);
+  assert(priority_tags.resident() == 1);
+  mem_access_sector_mask_t sector0;
+  sector0.set(0);
+  priority_tags.oracle_invalidate_line(0, sector0);
+  assert(priority_tags.resident() == 0);
+
+  cache_config drrip = make_config(c16_strong_baselines::POLICY_DRRIP,
+                                   sidecar, digest.c_str());
+  exposed_c16_tag_array tags(drrip);
+  tags.install(0, 0x0000, 1, false);
+  tags.install(1, 0x0080, 2, false);
+  tags.install(2, 0x0100, 2, false);
+  tags.install(3, 0x0180, 2, false);
+  unsigned victim = 0;
+  assert(tags.probe_sector(0x2000, 0, &victim, true) == MISS);
+  assert(tags.rrpv(0) == 1 && tags.rrpv(1) == 2);
+  assert(tags.probe_sector(0x2000, 0, &victim, false) == MISS);
+  assert(victim == 1);
+  assert(tags.rrpv(0) == 2 && tags.rrpv(1) == 3);
+
+  // Same tag / different invalid sector is a sector miss and does not run
+  // the new-line victim path or alter line-granular RRPV.
+  unsigned index = 0;
+  const unsigned before = tags.rrpv(0);
+  assert(tags.probe_sector(0x0000, 1, &index, false) == SECTOR_MISS);
+  assert(index == 0 && tags.rrpv(0) == before);
+
+  FILE *stats = tmpfile();
+  assert(stats != NULL);
+  unsigned accesses = 0, misses = 0;
+  tags.print(stats, accesses, misses);
+  rewind(stats);
+  std::string text;
+  char buffer[4096];
+  while (fgets(buffer, sizeof(buffer), stats)) text += buffer;
+  fclose(stats);
+  assert(text.find("c16_strong_baseline_l2") != std::string::npos);
+  assert(text.find("policy=DRRIP") != std::string::npos);
+  assert(text.find("drrip_psel=512") != std::string::npos);
+
+  remove(sidecar);
+  std::cout << "C16_STRONG_BASELINES_TAG_ARRAY_TEST_PASS\n";
+  return 0;
+}

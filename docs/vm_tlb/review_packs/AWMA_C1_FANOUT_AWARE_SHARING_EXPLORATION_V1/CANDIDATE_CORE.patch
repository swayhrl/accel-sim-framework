+unsigned awma_share_min_cohort_size() {
+  const char *text = getenv("GPGPUSIM_AWMA_SHARE_MIN_COHORT_SIZE");
+  if (text == 0 || text[0] == '\0') return 2;
+  char *end = 0;
+  const unsigned long parsed = strtoul(text, &end, 10);
+  assert(end != text && *end == '\0');
+  assert((parsed == 2 || parsed == 4) &&
+         "fanout-aware discovery permits only accepted size 2 or fixed size 4");
+  return static_cast<unsigned>(parsed);
+}

+#ifndef GPGPU_SIM_AWMA_BOTTLENECK_OBSERVATORY_H
+#define GPGPU_SIM_AWMA_BOTTLENECK_OBSERVATORY_H
+
+#include <stdint.h>
+#include <stdio.h>
+
+#include <string>

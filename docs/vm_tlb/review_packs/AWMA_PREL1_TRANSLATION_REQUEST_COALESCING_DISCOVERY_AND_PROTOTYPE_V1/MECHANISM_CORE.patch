+#ifndef AWMA_PREL1_EXACT_COALESCER_H
+#define AWMA_PREL1_EXACT_COALESCER_H
+
+#include <stdint.h>
+#include <stdio.h>
+
+#include "vm_translation.h"
+
+namespace awma_prel1 {
+
+enum follower_poll_result {
+  FOLLOWER_NOT_REGISTERED = 0,
+  FOLLOWER_WAITING,
+  FOLLOWER_READY
+};
+
+enum request_decision {
+  REQUEST_COMPARE_DELAY = 0,
+  REQUEST_REGISTERED_FOLLOWER,
+  REQUEST_CONTROL_GROUPED_PASSTHROUGH,
+  REQUEST_BASELINE_LEADER,
+  REQUEST_ENTRY_FULL_PASSTHROUGH,
+  REQUEST_WAITER_FULL_PASSTHROUGH
+};
+
+class exact_coalescer {
+ public:
+  static exact_coalescer &instance();
+
+  bool enabled() const;
+  bool grouping_only_control() const;
+  unsigned compare_latency() const;
+  unsigned capacity_per_sid() const { return 2; }
+  unsigned waiter_capacity_per_entry() const { return 32; }
+
+  follower_poll_result poll_follower(
+      unsigned sid, uint64_t uid, unsigned asid, uint64_t vpn,
+      uint64_t page_size, uint64_t generation,
+      vm_translation::translation_access access, uint64_t sim_va,
+      uint64_t cycle, bool consume_ready, uint64_t *sim_pa,
+      vm_translation::translation_source *source);
+
+  request_decision decide_new_request(
+      unsigned sid, uint64_t uid, unsigned asid, uint64_t vpn,
+      uint64_t page_size, uint64_t generation,
+      vm_translation::translation_access access, uint64_t cycle);
+
+  void note_leader_launch(
+      unsigned sid, uint64_t uid, unsigned asid, uint64_t vpn,
+      uint64_t page_size, uint64_t generation,
+      vm_translation::translation_access access, uint64_t cycle);
+
+  void note_leader_completion(
+      unsigned sid, uint64_t uid, uint64_t ppn,
+      vm_translation::translation_source source, uint64_t cycle);
+
+  bool quiescent() const;
+  void print(FILE *fout) const;
+
+ private:
+  exact_coalescer();
+  exact_coalescer(const exact_coalescer &);
+  exact_coalescer &operator=(const exact_coalescer &);
+
+  struct implementation;
+  implementation *m_impl;
+};
+
+}  // namespace awma_prel1
+
+#endif
diff --git "a/D:\\repo\\awma_prel1_stage\\prel1_exact_coalescer.cc" "b/D:\\repo\\awma_prel1_stage\\prel1_exact_coalescer.cc"
new file mode 100644
index 0000000..7b88657
--- /dev/null
+++ "b/D:\\repo\\awma_prel1_stage\\prel1_exact_coalescer.cc"
@@ -0,0 +1,475 @@
+#include "prel1_exact_coalescer.h"
+
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <map>
+#include <vector>
+
+namespace awma_prel1 {
+namespace {
+
+struct identity {
+  unsigned asid;
+  uint64_t vpn;
+  uint64_t page_size;
+  uint64_t generation;
+  vm_translation::translation_access access;
+};
+
+bool same_identity(const identity &left, const identity &right) {
+  return left.asid == right.asid && left.vpn == right.vpn &&
+         left.page_size == right.page_size &&
+         left.generation == right.generation && left.access == right.access;
+}
+
+struct requester_key {
+  unsigned sid;
+  uint64_t uid;
+  bool operator<(const requester_key &other) const {
+    if (sid != other.sid) return sid < other.sid;
+    return uid < other.uid;
+  }
+};
+
+struct follower {
+  requester_key requester;
+  identity key;
+  uint64_t registration_cycle;
+  uint64_t last_wait_cycle;
+  bool exposed_at_head;
+  bool control_only;
+  follower(const requester_key &r = requester_key(),
+           const identity &i = identity(), uint64_t cycle = 0,
+           bool control = false)
+      : requester(r), key(i), registration_cycle(cycle),
+        last_wait_cycle(~0ULL), exposed_at_head(false),
+        control_only(control) {}
+};
+
+enum entry_state { ENTRY_FREE = 0, ENTRY_LIVE, ENTRY_READY };
+
+struct entry {
+  entry_state state;
+  identity key;
+  requester_key leader;
+  uint64_t leader_launch_cycle;
+  uint64_t leader_completion_cycle;
+  uint64_t ppn;
+  vm_translation::translation_source source;
+  std::vector<follower> waiters;
+  entry()
+      : state(ENTRY_FREE), key(), leader(), leader_launch_cycle(0),
+        leader_completion_cycle(0), ppn(0),
+        source(vm_translation::TRANSLATION_SOURCE_UNOBSERVED), waiters() {}
+};
+
+struct locator {
+  unsigned sid;
+  unsigned entry_index;
+  locator(unsigned s = 0, unsigned e = 0) : sid(s), entry_index(e) {}
+};
+
+struct pending_compare {
+  identity key;
+  uint64_t ready_cycle;
+  pending_compare(const identity &i = identity(), uint64_t ready = 0)
+      : key(i), ready_cycle(ready) {}
+};
+
+struct stats {
+  uint64_t lookups;
+  uint64_t compare_delays;
+  uint64_t leaders;
+  uint64_t followers;
+  uint64_t same_cycle_merges;
+  uint64_t inflight_merges;
+  uint64_t entry_full_fallbacks;
+  uint64_t waiter_full_fallbacks;
+  uint64_t grouping_only_followers;
+  uint64_t leader_completions;
+  uint64_t follower_applications;
+  uint64_t follower_wait_cycles_total;
+  uint64_t follower_wait_cycles_max;
+  uint64_t follower_delivery_latency_total;
+  uint64_t follower_delivery_latency_max;
+  uint64_t leader_to_follower_latency_total;
+  uint64_t leader_to_follower_latency_max;
+  uint64_t head_block_cycles;
+  uint64_t critical_path_followers;
+  uint64_t l1_hit_leaders;
+  uint64_t l2_hit_leaders;
+  uint64_t ptw_leaders;
+  uint64_t other_source_leaders;
+  uint64_t occupancy_hwm;
+  uint64_t waiter_hwm;
+  std::map<uint64_t, uint64_t> delivery_wait_histogram;
+  stats()
+      : lookups(0), compare_delays(0), leaders(0), followers(0),
+        same_cycle_merges(0), inflight_merges(0), entry_full_fallbacks(0),
+        waiter_full_fallbacks(0), grouping_only_followers(0),
+        leader_completions(0), follower_applications(0),
+        follower_wait_cycles_total(0), follower_wait_cycles_max(0),
+        follower_delivery_latency_total(0), follower_delivery_latency_max(0),
+        leader_to_follower_latency_total(0),
+        leader_to_follower_latency_max(0), head_block_cycles(0),
+        critical_path_followers(0), l1_hit_leaders(0), l2_hit_leaders(0),
+        ptw_leaders(0), other_source_leaders(0), occupancy_hwm(0),
+        waiter_hwm(0), delivery_wait_histogram() {}
+};
+
+uint64_t percentile(const std::map<uint64_t, uint64_t> &histogram,
+                    uint64_t count, unsigned numerator,
+                    unsigned denominator) {
+  if (count == 0) return 0;
+  const uint64_t rank = (count * numerator + denominator - 1) / denominator;
+  uint64_t cumulative = 0;
+  for (std::map<uint64_t, uint64_t>::const_iterator it = histogram.begin();
+       it != histogram.end(); ++it) {
+    cumulative += it->second;
+    if (cumulative >= rank) return it->first;
+  }
+  assert(false);
+  return 0;
+}
+
+}  // namespace
+
+struct exact_coalescer::implementation {
+  std::map<unsigned, std::vector<entry> > tables;
+  std::map<requester_key, locator> followers;
+  std::map<requester_key, pending_compare> pending_compares;
+  stats counters;
+
+  std::vector<entry> &table(unsigned sid) {
+    std::vector<entry> &result = tables[sid];
+    if (result.empty()) result.resize(2);
+    return result;
+  }
+
+  void note_occupancy(unsigned sid) {
+    std::vector<entry> &entries = table(sid);
+    unsigned occupancy = 0;
+    for (unsigned i = 0; i < entries.size(); ++i)
+      if (entries[i].state != ENTRY_FREE) ++occupancy;
+    if (occupancy > counters.occupancy_hwm)
+      counters.occupancy_hwm = occupancy;
+  }
+
+  void free_if_drained(unsigned sid, unsigned entry_index) {
+    std::vector<entry> &entries = table(sid);
+    assert(entry_index < entries.size());
+    entry &resident = entries[entry_index];
+    if (resident.state == ENTRY_READY && resident.waiters.empty())
+      resident = entry();
+  }
+};
+
+exact_coalescer::exact_coalescer() : m_impl(new implementation()) {}
+
+exact_coalescer &exact_coalescer::instance() {
+  static exact_coalescer singleton;
+  return singleton;
+}
+
+bool exact_coalescer::enabled() const {
+  return vm_translation::awma_candidate_mode() ==
+         vm_translation::AWMA_TRANSLATION_CANDIDATE_PREL1_EXACT_COALESCER;
+}
+
+bool exact_coalescer::grouping_only_control() const {
+  const char *value = getenv("GPGPUSIM_AWMA_PREL1_CONTROL");
+  if (value == NULL || value[0] == '\0' || strcmp(value, "none") == 0)
+    return false;
+  assert(strcmp(value, "grouping_only") == 0);
+  return true;
+}
+
+unsigned exact_coalescer::compare_latency() const {
+  const char *value = getenv("GPGPUSIM_AWMA_PREL1_COMPARE_LATENCY");
+  const unsigned latency =
+      value == NULL || value[0] == '\0' ? 0 : unsigned(strtoul(value, NULL, 10));
+  assert(latency <= 1);
+  return latency;
+}
+
+follower_poll_result exact_coalescer::poll_follower(
+    unsigned sid, uint64_t uid, unsigned asid, uint64_t vpn,
+    uint64_t page_size, uint64_t generation,
+    vm_translation::translation_access access, uint64_t sim_va,
+    uint64_t cycle, bool consume_ready, uint64_t *sim_pa,
+    vm_translation::translation_source *source) {
+  if (!enabled() || grouping_only_control()) return FOLLOWER_NOT_REGISTERED;
+  const requester_key requester = {sid, uid};
+  std::map<requester_key, locator>::iterator found =
+      m_impl->followers.find(requester);
+  if (found == m_impl->followers.end()) return FOLLOWER_NOT_REGISTERED;
+  std::vector<entry> &entries = m_impl->table(found->second.sid);
+  assert(found->second.entry_index < entries.size());
+  entry &resident = entries[found->second.entry_index];
+  assert(resident.state != ENTRY_FREE);
+  const identity requested = {asid, vpn, page_size, generation, access};
+  assert(same_identity(resident.key, requested));
+  int waiter_index = -1;
+  for (unsigned i = 0; i < resident.waiters.size(); ++i)
+    if (resident.waiters[i].requester.sid == sid &&
+        resident.waiters[i].requester.uid == uid) {
+      waiter_index = static_cast<int>(i);
+      break;
+    }
+  assert(waiter_index >= 0);
+  follower &waiter = resident.waiters[static_cast<unsigned>(waiter_index)];
+  if (resident.state == ENTRY_LIVE) {
+    if (waiter.last_wait_cycle != cycle) {
+      waiter.last_wait_cycle = cycle;
+      ++m_impl->counters.follower_wait_cycles_total;
+      const uint64_t elapsed = cycle - waiter.registration_cycle + 1;
+      if (elapsed > m_impl->counters.follower_wait_cycles_max)
+        m_impl->counters.follower_wait_cycles_max = elapsed;
+    }
+    if (consume_ready) {
+      ++m_impl->counters.head_block_cycles;
+      if (!waiter.exposed_at_head) {
+        waiter.exposed_at_head = true;
+        ++m_impl->counters.critical_path_followers;
+      }
+    }
+    return FOLLOWER_WAITING;
+  }
+  assert(resident.state == ENTRY_READY && sim_pa != NULL && source != NULL);
+  *sim_pa = resident.ppn * page_size + vm_core::page_offset(sim_va, page_size);
+  *source = resident.source;
+  if (!consume_ready) return FOLLOWER_READY;
+
+  const uint64_t delivery = cycle - waiter.registration_cycle;
+  const uint64_t leader_to_follower =
+      cycle - resident.leader_completion_cycle;
+  m_impl->counters.follower_delivery_latency_total += delivery;
+  if (delivery > m_impl->counters.follower_delivery_latency_max)
+    m_impl->counters.follower_delivery_latency_max = delivery;
+  m_impl->counters.leader_to_follower_latency_total += leader_to_follower;
+  if (leader_to_follower > m_impl->counters.leader_to_follower_latency_max)
+    m_impl->counters.leader_to_follower_latency_max = leader_to_follower;
+  ++m_impl->counters.delivery_wait_histogram[delivery];
+  ++m_impl->counters.follower_applications;
+  const unsigned entry_index = found->second.entry_index;
+  resident.waiters.erase(resident.waiters.begin() + waiter_index);
+  m_impl->followers.erase(found);
+  m_impl->free_if_drained(sid, entry_index);
+  return FOLLOWER_READY;
+}
+
+request_decision exact_coalescer::decide_new_request(
+    unsigned sid, uint64_t uid, unsigned asid, uint64_t vpn,
+    uint64_t page_size, uint64_t generation,
+    vm_translation::translation_access access, uint64_t cycle) {
+  assert(enabled());
+  ++m_impl->counters.lookups;
+  const requester_key requester = {sid, uid};
+  const identity requested = {asid, vpn, page_size, generation, access};
+  assert(m_impl->followers.find(requester) == m_impl->followers.end());
+  const unsigned latency = compare_latency();
+  std::map<requester_key, pending_compare>::iterator pending =
+      m_impl->pending_compares.find(requester);
+  if (latency != 0) {
+    if (pending == m_impl->pending_compares.end()) {
+      m_impl->pending_compares.insert(std::make_pair(
+          requester, pending_compare(requested, cycle + latency)));
+      ++m_impl->counters.compare_delays;
+      return REQUEST_COMPARE_DELAY;
+    }
+    assert(same_identity(pending->second.key, requested));
+    if (cycle < pending->second.ready_cycle) return REQUEST_COMPARE_DELAY;
+    m_impl->pending_compares.erase(pending);
+  } else {
+    assert(pending == m_impl->pending_compares.end());
+  }
+
+  std::vector<entry> &entries = m_impl->table(sid);
+  int match = -1;
+  int free_entry = -1;
+  for (unsigned i = 0; i < entries.size(); ++i) {
+    if (entries[i].state == ENTRY_FREE) {
+      if (free_entry < 0) free_entry = static_cast<int>(i);
+      continue;
+    }
+    if (entries[i].state == ENTRY_LIVE &&
+        same_identity(entries[i].key, requested)) {
+      match = static_cast<int>(i);
+      break;
+    }
+  }
+  if (match >= 0) {
+    entry &resident = entries[static_cast<unsigned>(match)];
+    if (resident.waiters.size() >= waiter_capacity_per_entry()) {
+      ++m_impl->counters.waiter_full_fallbacks;
+      return REQUEST_WAITER_FULL_PASSTHROUGH;
+    }
+    const bool control = grouping_only_control();
+    resident.waiters.push_back(follower(requester, requested, cycle, control));
+    if (resident.waiters.size() > m_impl->counters.waiter_hwm)
+      m_impl->counters.waiter_hwm = resident.waiters.size();
+    if (resident.leader_launch_cycle == cycle)
+      ++m_impl->counters.same_cycle_merges;
+    else
+      ++m_impl->counters.inflight_merges;
+    if (control) {
+      ++m_impl->counters.grouping_only_followers;
+      return REQUEST_CONTROL_GROUPED_PASSTHROUGH;
+    }
+    m_impl->followers[requester] = locator(sid, static_cast<unsigned>(match));
+    ++m_impl->counters.followers;
+    return REQUEST_REGISTERED_FOLLOWER;
+  }
+  if (free_entry < 0) {
+    ++m_impl->counters.entry_full_fallbacks;
+    return REQUEST_ENTRY_FULL_PASSTHROUGH;
+  }
+  return REQUEST_BASELINE_LEADER;
+}
+
+void exact_coalescer::note_leader_launch(
+    unsigned sid, uint64_t uid, unsigned asid, uint64_t vpn,
+    uint64_t page_size, uint64_t generation,
+    vm_translation::translation_access access, uint64_t cycle) {
+  if (!enabled()) return;
+  std::vector<entry> &entries = m_impl->table(sid);
+  int free_entry = -1;
+  for (unsigned i = 0; i < entries.size(); ++i)
+    if (entries[i].state == ENTRY_FREE) {
+      free_entry = static_cast<int>(i);
+      break;
+    }
+  // decide_new_request() and this call are synchronous around the accepted
+  // port grant, so the selected invalid entry cannot change between them.
+  assert(free_entry >= 0);
+  entry &resident = entries[static_cast<unsigned>(free_entry)];
+  resident.state = ENTRY_LIVE;
+  resident.key = identity{asid, vpn, page_size, generation, access};
+  resident.leader = requester_key{sid, uid};
+  resident.leader_launch_cycle = cycle;
+  ++m_impl->counters.leaders;
+  m_impl->note_occupancy(sid);
+}
+
+void exact_coalescer::note_leader_completion(
+    unsigned sid, uint64_t uid, uint64_t ppn,
+    vm_translation::translation_source source, uint64_t cycle) {
+  if (!enabled()) return;
+  std::vector<entry> &entries = m_impl->table(sid);
+  int found = -1;
+  for (unsigned i = 0; i < entries.size(); ++i)
+    if (entries[i].state == ENTRY_LIVE && entries[i].leader.sid == sid &&
+        entries[i].leader.uid == uid) {
+      found = static_cast<int>(i);
+      break;
+    }
+  if (found < 0) return;  // entry-full/waiter-full baseline passthrough.
+  entry &resident = entries[static_cast<unsigned>(found)];
+  assert(source != vm_translation::TRANSLATION_SOURCE_UNOBSERVED);
+  resident.state = ENTRY_READY;
+  resident.leader_completion_cycle = cycle;
+  resident.ppn = ppn;
+  resident.source = source;
+  ++m_impl->counters.leader_completions;
+  if (source == vm_translation::TRANSLATION_SOURCE_L1_TLB_HIT)
+    ++m_impl->counters.l1_hit_leaders;
+  else if (source == vm_translation::TRANSLATION_SOURCE_L2_TLB_HIT)
+    ++m_impl->counters.l2_hit_leaders;
+  else if (source == vm_translation::TRANSLATION_SOURCE_PTW)
+    ++m_impl->counters.ptw_leaders;
+  else
+    ++m_impl->counters.other_source_leaders;
+
+  if (grouping_only_control()) {
+    resident.waiters.clear();
+    resident = entry();
+    return;
+  }
+  m_impl->free_if_drained(sid, static_cast<unsigned>(found));
+}
+
+bool exact_coalescer::quiescent() const {
+  if (!m_impl->followers.empty() || !m_impl->pending_compares.empty())
+    return false;
+  for (std::map<unsigned, std::vector<entry> >::const_iterator table =
+           m_impl->tables.begin(); table != m_impl->tables.end(); ++table)
+    for (unsigned i = 0; i < table->second.size(); ++i)
+      if (table->second[i].state != ENTRY_FREE) return false;
+  return true;
+}
+
+void exact_coalescer::print(FILE *fout) const {
+  if (!enabled()) return;
+  const stats &s = m_impl->counters;
+  fprintf(fout, "awma_prel1_coalescer_enabled = 1\n");
+  fprintf(fout, "awma_prel1_coalescer_capacity_per_sid = 2\n");
+  fprintf(fout, "awma_prel1_coalescer_waiters_per_entry = 32\n");
+  fprintf(fout, "awma_prel1_coalescer_compare_latency = %u\n",
+          compare_latency());
+  fprintf(fout, "awma_prel1_coalescer_timing_assumption = %s\n",
+          compare_latency() == 0
+              ? "SIMULATOR_TIMING_ASSUMPTION_SAME_CYCLE_COMPARE"
+              : "CONSERVATIVE_PLUS_ONE_CYCLE_COMPARE");
+  fprintf(fout, "awma_prel1_coalescer_grouping_only = %u\n",
+          grouping_only_control() ? 1U : 0U);
+#define PRINT_COUNTER(name) \
+  fprintf(fout, "awma_prel1_coalescer_" #name " = %llu\n", \
+          (unsigned long long)s.name)
+  PRINT_COUNTER(lookups);
+  PRINT_COUNTER(compare_delays);
+  PRINT_COUNTER(leaders);
+  PRINT_COUNTER(followers);
+  PRINT_COUNTER(same_cycle_merges);
+  PRINT_COUNTER(inflight_merges);
+  PRINT_COUNTER(entry_full_fallbacks);
+  PRINT_COUNTER(waiter_full_fallbacks);
+  PRINT_COUNTER(grouping_only_followers);
+  PRINT_COUNTER(leader_completions);
+  PRINT_COUNTER(follower_applications);
+  PRINT_COUNTER(follower_wait_cycles_total);
+  PRINT_COUNTER(follower_wait_cycles_max);
+  PRINT_COUNTER(follower_delivery_latency_total);
+  PRINT_COUNTER(follower_delivery_latency_max);
+  PRINT_COUNTER(leader_to_follower_latency_total);
+  PRINT_COUNTER(leader_to_follower_latency_max);
+  PRINT_COUNTER(head_block_cycles);
+  PRINT_COUNTER(critical_path_followers);
+  PRINT_COUNTER(l1_hit_leaders);
+  PRINT_COUNTER(l2_hit_leaders);
+  PRINT_COUNTER(ptw_leaders);
+  PRINT_COUNTER(other_source_leaders);
+  PRINT_COUNTER(occupancy_hwm);
+  PRINT_COUNTER(waiter_hwm);
+#undef PRINT_COUNTER
+  fprintf(fout, "awma_prel1_coalescer_delivery_wait_p50 = %llu\n",
+          (unsigned long long)percentile(s.delivery_wait_histogram,
+              s.follower_applications, 50, 100));
+  fprintf(fout, "awma_prel1_coalescer_delivery_wait_p95 = %llu\n",
+          (unsigned long long)percentile(s.delivery_wait_histogram,
+              s.follower_applications, 95, 100));
+  fprintf(fout, "awma_prel1_coalescer_delivery_wait_p99 = %llu\n",
+          (unsigned long long)percentile(s.delivery_wait_histogram,
+              s.follower_applications, 99, 100));
+  fprintf(fout, "awma_prel1_coalescer_followers_final = %llu\n",
+          (unsigned long long)m_impl->followers.size());
+  fprintf(fout, "awma_prel1_coalescer_pending_compares_final = %llu\n",
+          (unsigned long long)m_impl->pending_compares.size());
+  uint64_t live_entries = 0;
+  uint64_t waiters_final = 0;
+  for (std::map<unsigned, std::vector<entry> >::const_iterator table =
+           m_impl->tables.begin(); table != m_impl->tables.end(); ++table)
+    for (unsigned i = 0; i < table->second.size(); ++i) {
+      if (table->second[i].state != ENTRY_FREE) ++live_entries;
+      waiters_final += table->second[i].waiters.size();
+    }
+  fprintf(fout, "awma_prel1_coalescer_live_entries_final = %llu\n",
+          (unsigned long long)live_entries);
+  fprintf(fout, "awma_prel1_coalescer_waiters_final = %llu\n",
+          (unsigned long long)waiters_final);
+  fprintf(fout, "awma_prel1_coalescer_quiescent = %u\n",
+          quiescent() ? 1U : 0U);
+}

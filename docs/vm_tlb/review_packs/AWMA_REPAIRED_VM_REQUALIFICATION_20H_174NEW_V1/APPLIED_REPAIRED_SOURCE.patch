 namespace vm_translation {
+namespace {
+struct target_lookup_override { unsigned l1, l2; bool telemetry; uint64_t race[4]; std::map<uint64_t,bool> launch; };
+std::map<const translation_controller *, target_lookup_override>
+    g_target_lookup_overrides;
+unsigned effective_l1_latency(const translation_controller *controller,
+                              unsigned natural) {
+  std::map<const translation_controller *, target_lookup_override>::const_iterator it =
+      g_target_lookup_overrides.find(controller);
+  return it == g_target_lookup_overrides.end() ? natural : it->second.l1;
+}
+unsigned effective_l2_latency(const translation_controller *controller,
+                              unsigned natural) {
+  std::map<const translation_controller *, target_lookup_override>::const_iterator it =
+      g_target_lookup_overrides.find(controller);
+  return it == g_target_lookup_overrides.end() ? natural : it->second.l2;
+}
+}  // namespace
+
+void enable_target_lookup_latency_override(translation_controller *controller,
+                                           unsigned l1_latency,
+                                           unsigned l2_latency) {
+  assert(controller != NULL);
+  std::map<const translation_controller *, target_lookup_override>::iterator it =
+      g_target_lookup_overrides.find(controller);
+  if (it != g_target_lookup_overrides.end()) {
+    assert(it->second.l1 == l1_latency && it->second.l2 == l2_latency);
+    return;
+  }
+  assert(controller->quiescent_invariants_hold());
+  g_target_lookup_overrides[controller] = target_lookup_override{l1_latency, l2_latency, false, {0,0,0,0}, std::map<uint64_t,bool>()};
+}
+
+void enable_target_fill_race_telemetry(translation_controller *controller) {
+  assert(controller != NULL);
+  std::map<const translation_controller *, target_lookup_override>::iterator it =
+      g_target_lookup_overrides.find(controller);
+  if (it == g_target_lookup_overrides.end()) {
+    const translation_config &config = controller->config();
+    g_target_lookup_overrides[controller] = target_lookup_override{
+        config.l1_lookup_latency, config.l2_lookup_latency, true, {0,0,0,0},
+        std::map<uint64_t,bool>()};
+  } else {
+    it->second.telemetry = true;
+  }
+}
 

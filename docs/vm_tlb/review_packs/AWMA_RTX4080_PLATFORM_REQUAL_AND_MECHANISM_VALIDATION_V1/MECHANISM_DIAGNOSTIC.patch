+class awma_accessq_cardinality_recorder {
+ public:
+  awma_accessq_cardinality_recorder()
+      : m_enabled(parse_enable()), m_next_event_id(0) {}
+
+  void record(const warp_inst_t &inst, unsigned sid,
+              const kernel_info_t *kernel) {
+    if (!m_enabled || !inst.is_load() || !inst.space.is_global() ||
+        inst.active_count() == 0)
+      return;
+    fprintf(stdout,
+            "awma_accessq_cardinality_event event_id=%llu kernel_uid=%u "
+            "sid=%u warp=%u dynamic_warp=%u pc=0x%llx active_lanes=%u "
+            "accessq_entries=%u\n",
+            static_cast<unsigned long long>(m_next_event_id++),
+            kernel == NULL ? 0U : kernel->get_uid(), sid, inst.warp_id(),
+            inst.dynamic_warp_id(),
+            static_cast<unsigned long long>(inst.pc), inst.active_count(),
+            inst.accessq_count());
+  }
+
+ private:
+  static bool parse_enable() {
+    const char *value =
+        getenv("GPGPUSIM_AWMA_ACCESSQ_CARDINALITY_DIAGNOSTICS");
+    return value != NULL && strtoul(value, NULL, 10) != 0;
+  }
+
+  const bool m_enabled;
+  unsigned long long m_next_event_id;
+};
+
+static awma_accessq_cardinality_recorder &accessq_cardinality_diagnostics() {
+  static awma_accessq_cardinality_recorder recorder;
+  return recorder;
+}

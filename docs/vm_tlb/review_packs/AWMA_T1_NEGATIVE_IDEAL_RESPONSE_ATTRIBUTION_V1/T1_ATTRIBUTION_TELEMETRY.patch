+
+static void t1_increment_cycle(std::vector<uint64_t> *series, uint64_t cycle,
+                               uint64_t amount = 1) {
+  if (series->size() <= cycle) series->resize(cycle + 1, 0);
+  (*series)[cycle] += amount;
+}
+
+void m4c_memory_telemetry::record_t1_ready_release(uint64_t cycle) {
+  if (!m_t1_attribution_enabled) return;
+  t1_increment_cycle(&m_t1_ready_by_cycle, cycle);
+}
+
+void m4c_memory_telemetry::record_t1_downstream_admission(
+    uint64_t cycle, uint64_t ready_cycle) {
+  if (!m_t1_attribution_enabled) return;
+  t1_increment_cycle(&m_t1_admissions_by_cycle, cycle);
+  if (ready_cycle == ~uint64_t(0)) {
+    ++m_t1_release_delay_missing;
+    return;
+  }
+  assert(cycle >= ready_cycle);
+  const uint64_t delay = cycle - ready_cycle;
+  if (m_t1_release_delay_histogram.size() <= delay)
+    m_t1_release_delay_histogram.resize(delay + 1, 0);
+  ++m_t1_release_delay_histogram[delay];
+  ++m_t1_release_delay_count;
+  m_t1_release_delay_total += delay;
+}
+
+void m4c_memory_telemetry::record_t1_accessq_sample(uint64_t entries,
+                                                     uint64_t ready_entries) {
+  if (!m_t1_attribution_enabled) return;
+  assert(ready_entries <= entries);
+  ++m_t1_accessq_samples;
+  m_t1_accessq_entries_total += entries;
+  m_t1_accessq_ready_total += ready_entries;
+  if (entries > m_t1_accessq_entries_max) m_t1_accessq_entries_max = entries;
+  if (ready_entries > m_t1_accessq_ready_max)
+    m_t1_accessq_ready_max = ready_entries;
+}
+
+void m4c_memory_telemetry::record_t1_instruction_completion(
+    uint64_t cycle, unsigned active_lanes) {
+  if (!m_t1_attribution_enabled) return;
+  t1_increment_cycle(&m_t1_instructions_by_cycle, cycle, active_lanes);
+}
+
+void m4c_memory_telemetry::record_t1_cta_completion(uint64_t cycle) {
+  if (!m_t1_attribution_enabled) return;
+  t1_increment_cycle(&m_t1_ctas_by_cycle, cycle);
+}
+
+void m4c_memory_telemetry::record_t1_dram_completion(uint64_t cycle,
+                                                      unsigned memory_class) {
+  if (!m_t1_attribution_enabled || memory_class > M4C_DATA_KV_CACHE) return;
+  if (m_t1_first_dram_completion == ~uint64_t(0))
+    m_t1_first_dram_completion = cycle;
+  m_t1_last_dram_completion = cycle;
+  ++m_t1_dram_completions;
 }
 

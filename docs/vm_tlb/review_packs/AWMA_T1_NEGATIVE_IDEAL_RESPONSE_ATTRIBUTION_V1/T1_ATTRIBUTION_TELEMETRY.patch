+static uint64_t t1_hist_percentile(const std::vector<uint64_t> &hist,
+                                   uint64_t count, unsigned percentile) {
+  if (count == 0) return 0;
+  const uint64_t rank = (count * percentile + 99) / 100;
+  uint64_t cumulative = 0;
+  for (uint64_t value = 0; value < hist.size(); ++value) {
+    cumulative += hist[value];
+    if (cumulative >= rank) return value;
+  }
+  assert(0);
+  return 0;
+}
+
+static void t1_print_cycle_summary(FILE *fout, const char *metric,
+                                   const std::vector<uint64_t> &series) {
+  uint64_t total = 0, active = 0, peak = 0;
+  std::vector<uint64_t> hist;
+  for (uint64_t cycle = 0; cycle < series.size(); ++cycle) {
+    const uint64_t value = series[cycle];
+    total += value;
+    if (value != 0) ++active;
+    if (value > peak) peak = value;
+    if (hist.size() <= value) hist.resize(value + 1, 0);
+    ++hist[value];
+  }
+  fprintf(fout,
+          "awma_t1_cycle_summary\t%s\t%llu\t%llu\t%llu\t%llu\t%llu\n",
+          metric, (unsigned long long)series.size(), (unsigned long long)total,
+          (unsigned long long)active,
+          (unsigned long long)t1_hist_percentile(hist, series.size(), 95),
+          (unsigned long long)peak);
+  const unsigned widths[] = {32, 64, 128};
+  for (unsigned w = 0; w != 3; ++w) {
+    const unsigned width = widths[w];
+    std::vector<uint64_t> window_hist;
+    const uint64_t windows = (series.size() + width - 1) / width;
+    uint64_t nonzero = 0, window_peak = 0;
+    for (uint64_t start = 0; start < series.size(); start += width) {
+      uint64_t value = 0;
+      const uint64_t end = start + width < series.size()
+                               ? start + width
+                               : series.size();
+      for (uint64_t cycle = start; cycle < end; ++cycle) value += series[cycle];
+      if (value != 0) ++nonzero;
+      if (value > window_peak) window_peak = value;
+      if (window_hist.size() <= value) window_hist.resize(value + 1, 0);
+      ++window_hist[value];
+    }
+    fprintf(fout,
+            "awma_t1_window_summary\t%s\t%u\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\n",
+            metric, width, (unsigned long long)windows,
+            (unsigned long long)nonzero,
+            (unsigned long long)t1_hist_percentile(window_hist, windows, 50),
+            (unsigned long long)t1_hist_percentile(window_hist, windows, 95),
+            (unsigned long long)t1_hist_percentile(window_hist, windows, 99),
+            (unsigned long long)window_peak);
+  }
+}
+
+static uint64_t t1_progress_cycle(const std::vector<uint64_t> &series,
+                                  uint64_t total, unsigned percentile) {
+  if (total == 0) return 0;
+  const uint64_t target = (total * percentile + 99) / 100;
+  uint64_t cumulative = 0;
+  for (uint64_t cycle = 0; cycle < series.size(); ++cycle) {
+    cumulative += series[cycle];
+    if (cumulative >= target) return cycle;
+  }
+  assert(0);
+  return 0;
+}
+
+void m4c_memory_telemetry::print_t1_attribution(FILE *fout) const {
+  if (!m_t1_attribution_enabled) return;
+  fprintf(fout, "awma_t1_attribution_schema = AWMA_T1_ATTRIBUTION_V1\n");
+  fprintf(fout,
+          "awma_t1_release_delay\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\n",
+          (unsigned long long)m_t1_release_delay_count,
+          (unsigned long long)m_t1_release_delay_total,
+          (unsigned long long)m_t1_release_delay_missing,
+          (unsigned long long)t1_hist_percentile(
+              m_t1_release_delay_histogram, m_t1_release_delay_count, 50),
+          (unsigned long long)t1_hist_percentile(
+              m_t1_release_delay_histogram, m_t1_release_delay_count, 95),
+          (unsigned long long)t1_hist_percentile(
+              m_t1_release_delay_histogram, m_t1_release_delay_count, 99),
+          (unsigned long long)(m_t1_release_delay_histogram.empty()
+                                   ? 0
+                                   : m_t1_release_delay_histogram.size() - 1));
+  fprintf(fout,
+          "awma_t1_accessq_summary\t%llu\t%llu\t%llu\t%llu\t%llu\n",
+          (unsigned long long)m_t1_accessq_samples,
+          (unsigned long long)m_t1_accessq_entries_total,
+          (unsigned long long)m_t1_accessq_ready_total,
+          (unsigned long long)m_t1_accessq_entries_max,
+          (unsigned long long)m_t1_accessq_ready_max);
+  t1_print_cycle_summary(fout, "READY_RELEASES", m_t1_ready_by_cycle);
+  t1_print_cycle_summary(fout, "DOWNSTREAM_ADMISSIONS",
+                         m_t1_admissions_by_cycle);
+  uint64_t instruction_total = 0, cta_total = 0;
+  for (uint64_t cycle = 0; cycle < m_t1_instructions_by_cycle.size(); ++cycle)
+    instruction_total += m_t1_instructions_by_cycle[cycle];
+  for (uint64_t cycle = 0; cycle < m_t1_ctas_by_cycle.size(); ++cycle)
+    cta_total += m_t1_ctas_by_cycle[cycle];
+  fprintf(fout,
+          "awma_t1_progress_summary\tINSTRUCTIONS\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\n",
+          (unsigned long long)instruction_total,
+          (unsigned long long)t1_progress_cycle(m_t1_instructions_by_cycle,
+                                                instruction_total, 25),
+          (unsigned long long)t1_progress_cycle(m_t1_instructions_by_cycle,
+                                                instruction_total, 50),
+          (unsigned long long)t1_progress_cycle(m_t1_instructions_by_cycle,
+                                                instruction_total, 75),
+          (unsigned long long)t1_progress_cycle(m_t1_instructions_by_cycle,
+                                                instruction_total, 90),
+          (unsigned long long)t1_progress_cycle(m_t1_instructions_by_cycle,
+                                                instruction_total, 99));
+  fprintf(fout,
+          "awma_t1_progress_summary\tCTAS\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\n",
+          (unsigned long long)cta_total,
+          (unsigned long long)t1_progress_cycle(m_t1_ctas_by_cycle, cta_total,
+                                                25),
+          (unsigned long long)t1_progress_cycle(m_t1_ctas_by_cycle, cta_total,
+                                                50),
+          (unsigned long long)t1_progress_cycle(m_t1_ctas_by_cycle, cta_total,
+                                                75),
+          (unsigned long long)t1_progress_cycle(m_t1_ctas_by_cycle, cta_total,
+                                                90),
+          (unsigned long long)t1_progress_cycle(m_t1_ctas_by_cycle, cta_total,
+                                                99));
+  fprintf(fout, "awma_t1_dram_completion_summary\t%llu\t%llu\t%llu\n",
+          (unsigned long long)m_t1_dram_completions,
+          (unsigned long long)(m_t1_dram_completions == 0
+                                   ? 0
+                                   : m_t1_first_dram_completion),
+          (unsigned long long)m_t1_last_dram_completion);
+}

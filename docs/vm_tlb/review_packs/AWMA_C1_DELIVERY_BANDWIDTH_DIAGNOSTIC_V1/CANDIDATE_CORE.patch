+unsigned awma_share_delivery_slots() {
+  const char *text = getenv("GPGPUSIM_AWMA_SHARE_DELIVERY_SLOTS");
+  if (text == 0 || text[0] == '\0') return 1;
+  char *end = 0;
+  const unsigned long parsed = strtoul(text, &end, 10);
+  assert(end != text && *end == '\0');
+  assert((parsed == 1 || parsed == 2) &&
+         "Phase 2 permits only finite one-slot or two-slot delivery");
+  return static_cast<unsigned>(parsed);
+}

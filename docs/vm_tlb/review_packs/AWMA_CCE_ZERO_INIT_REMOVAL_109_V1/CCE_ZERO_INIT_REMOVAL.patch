     tl.atomic_xchg(lock_ptr, 0)
 
 
+@triton.jit
+def tl_lock_first_store_or_add(ptrs, v, mask, lock_ptr):
+    state = tl.atomic_cas(lock_ptr, 0, 2)
+    if state == 0:
+        tl.store(ptrs, v, mask=mask, eviction_policy="evict_last")
+        tl.debug_barrier()
+        tl.atomic_xchg(lock_ptr, 1)
+    else:
+        while tl.atomic_cas(lock_ptr, 1, 2) != 1:
+            pass
+
+        cur_v = tl.load(ptrs, mask=mask, other=0.0, eviction_policy="evict_last")
+        new_v = v + cur_v
+        tl.store(ptrs, new_v, mask=mask, eviction_policy="evict_last")
+
+        tl.debug_barrier()
+        tl.atomic_xchg(lock_ptr, 1)
+
+
 def b_bin_fn(b: int) -> int:
     if b >= 1024:
         return 1024

+static unsigned long long awma_parse_u64(const std::string &text) {
+  char *end = NULL;
+  unsigned long long value = strtoull(text.c_str(), &end, 0);
+  assert(end != text.c_str() && *end == '\0');
+  return value;
+}
+
+void awma_transient_l2_controller::configure_from_environment() {
+  const char *mode_text = getenv("AWMA_TRANSIENT_L2_MODE");
+  const char *diagnostics_text = getenv("AWMA_TRANSIENT_L2_DIAGNOSTICS");
+  const char *sidecar = getenv("AWMA_TRANSIENT_L2_SIDECAR");
+  awma_transient_l2::mode selected = awma_transient_l2::MODE_NONE;
+  if (mode_text != NULL) {
+    m_explicit_mode = true;
+    if (!strcmp(mode_text, "none")) {
+      selected = awma_transient_l2::MODE_NONE;
+    } else if (!strcmp(mode_text, "oracle_dead_drop")) {
+      selected = awma_transient_l2::MODE_ORACLE_DEAD_DROP;
+    } else if (!strcmp(mode_text, "bounded_live_retention")) {
+      selected = awma_transient_l2::MODE_BOUNDED_LIVE_RETENTION;
+    } else {
+      fprintf(stderr, "Unknown AWMA_TRANSIENT_L2_MODE=%s\n", mode_text);
+      abort();
+    }
+  }
+  if (diagnostics_text != NULL) {
+    assert(!strcmp(diagnostics_text, "0") || !strcmp(diagnostics_text, "1"));
+    m_diagnostics = !strcmp(diagnostics_text, "1");
+  }
+  m_policy.reset(selected);
+  if (sidecar != NULL && sidecar[0] != '\0') read_sidecar(sidecar);
+  if (selected != awma_transient_l2::MODE_NONE) {
+    assert(sidecar != NULL && sidecar[0] != '\0');
+    assert(m_expected_kernels > 0);
+  }
+  m_configured = true;
+}
+
+void awma_transient_l2_controller::read_sidecar(const char *path) {
+  std::ifstream input(path);
+  assert(input.good());
+  std::string line;
+  bool header = false;
+  unsigned region_count = 0;
+  while (std::getline(input, line)) {
+    if (line.empty() || line[0] == '#') continue;
+    std::istringstream fields(line);
+    std::string kind;
+    fields >> kind;
+    if (!header) {
+      assert(kind == "AWMA_TRANSIENT_L2_RUNTIME_V1");
+      header = true;
+      continue;
+    }
+    if (kind == "LINE_SIZE") {
+      fields >> m_line_size;
+      assert(m_line_size > 0);
+    } else if (kind == "EXPECTED_KERNELS") {
+      fields >> m_expected_kernels;
+      assert(m_expected_kernels > 0);
+    } else if (kind == "REGION") {
+      unsigned region_id, generation, live;
+      std::string base, limit;
+      fields >> region_id >> base >> limit >> generation >> live;
+      assert(fields && live <= 1);
+      m_policy.configure_region(region_id, awma_parse_u64(base),
+                                awma_parse_u64(limit), generation, live != 0);
+      ++region_count;
+    } else if (kind == "BOUNDARY") {
+      boundary_transition transition;
+      unsigned live;
+      fields >> transition.ordinal >> transition.region_id >>
+          transition.generation >> live;
+      assert(fields && transition.ordinal > 0 &&
+             transition.ordinal <= m_expected_kernels && live <= 1);
+      transition.live = live != 0;
+      m_transitions.push_back(transition);
+    } else {
+      fprintf(stderr, "Unknown transient L2 sidecar record: %s\n",
+              kind.c_str());
+      abort();
+    }
+    std::string trailing;
+    assert(!(fields >> trailing));
+  }
+  assert(header && region_count > 0 && region_count <= 4);
+  std::sort(m_transitions.begin(), m_transitions.end(),
+            [](const boundary_transition &left,
+               const boundary_transition &right) {
+              if (left.ordinal != right.ordinal)
+                return left.ordinal < right.ordinal;
+              return left.region_id < right.region_id;
+            });
+}
+
+void awma_transient_l2_controller::register_l2(tag_array *tags,
+                                                unsigned line_size) {
+  assert(m_configured && tags != NULL && line_size > 0);
+  if (m_line_size == 0)
+    m_line_size = line_size;
+  else
+    assert(m_line_size == line_size);
+  assert(std::find(m_l2_arrays.begin(), m_l2_arrays.end(), tags) ==
+         m_l2_arrays.end());
+  m_l2_arrays.push_back(tags);
+}
+
+void awma_transient_l2_controller::unregister_l2(tag_array *tags) {
+  std::vector<tag_array *>::iterator found =
+      std::find(m_l2_arrays.begin(), m_l2_arrays.end(), tags);
+  if (found != m_l2_arrays.end()) m_l2_arrays.erase(found);
+}
+
+awma_transient_l2::line_metadata
+awma_transient_l2_controller::classify_line(new_addr_type block_addr) const {
+  if (!active() || m_line_size == 0)
+    return awma_transient_l2::line_metadata();
+  return m_policy.classify_line(block_addr, m_line_size);
+}
+
+void awma_transient_l2_controller::note_access(
+    const awma_transient_l2::line_metadata &metadata, bool admission) {
+  if (!m_diagnostics || !metadata.transient()) return;
+  ++m_transient_accesses;
+  if (admission) ++m_transient_admissions;
+}
+
+void awma_transient_l2_controller::note_victim(
+    unsigned baseline_index, unsigned selected_index,
+    const awma_transient_l2::line_metadata &baseline_metadata,
+    awma_transient_l2::victim_class selected_class) {
+  if (!m_diagnostics) return;
+  if (baseline_index != selected_index && m_policy.is_live(baseline_metadata))
+    ++m_protected_deflections;
+  if (selected_class == awma_transient_l2::VICTIM_LIVE_TRANSIENT) {
+    ++m_forced_live_evictions;
+    ++m_fallback_count;
+  } else if (selected_class == awma_transient_l2::VICTIM_DEAD_TRANSIENT) {
+    ++m_dead_victim_selections;
+  } else if (selected_class == awma_transient_l2::VICTIM_ORDINARY) {
+    ++m_ordinary_victim_selections;
+  }
+}
+
+void awma_transient_l2_controller::note_l2_writeback(
+    const evicted_block_info &evicted, bool dropped) {
+  if (!m_diagnostics) return;
+  if (dropped) {
+    ++m_dead_eviction_drops;
+    m_dead_eviction_drop_bytes += evicted.m_modified_size;
+    return;
+  }
+  ++m_l2_writebacks;
+  m_l2_writeback_bytes += evicted.m_modified_size;
+  if (evicted.m_awma_transient.transient()) {
+    ++m_transient_writebacks;
+    m_transient_writeback_bytes += evicted.m_modified_size;
+  }
+}
+
+void awma_transient_l2_controller::apply_boundary(unsigned ordinal) {
+  while (m_applied_transitions < m_transitions.size() &&
+         m_transitions[m_applied_transitions].ordinal == ordinal) {
+    const boundary_transition &transition =
+        m_transitions[m_applied_transitions];
+    const awma_transient_l2::descriptor old =
+        m_policy.get_region(transition.region_id);
+    const bool old_generation_dies =
+        old.live && (transition.generation != old.generation ||
+                     !transition.live);
+    if (old_generation_dies &&
+        m_policy.selected_mode() == awma_transient_l2::MODE_ORACLE_DEAD_DROP) {
+      for (unsigned i = 0; i < m_l2_arrays.size(); ++i) {
+        awma_transient_drop_result dropped =
+            m_l2_arrays[i]->awma_oracle_drop(transition.region_id,
+                                             old.generation);
+        m_oracle_drop_lines += dropped.lines;
+        m_oracle_drop_dirty_lines += dropped.dirty_lines;
+        m_oracle_drop_bytes += dropped.dirty_bytes;
+        m_oracle_reserved_skips += dropped.reserved_lines;
+      }
+    }
+    m_policy.transition(transition.region_id, transition.generation,
+                        transition.live);
+    ++m_applied_transitions;
+  }
+}
+
+void awma_transient_l2_controller::kernel_completed(
+    unsigned uid, const char *name, unsigned long long cycle) {
+  if (!active()) return;
+  (void)uid;
+  (void)name;
+  (void)cycle;
+  ++m_completed_kernels;
+  assert(m_expected_kernels == 0 ||
+         m_completed_kernels <= m_expected_kernels);
+  apply_boundary(m_completed_kernels);
+}
+
+const char *awma_transient_l2_controller::mode_name() const {
+  switch (m_policy.selected_mode()) {
+    case awma_transient_l2::MODE_NONE:
+      return "none";
+    case awma_transient_l2::MODE_ORACLE_DEAD_DROP:
+      return "oracle_dead_drop";
+    case awma_transient_l2::MODE_BOUNDED_LIVE_RETENTION:
+      return "bounded_live_retention";
+  }
+  abort();
+}
+
+bool awma_transient_l2_controller::terminal_quiescent() const {
+  if (!active() || m_expected_kernels == 0) return true;
+  return m_completed_kernels == m_expected_kernels &&
+         m_applied_transitions == m_transitions.size();
+}

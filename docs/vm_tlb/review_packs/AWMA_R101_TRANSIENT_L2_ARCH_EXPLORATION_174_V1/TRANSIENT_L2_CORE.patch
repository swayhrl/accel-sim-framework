@@ -0,0 +1,151 @@
+#ifndef AWMA_TRANSIENT_L2_POLICY_H
+#define AWMA_TRANSIENT_L2_POLICY_H
+
+#include <assert.h>
+#include <stdint.h>
+
+namespace awma_transient_l2 {
+
+static const unsigned kMaxRegions = 4;
+static const unsigned kLogicalMetadataBitsPerLine = 11;
+
+enum mode {
+  MODE_NONE = 0,
+  MODE_ORACLE_DEAD_DROP,
+  MODE_BOUNDED_LIVE_RETENTION
+};
+
+enum victim_class {
+  VICTIM_INVALID = 0,
+  VICTIM_DEAD_TRANSIENT,
+  VICTIM_ORDINARY,
+  VICTIM_LIVE_TRANSIENT,
+  VICTIM_INELIGIBLE
+};
+
+struct line_metadata {
+  line_metadata() : region_plus_one(0), generation(0) {}
+  uint8_t region_plus_one;
+  uint8_t generation;
+  bool transient() const { return region_plus_one != 0; }
+  unsigned region_id() const {
+    assert(transient());
+    return region_plus_one - 1;
+  }
+};
+
+struct descriptor {
+  descriptor()
+      : base(0), limit(0), region_id(0), generation(0), valid(false),
+        live(false) {}
+  uint64_t base;
+  uint64_t limit;
+  uint8_t region_id;
+  uint8_t generation;
+  bool valid;
+  bool live;
+};
+
+class region_policy {
+ public:
+  region_policy() { reset(MODE_NONE); }
+
+  void reset(mode selected_mode) {
+    m_mode = selected_mode;
+    for (unsigned i = 0; i < kMaxRegions; ++i) m_regions[i] = descriptor();
+  }
+
+  mode selected_mode() const { return m_mode; }
+  bool replacement_enabled() const {
+    return m_mode == MODE_BOUNDED_LIVE_RETENTION;
+  }
+
+  void configure_region(unsigned region_id, uint64_t base, uint64_t limit,
+                        unsigned generation, bool live) {
+    assert(region_id < kMaxRegions);
+    assert(base < limit);
+    assert(generation > 0 && generation <= UINT8_MAX);
+    for (unsigned i = 0; i < kMaxRegions; ++i) {
+      if (i == region_id || !m_regions[i].valid) continue;
+      assert(limit <= m_regions[i].base || m_regions[i].limit <= base);
+    }
+    descriptor &region = m_regions[region_id];
+    region.base = base;
+    region.limit = limit;
+    region.region_id = static_cast<uint8_t>(region_id);
+    region.generation = static_cast<uint8_t>(generation);
+    region.valid = true;
+    region.live = live;
+  }
+
+  void transition(unsigned region_id, unsigned generation, bool live) {
+    assert(region_id < kMaxRegions);
+    descriptor &region = m_regions[region_id];
+    assert(region.valid);
+    assert(generation > 0 && generation <= UINT8_MAX);
+    assert(generation >= region.generation && "generation wrap/reversal");
+    region.generation = static_cast<uint8_t>(generation);
+    region.live = live;
+  }
+
+  const descriptor &get_region(unsigned region_id) const {
+    assert(region_id < kMaxRegions && m_regions[region_id].valid);
+    return m_regions[region_id];
+  }
+
+  line_metadata classify_line(uint64_t block_addr, uint64_t line_size) const {
+    assert(line_size > 0);
+    assert(block_addr <= UINT64_MAX - line_size);
+    const uint64_t block_limit = block_addr + line_size;
+    line_metadata result;
+    for (unsigned i = 0; i < kMaxRegions; ++i) {
+      const descriptor &region = m_regions[i];
+      if (!region.valid) continue;
+      if (block_addr < region.limit && region.base < block_limit) {
+        assert(!result.transient() && "overlapping transient regions");
+        result.region_plus_one = static_cast<uint8_t>(i + 1);
+        result.generation = region.generation;
+      }
+    }
+    return result;
+  }
+
+  bool is_live(const line_metadata &metadata) const {
+    if (!metadata.transient()) return false;
+    const descriptor &region = m_regions[metadata.region_id()];
+    return region.valid && region.live &&
+           region.generation == metadata.generation;
+  }
+
+  bool is_dead(const line_metadata &metadata) const {
+    if (!metadata.transient()) return false;
+    const descriptor &region = m_regions[metadata.region_id()];
+    return !region.valid || !region.live ||
+           region.generation != metadata.generation;
+  }
+
+  victim_class classify_victim(const line_metadata &metadata, bool invalid,
+                               bool reserved,
+                               bool baseline_eligible) const {
+    if (reserved) return VICTIM_INELIGIBLE;
+    if (invalid) return VICTIM_INVALID;
+    if (!replacement_enabled())
+      return baseline_eligible ? VICTIM_ORDINARY : VICTIM_INELIGIBLE;
+    if (is_dead(metadata)) return VICTIM_DEAD_TRANSIENT;
+    if (!baseline_eligible) return VICTIM_INELIGIBLE;
+    if (is_live(metadata)) return VICTIM_LIVE_TRANSIENT;
+    return VICTIM_ORDINARY;
+  }
+
+  bool may_drop_dirty(const line_metadata &metadata) const {
+    return replacement_enabled() && is_dead(metadata);
+  }
+
+ private:
+  mode m_mode;
+  descriptor m_regions[kMaxRegions];
+};
+
+}  // namespace awma_transient_l2
+
+#endif

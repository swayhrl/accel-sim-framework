+
+awma_transient_drop_result tag_array::awma_oracle_drop(
+    unsigned region_id, unsigned generation) {
+  awma_transient_drop_result result;
+  if (!m_awma_is_l2) return result;
+  for (unsigned index = 0; index < m_config.get_num_lines(); ++index) {
+    cache_block_t *line = m_lines[index];
+    const awma_transient_l2::line_metadata metadata =
+        line->get_awma_transient();
+    if (!metadata.transient() || metadata.region_id() != region_id ||
+        metadata.generation != generation || line->is_invalid_line())
+      continue;
+    if (line->is_reserved_line()) {
+      ++result.reserved_lines;
+      continue;
+    }
+    ++result.lines;
+    if (line->is_modified_line()) {
+      ++result.dirty_lines;
+      result.dirty_bytes += line->get_modified_size();
+      assert(m_dirty > 0);
+      --m_dirty;
+    }
+    for (unsigned sector = 0; sector < SECTOR_CHUNCK_SIZE; ++sector) {
+      mem_access_sector_mask_t mask;
+      mask.reset();
+      mask.set(sector);
+      line->set_status(INVALID, mask);
+    }
+    line->set_awma_transient(awma_transient_l2::line_metadata());
+  }
+  return result;
 }
 

+uint64_t set_associative_tlb::history_hash(const translation_key &key,
+                                           uint64_t seed) const {
+  uint64_t value = key.vpn ^ (uint64_t(key.asid) << 32) ^ key.page_size ^ seed;
+  value ^= value >> 30;
+  value *= 0xbf58476d1ce4e5b9ULL;
+  value ^= value >> 27;
+  value *= 0x94d049bb133111ebULL;
+  value ^= value >> 31;
+  return value;
+}
+
+bool set_associative_tlb::history_contains(
+    const translation_key &key) const {
+  if (!m_refill_protection_enabled) return false;
+  static const uint64_t seeds[3] = {
+      0x9e3779b97f4a7c15ULL, 0xd1b54a32d192ed03ULL,
+      0x94d049bb133111ebULL};
+  for (unsigned hash = 0; hash < 3; ++hash) {
+    const unsigned bit = unsigned(history_hash(key, seeds[hash]) & 8191ULL);
+    if ((m_history_filter[bit >> 3] & (1U << (bit & 7))) == 0) return false;
+  }
+  return true;
+}
+
+void set_associative_tlb::history_insert(const translation_key &key) {
+  if (!m_refill_protection_enabled) return;
+  if (m_history_insertions == 1024) {
+    for (unsigned i = 0; i < m_history_filter.size(); ++i)
+      m_history_filter[i] = 0;
+    m_history_insertions = 0;
+    ++m_refill_stats.history_resets;
+  }
+  static const uint64_t seeds[3] = {
+      0x9e3779b97f4a7c15ULL, 0xd1b54a32d192ed03ULL,
+      0x94d049bb133111ebULL};
+  for (unsigned hash = 0; hash < 3; ++hash) {
+    const unsigned bit = unsigned(history_hash(key, seeds[hash]) & 8191ULL);
+    m_history_filter[bit >> 3] |= static_cast<unsigned char>(1U << (bit & 7));
+  }
+  ++m_history_insertions;
+  ++m_refill_stats.history_inserts;
+}
+
+void set_associative_tlb::reset_candidate_metadata(
+    bool count_history_reset) {
+  if (!m_refill_protection_enabled) return;
+  for (unsigned i = 0; i < m_history_filter.size(); ++i)
+    m_history_filter[i] = 0;
+  m_history_insertions = 0;
+  m_pending_refills.clear();
+  for (unsigned i = 0; i < m_entries.size(); ++i)
+    m_entries[i].protection_valid = false;
+  if (count_history_reset) ++m_refill_stats.history_resets;
+}
+
+bool set_associative_tlb::pending_contains(
+    const translation_key &key) const {
+  for (unsigned i = 0; i < m_pending_refills.size(); ++i)
+    if (m_pending_refills[i] == key) return true;
+  return false;
+}
+
+bool set_associative_tlb::pending_remove(const translation_key &key) {
+  for (unsigned i = 0; i < m_pending_refills.size(); ++i) {
+    if (!(m_pending_refills[i] == key)) continue;
+    m_pending_refills.erase(m_pending_refills.begin() + i);
+    return true;
+  }
+  return false;
+}
+
+void set_associative_tlb::note_history_miss(const translation_key &key) {
+  if (!m_refill_protection_enabled || !history_contains(key)) return;
+  ++m_refill_stats.history_hits;
+  if (pending_contains(key)) {
+    ++m_refill_stats.pending_merges;
+    return;
+  }
+  if (m_pending_refills.size() == 16) {
+    ++m_refill_stats.pending_drops;
+    return;
+  }
+  m_pending_refills.push_back(key);
+  ++m_refill_stats.pending_allocations;
+}
+
+void set_associative_tlb::refresh_protection_epoch(uint64_t cycle) {
+  if (!m_refill_protection_enabled) return;
+  const uint64_t epoch = cycle >> 20;
+  if (m_protection_epoch == ~0ULL) {
+    m_protection_epoch = epoch;
+    return;
+  }
+  if (epoch == m_protection_epoch) return;
+  for (unsigned i = 0; i < m_entries.size(); ++i)
+    m_entries[i].protection_valid = false;
+  m_protection_epoch = epoch;
+  ++m_refill_stats.timer_wrap_resets;
+}
+
+bool set_associative_tlb::entry_protected(entry *candidate,
+                                          uint64_t cycle) {
+  if (!m_refill_protection_enabled || !candidate->protection_valid)
+    return false;
+  const uint32_t low_cycle = static_cast<uint32_t>(cycle & 0xfffffULL);
+  const uint32_t elapsed = low_cycle - candidate->protection_start;
+  if (elapsed < 500000U) return true;
+  candidate->protection_valid = false;
+  return false;
+}

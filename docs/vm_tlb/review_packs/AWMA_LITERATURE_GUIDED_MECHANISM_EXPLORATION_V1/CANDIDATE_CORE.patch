+awma_translation_candidate_mode awma_candidate_mode() {
+  const char *text = getenv("GPGPUSIM_AWMA_TRANSLATION_CANDIDATE");
+  if (text == 0 || text[0] == '\0' || strcmp(text, "none") == 0)
+    return AWMA_TRANSLATION_CANDIDATE_NONE;
+  if (strcmp(text, "same_page_share") == 0)
+    return AWMA_TRANSLATION_CANDIDATE_SAME_PAGE_SHARE;
+  if (strcmp(text, "refill_protect") == 0)
+    return AWMA_TRANSLATION_CANDIDATE_REFILL_PROTECT;
+  assert(false && "unknown GPGPUSIM_AWMA_TRANSLATION_CANDIDATE");
+  return AWMA_TRANSLATION_CANDIDATE_NONE;
+}
+
+const char *awma_candidate_mode_name(awma_translation_candidate_mode mode) {
+  switch (mode) {
+    case AWMA_TRANSLATION_CANDIDATE_NONE:
+      return "none";
+    case AWMA_TRANSLATION_CANDIDATE_SAME_PAGE_SHARE:
+      return "same_page_share";
+    case AWMA_TRANSLATION_CANDIDATE_REFILL_PROTECT:
+      return "refill_protect";
+    default:
+      assert(false && "invalid AWMA translation candidate mode");
+      return "invalid";
+  }
+}
+
+bool awma_mechanism_diagnostics_enabled() {
+  const char *text = getenv("GPGPUSIM_AWMA_MECHANISM_DIAGNOSTICS");
+  return text != 0 && text[0] != '\0' && strtoul(text, 0, 10) != 0;
+}
+
+bool same_page_share_compatible(
+    unsigned owner_asid, uint64_t owner_va, uint64_t owner_bytes,
+    translation_access owner_access, uint64_t owner_generation,
+    unsigned member_asid, uint64_t member_va, uint64_t member_bytes,
+    translation_access member_access, uint64_t member_generation,
+    uint64_t page_size) {
+  if (!vm_core::valid_page_size(page_size) || owner_bytes == 0 ||
+      member_bytes == 0)
+    return false;
+  if (vm_core::transaction_crosses_page(owner_va, owner_bytes, page_size) ||
+      vm_core::transaction_crosses_page(member_va, member_bytes, page_size))
+    return false;
+  return owner_asid == member_asid && owner_access == member_access &&
+         owner_generation == member_generation &&
+         vm_core::vpn(owner_va, page_size) ==
+             vm_core::vpn(member_va, page_size);

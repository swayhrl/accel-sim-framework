@@ -0,0 +1,170 @@
+#include "passive_last_translation_forwarding.h"
+
+#include <assert.h>
+
+#include <map>
+
+namespace awma_passive_v2 {
+namespace {
+
+struct identity {
+  unsigned asid;
+  uint64_t vpn;
+  uint64_t page_size;
+  uint64_t generation;
+  vm_translation::translation_access access;
+};
+
+struct entry {
+  identity key;
+  uint64_t ppn;
+  vm_translation::translation_source source;
+};
+
+identity make_identity(unsigned asid, uint64_t sim_va, uint64_t request_bytes,
+                       uint64_t page_size, uint64_t generation,
+                       vm_translation::translation_access access) {
+  assert(vm_core::valid_page_size(page_size));
+  assert(!vm_core::transaction_crosses_page(sim_va, request_bytes, page_size));
+  identity result = {asid, vm_core::vpn(sim_va, page_size), page_size,
+                     generation, access};
+  return result;
+}
+
+}  // namespace
+
+struct forwarding_table::implementation {
+  std::map<uint64_t, entry> entries;
+};
+
+counters::counters()
+    : lookups(0), hits(0), misses(0), actual_physical_lookup_suppression(0),
+      natural_completions(0), installs(0), overwrites(0),
+      forwarded_applications(0), stale_generation_misses(0),
+      access_compatibility_misses(0), vpn_misses(0),
+      ppn_consistency_faults(0), instruction_invalidations(0) {}
+
+forwarding_table::forwarding_table()
+    : m_impl(new implementation()), m_stats() {}
+
+forwarding_table &forwarding_table::instance() {
+  static forwarding_table singleton;
+  return singleton;
+}
+
+bool forwarding_table::try_forward(
+    uint64_t instruction_key, unsigned asid, uint64_t sim_va,
+    uint64_t request_bytes, uint64_t page_size, uint64_t generation,
+    vm_translation::translation_access access, uint64_t *resolved_pa,
+    vm_translation::translation_source *source) {
+  assert(resolved_pa != NULL && source != NULL);
+  ++m_stats.lookups;
+  const identity requested = make_identity(
+      asid, sim_va, request_bytes, page_size, generation, access);
+  std::map<uint64_t, entry>::const_iterator found =
+      m_impl->entries.find(instruction_key);
+  if (found == m_impl->entries.end()) {
+    ++m_stats.misses;
+    return false;
+  }
+  const entry &last = found->second;
+  if (last.key.asid != requested.asid ||
+      last.key.vpn != requested.vpn ||
+      last.key.page_size != requested.page_size) {
+    ++m_stats.misses;
+    ++m_stats.vpn_misses;
+    return false;
+  }
+  if (last.key.generation != requested.generation) {
+    ++m_stats.misses;
+    ++m_stats.stale_generation_misses;
+    return false;
+  }
+  if (last.key.access != requested.access) {
+    ++m_stats.misses;
+    ++m_stats.access_compatibility_misses;
+    return false;
+  }
+  *resolved_pa = last.ppn * page_size + vm_core::page_offset(sim_va, page_size);
+  *source = last.source;
+  ++m_stats.hits;
+  ++m_stats.actual_physical_lookup_suppression;
+  return true;
+}
+
+void forwarding_table::note_natural_completion(
+    uint64_t instruction_key, unsigned asid, uint64_t sim_va,
+    uint64_t request_bytes, uint64_t page_size, uint64_t generation,
+    vm_translation::translation_access access, uint64_t resolved_ppn,
+    vm_translation::translation_source source) {
+  assert(source != vm_translation::TRANSLATION_SOURCE_UNOBSERVED);
+  const identity completed = make_identity(
+      asid, sim_va, request_bytes, page_size, generation, access);
+  std::map<uint64_t, entry>::iterator found =
+      m_impl->entries.find(instruction_key);
+  if (found == m_impl->entries.end()) {
+    entry installed = {completed, resolved_ppn, source};
+    m_impl->entries.insert(std::make_pair(instruction_key, installed));
+    ++m_stats.installs;
+  } else {
+    found->second.key = completed;
+    found->second.ppn = resolved_ppn;
+    found->second.source = source;
+    ++m_stats.overwrites;
+  }
+  ++m_stats.natural_completions;
+}
+
+void forwarding_table::note_forward_application() {
+  ++m_stats.forwarded_applications;
+}
+
+void forwarding_table::retire_instruction(uint64_t instruction_key) {
+  std::map<uint64_t, entry>::iterator found =
+      m_impl->entries.find(instruction_key);
+  if (found == m_impl->entries.end()) return;
+  m_impl->entries.erase(found);
+  ++m_stats.instruction_invalidations;
+}
+
+size_t forwarding_table::live_entries() const {
+  return m_impl->entries.size();
+}
+
+void forwarding_table::print(FILE *fout) const {
+  fprintf(fout, "awma_passive_v2_enabled = 1\n");
+  fprintf(fout, "awma_passive_v2_capacity = 1\n");
+  fprintf(fout, "awma_passive_v2_timing = SAME_CYCLE_COMPARE_FORWARD\n");
+  fprintf(fout, "awma_passive_v2_live_entries = %llu\n",
+          (unsigned long long)live_entries());
+  fprintf(fout, "awma_passive_v2_lookups = %llu\n",
+          (unsigned long long)m_stats.lookups);
+  fprintf(fout, "awma_passive_v2_hits = %llu\n",
+          (unsigned long long)m_stats.hits);
+  fprintf(fout, "awma_passive_v2_misses = %llu\n",
+          (unsigned long long)m_stats.misses);
+  fprintf(fout, "awma_passive_v2_actual_physical_lookup_suppression = %llu\n",
+          (unsigned long long)m_stats.actual_physical_lookup_suppression);
+  fprintf(fout, "awma_passive_v2_natural_completions = %llu\n",
+          (unsigned long long)m_stats.natural_completions);
+  fprintf(fout, "awma_passive_v2_installs = %llu\n",
+          (unsigned long long)m_stats.installs);
+  fprintf(fout, "awma_passive_v2_overwrites = %llu\n",
+          (unsigned long long)m_stats.overwrites);
+  fprintf(fout, "awma_passive_v2_forwarded_applications = %llu\n",
+          (unsigned long long)m_stats.forwarded_applications);
+  fprintf(fout, "awma_passive_v2_stale_generation_misses = %llu\n",
+          (unsigned long long)m_stats.stale_generation_misses);
+  fprintf(fout, "awma_passive_v2_access_compatibility_misses = %llu\n",
+          (unsigned long long)m_stats.access_compatibility_misses);
+  fprintf(fout, "awma_passive_v2_vpn_misses = %llu\n",
+          (unsigned long long)m_stats.vpn_misses);
+  fprintf(fout, "awma_passive_v2_ppn_consistency_faults = %llu\n",
+          (unsigned long long)m_stats.ppn_consistency_faults);
+  fprintf(fout, "awma_passive_v2_instruction_invalidations = %llu\n",
+          (unsigned long long)m_stats.instruction_invalidations);
+  fprintf(fout, "awma_passive_v2_proactive_owner_attempts = 0\n");
+  fprintf(fout, "awma_passive_v2_proactive_duplicate_lookups = 0\n");
+}
+
+}  // namespace awma_passive_v2

+#ifndef PASSIVE_LAST_TRANSLATION_FORWARDING_H
+#define PASSIVE_LAST_TRANSLATION_FORWARDING_H
+
+#include <stdint.h>
+#include <stdio.h>
+
+#include <cstddef>
+
+#include "vm_translation.h"
+
+namespace awma_passive_v2 {
+
+struct counters {
+  uint64_t lookups;
+  uint64_t hits;
+  uint64_t misses;
+  uint64_t actual_physical_lookup_suppression;
+  uint64_t natural_completions;
+  uint64_t installs;
+  uint64_t overwrites;
+  uint64_t forwarded_applications;
+  uint64_t stale_generation_misses;
+  uint64_t access_compatibility_misses;
+  uint64_t vpn_misses;
+  uint64_t ppn_consistency_faults;
+  uint64_t instruction_invalidations;
+
+  counters();
+};
+
+class forwarding_table {
+ public:
+  static forwarding_table &instance();
+
+  bool try_forward(uint64_t instruction_key, unsigned asid, uint64_t sim_va,
+                   uint64_t request_bytes, uint64_t page_size,
+                   uint64_t generation,
+                   vm_translation::translation_access access,
+                   uint64_t *resolved_pa,
+                   vm_translation::translation_source *source);
+  void note_natural_completion(
+      uint64_t instruction_key, unsigned asid, uint64_t sim_va,
+      uint64_t request_bytes, uint64_t page_size, uint64_t generation,
+      vm_translation::translation_access access, uint64_t resolved_ppn,
+      vm_translation::translation_source source);
+  void note_forward_application();
+  void retire_instruction(uint64_t instruction_key);
+  void print(FILE *fout) const;
+
+  const counters &stats() const { return m_stats; }
+  size_t live_entries() const;
+
+ private:
+  forwarding_table();
+  forwarding_table(const forwarding_table &);
+  forwarding_table &operator=(const forwarding_table &);
+
+  struct implementation;
+  implementation *m_impl;
+  counters m_stats;
+};
+
+}  // namespace awma_passive_v2
+
+#endif

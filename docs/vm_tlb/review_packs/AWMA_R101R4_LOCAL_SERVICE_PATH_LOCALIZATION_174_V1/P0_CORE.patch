new file mode 100644
--- /dev/null
+++ b/src/gpgpu-sim/awma_r101r4_local_service.h
@@ -0,0 +1,63 @@
+#ifndef AWMA_R101R4_LOCAL_SERVICE_H
+#define AWMA_R101R4_LOCAL_SERVICE_H
+
+#include <assert.h>
+
+namespace awma_r101r4 {
+
+static const unsigned kScheduledCapacity = 1;
+static const unsigned kReadyCapacity = 16;
+
+enum admission_result {
+  ADMISSION_NOT_HANDLED = 0,
+  ADMISSION_ACCEPTED,
+  ADMISSION_BACKPRESSURED
+};
+
+inline bool scheduled_full(unsigned depth) {
+  assert(depth <= kScheduledCapacity);
+  return depth == kScheduledCapacity;
+}
+
+inline bool ready_full(unsigned depth) {
+  assert(depth <= kReadyCapacity);
+  return depth == kReadyCapacity;
+}
+
+struct finite_accounting {
+  finite_accounting()
+      : admissions(0), ready_eligible(0), ready(0), retired(0),
+        scheduled_full_cycles(0), scheduled_full_events(0),
+        ready_full_cycles(0), ready_full_events(0), duplicate(0),
+        max_scheduled(0), max_ready(0) {}
+
+  unsigned long long admissions;
+  unsigned long long ready_eligible;
+  unsigned long long ready;
+  unsigned long long retired;
+  unsigned long long scheduled_full_cycles;
+  unsigned long long scheduled_full_events;
+  unsigned long long ready_full_cycles;
+  unsigned long long ready_full_events;
+  unsigned long long duplicate;
+  unsigned max_scheduled;
+  unsigned max_ready;
+
+  void observe_depth(unsigned scheduled, unsigned ready_depth) {
+    assert(scheduled <= kScheduledCapacity);
+    assert(ready_depth <= kReadyCapacity);
+    if (scheduled > max_scheduled) max_scheduled = scheduled;
+    if (ready_depth > max_ready) max_ready = ready_depth;
+  }
+
+  bool quiescent() const {
+    return admissions == ready_eligible && ready_eligible == ready &&
+           ready == retired && duplicate == 0 &&
+           max_scheduled <= kScheduledCapacity &&
+           max_ready <= kReadyCapacity;
+  }
+};
+
+}  // namespace awma_r101r4
+
+#endif

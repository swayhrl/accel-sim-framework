+namespace {
+std::map<unsigned, ldst_unit *> awma_p1_ldst_by_sid;
+}
+
+bool awma_r101r4_p1_candidate(mem_fetch *mf) {
+  if (mf == NULL) return false;
+  std::map<unsigned, ldst_unit *>::iterator found =
+      awma_p1_ldst_by_sid.find(mf->get_sid());
+  if (found == awma_p1_ldst_by_sid.end()) return false;
+  return found->second->awma_p1_candidate_impl(mf);
+}
+
+bool awma_r101r4_p1_full(mem_fetch *mf) {
+  std::map<unsigned, ldst_unit *>::iterator found =
+      awma_p1_ldst_by_sid.find(mf->get_sid());
+  assert(found != awma_p1_ldst_by_sid.end());
+  return found->second->awma_p1_full_impl(mf);
+}
+
+void awma_r101r4_p1_push(mem_fetch *mf) {
+  std::map<unsigned, ldst_unit *>::iterator found =
+      awma_p1_ldst_by_sid.find(mf->get_sid());
+  assert(found != awma_p1_ldst_by_sid.end());
+  found->second->awma_p1_push_impl(mf);
+}
+
+bool ldst_unit::awma_p1_candidate_impl(mem_fetch *mf) {
+  awma_transient_l2_controller &controller = awma_transient_l2_instance();
+  if (!controller.p1_post_l1_selected()) return false;
+  const awma_transient_l2::service_access classification =
+      controller.classify_service_access(mf->get_sim_va(),
+                                         mf->get_access_size());
+  if (!controller.p1_window_active()) {
+    if (classification.intersects_transient() &&
+        mf->mark_awma_r101r4_p1_observed())
+      controller.note_p1_inactive();
+    return false;
+  }
+  if (!classification.intersects_transient()) return false;
+  const bool atomic = mf->isatomic();
+  const bool has_inst = !mf->get_inst().empty();
+  const bool read = has_inst && mf->get_access_type() == GLOBAL_ACC_R &&
+                    !mf->get_is_write();
+  const bool write = has_inst && mf->get_access_type() == GLOBAL_ACC_W &&
+                     mf->get_is_write() && !mf->get_inst().m_is_ldgsts;
+  const bool unsupported = !(read || write);
+  if (atomic || unsupported || !classification.oracle_eligible()) {
+    if (mf->mark_awma_r101r4_p1_observed())
+      controller.note_p1_fail_closed(classification.kind, atomic, unsupported);
+    return false;
+  }
+  return true;
+}
+
+bool ldst_unit::awma_p1_full_impl(mem_fetch *mf) {
+  assert(awma_p1_candidate_impl(mf));
+  if (!awma_r101r4::scheduled_full(m_awma_p1_scheduled.size())) return false;
+  awma_transient_l2_instance().note_p1_scheduled_full(
+      mf->mark_awma_r101r4_p1_full_observed());
+  awma_transient_l2_instance().note_p1_queue_depth(
+      m_awma_p1_scheduled.size(), m_awma_p1_ready.size());
+  return true;
+}
+
+void ldst_unit::awma_p1_push_impl(mem_fetch *mf) {
+  assert(awma_p1_candidate_impl(mf));
+  assert(!awma_r101r4::scheduled_full(m_awma_p1_scheduled.size()));
+  const awma_transient_l2::service_access classification =
+      awma_transient_l2_instance().classify_service_access(
+          mf->get_sim_va(), mf->get_access_size());
+  const bool write = mf->get_is_write();
+  const bool ldgsts = !write && mf->get_inst().m_is_ldgsts;
+  const unsigned long long now =
+      m_core->get_gpu()->gpu_sim_cycle + m_core->get_gpu()->gpu_tot_sim_cycle;
+  awma_transient_l2_instance().note_p1_admission(
+      classification.metadata, write, ldgsts, mf->get_access_size(),
+      mf->get_access_byte_mask().count());
+  m_awma_p1_scheduled.push_back(awma_p1_service_entry(
+      mf, classification.metadata, write, ldgsts, now));
+  awma_transient_l2_instance().note_p1_queue_depth(
+      m_awma_p1_scheduled.size(), m_awma_p1_ready.size());
+}
+
+void ldst_unit::awma_p1_service_cycle() {
+  awma_transient_l2_controller &controller = awma_transient_l2_instance();
+  const unsigned long long now =
+      m_core->get_gpu()->gpu_sim_cycle + m_core->get_gpu()->gpu_tot_sim_cycle;
+  if (!m_awma_p1_scheduled.empty() &&
+      m_awma_p1_scheduled.front().ready_cycle <= now) {
+    awma_p1_service_entry &front = m_awma_p1_scheduled.front();
+    if (!front.ready_eligible_noted) {
+      controller.note_p1_ready_eligible(now == front.ready_cycle);
+      front.ready_eligible_noted = true;
+    }
+    if (awma_r101r4::ready_full(m_awma_p1_ready.size())) {
+      controller.note_p1_ready_full(!front.ready_full_observed);
+      front.ready_full_observed = true;
+    } else {
+      awma_p1_service_entry entry = front;
+      m_awma_p1_scheduled.pop_front();
+      entry.mf->set_reply();
+      controller.note_p1_ready(entry.metadata, entry.admission_cycle,
+                               entry.ready_cycle, now);
+      m_awma_p1_ready.push_back(entry);
+      controller.note_p1_queue_depth(m_awma_p1_scheduled.size(),
+                                     m_awma_p1_ready.size());
+    }
+  }
+  if (!m_awma_p1_ready.empty() && !response_buffer_full()) {
+    awma_p1_service_entry entry = m_awma_p1_ready.front();
+    m_awma_p1_ready.pop_front();
+    fill(entry.mf);
+    controller.note_p1_delivered(entry.write, entry.ldgsts);
+  }
+  controller.note_p1_queue_depth(m_awma_p1_scheduled.size(),
+                                 m_awma_p1_ready.size());
+}

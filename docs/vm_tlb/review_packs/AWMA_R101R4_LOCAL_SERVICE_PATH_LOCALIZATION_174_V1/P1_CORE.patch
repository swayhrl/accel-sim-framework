+
+void awma_transient_l2_controller::note_p1_admission(
+    const awma_transient_l2::line_metadata &metadata, bool write,
+    bool ldgsts, unsigned request_bytes, unsigned active_bytes) {
+  assert(p1_window_active() && m_policy.is_live(metadata));
+  ++m_p1_outstanding;
+  m_p1_request_bytes += request_bytes;
+  m_p1_active_bytes += active_bytes;
+  if (write) {
+    assert(!ldgsts);
+    ++m_p1_admitted_writes;
+  } else {
+    ++m_p1_admitted_reads;
+    if (ldgsts)
+      ++m_p1_admitted_ldgsts_reads;
+    else
+      ++m_p1_admitted_ldg_reads;
+  }
+}
+
+void awma_transient_l2_controller::note_p1_ready_eligible(bool exact_cycle) {
+  ++m_p1_ready_eligible;
+  if (!exact_cycle) ++m_p1_latency_violations;
+}
+
+void awma_transient_l2_controller::note_p1_ready(
+    const awma_transient_l2::line_metadata &metadata,
+    unsigned long long admission_cycle, unsigned long long ready_cycle,
+    unsigned long long observed_cycle) {
+  assert(m_p1_outstanding > 0);
+  if (!m_policy.is_live(metadata)) ++m_p1_stale_violations;
+  if (ready_cycle != admission_cycle + 1 || observed_cycle < ready_cycle)
+    ++m_p1_latency_violations;
+  ++m_p1_ready;
+}
+
+void awma_transient_l2_controller::note_p1_delivered(bool write,
+                                                      bool ldgsts) {
+  (void)ldgsts;
+  assert(m_p1_outstanding > 0);
+  --m_p1_outstanding;
+  if (write)
+    ++m_p1_delivered_writes;
+  else
+    ++m_p1_delivered_reads;
+}
+
+void awma_transient_l2_controller::note_p1_scheduled_full(bool first_event) {
+  ++m_p1_scheduled_full_cycles;

+
+  void note_resident(shader_core_ctx *core, const mem_access_t &access,
+                     uint64_t cycle) {
+    if (!enabled(core)) return;
+    if (m_first_resident_cycle.find(access.get_uid()) ==
+        m_first_resident_cycle.end())
+      m_first_resident_cycle[access.get_uid()] = cycle;
+  }
+
+  void note_admission(shader_core_ctx *core, const mem_access_t &access,
+                      uint64_t cycle) {
+    if (!enabled(core)) return;
+    note_resident(core, access, cycle);
+    const unsigned uid = access.get_uid();
+    unsigned &count = m_admissions_by_uid[uid];
+    ++count;
+    ++m_admission_total;
+    if (count > m_admission_count_max) m_admission_count_max = count;
+    const uint64_t latency = cycle - m_first_resident_cycle[uid];
+    m_all_issue_latency_total += latency;
+    if (latency > m_all_issue_latency_max) m_all_issue_latency_max = latency;
+    if (count == 1) {
+      m_first_issue_latency_total += latency;
+      if (latency > m_first_issue_latency_max)
+        m_first_issue_latency_max = latency;
+    }
+  }
+
+  void note_cohort(shader_core_ctx *core, unsigned owner_uid,
+                   unsigned cohort_size) {
+    if (!enabled(core) || !m_cohort_owners.insert(owner_uid).second) return;
+    if (cohort_size > m_cohort_size_max) m_cohort_size_max = cohort_size;
+    unsigned bucket = cohort_size <= 2 ? 0 : cohort_size == 3 ? 1
+                      : cohort_size == 4 ? 2 : cohort_size <= 8 ? 3
+                      : cohort_size <= 16 ? 4 : 5;
+    ++m_cohort_histogram[bucket];
+  }
+
+  void note_owner_attempt(shader_core_ctx *core, unsigned owner_uid) {
+    if (!enabled(core)) return;
+    unsigned &count = m_owner_attempts_by_uid[owner_uid];
+    ++count;
+    ++m_owner_attempt_total;
+    if (count > m_owner_attempt_max) m_owner_attempt_max = count;
+  }
+
+  void note_owner_ready(shader_core_ctx *core,

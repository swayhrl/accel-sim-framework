+            "untranslated=%llu unobserved=%llu unique=%llu "
+            "translated_unique=%llu untranslated_unique=%llu\n",
+            g_vm_cov.admissions, g_vm_cov.translated, g_vm_cov.untranslated,
+            g_vm_cov.unobserved,
+            (unsigned long long)g_vm_cov.all.size(),
+            (unsigned long long)g_vm_cov.translated_uids.size(),
+            (unsigned long long)g_vm_cov.untranslated_uids.size());
+  g_owner_wait.print(f);
+}

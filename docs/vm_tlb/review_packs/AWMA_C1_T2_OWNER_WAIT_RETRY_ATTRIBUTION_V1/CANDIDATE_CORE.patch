+static void vm_cov_note(shader_core_ctx *c, const mem_access_t &a) {
+  if (!vm_cov_enabled(c)) return;
+  ++g_vm_cov.admissions;
+  g_vm_cov.all.insert(a.get_uid());
+  if (a.vm_translation_applied()) {
+    ++g_vm_cov.translated;
+    g_vm_cov.translated_uids.insert(a.get_uid());
+  } else {
+    ++g_vm_cov.untranslated;
+    g_vm_cov.untranslated_uids.insert(a.get_uid());
+  }
+  if (a.get_translation_telemetry_outcome() == 0) ++g_vm_cov.unobserved;
+  g_owner_wait.note_admission(c, a, vm_observation_cycle(c));

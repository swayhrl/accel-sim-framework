# NOT_EXECUTED: synthetic bounded Source78 W-only CPU profile, not application config.
-gpgpu_n_clusters 1
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_mem 1
-gpgpu_n_sub_partition_per_mchannel 1
-gpgpu_l2_rop_latency 0
-gpgpu_cache:dl2 S:1:128:1,L:B:m:L:L,A:128:1,128:0,32
-gpgpu_ep_l2_payload_mode 2
-gpgpu_ep_l2_descriptor_pool_size 512
-gpgpu_ep_l2_descriptor_per_line_cap 32
-gpgpu_ep_l2_wad_entries 128
-gpgpu_ep_l2_ft_mode 2
-gpgpu_ep_l2_wbuf_entries 16
-gpgpu_ep_l2_wb_local_cap 0
-gpgpu_ep_l2_static_s64 0
-gpgpu_ep_l2_tvd_clean 0
-gpgpu_ep_l2_tvd_dirty 0
-gpgpu_ep_l2_tvd_fixed_entries 0
-gpgpu_ep_l2_ro_tag_detach 0
-gpgpu_ep_l2_ro_line_mshr_bypass 0
-gpgpu_ep_l2_bank_ops 1
-gpgpu_ep_l2_ms_observer 0
-gpgpu_ep_l2_diag_copy_free 0
-gpgpu_ep_l2_diag_l2_data_free 0
-gpgpu_ep_l2_ideal_wb 0
-gpgpu_ep_l2_ideal_meta 0
-gpgpu_ep_l2_ideal_read_hit 0

# One-channel CPU fixture address mapping only; application mapping unchanged.
-gpgpu_memory_partition_indexing 0

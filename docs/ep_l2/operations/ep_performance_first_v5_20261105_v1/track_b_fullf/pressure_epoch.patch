@@ -107,6 +111,16 @@ class ep_l2_ro_runtime : public ep_l2_ro::tag_port {
   // Called once at the actual timed frontend-head observation point. Preview
   // itself never launches a lookup, reserves ownership or changes counters.
   void frontend_cycle(mem_fetch *m) {
+    if(c.m_config.m_ro_pressure_epoch && !pressure_epoch_active &&
+       directory_ready(m) && candidate(m)) {
+      unsigned index=~0U;
+      const auto p=c.m_tag_array->probe(c.m_config.block_addr(m->get_addr()),index,m,false,true);
+      // The existing indexed Tag probe and maintained native LineMSHR count
+      // feed this one-bit control update. No ownership is granted here.
+      if(p!=HIT && (p==RESERVATION_FAIL || c.m_mshrs.num_entries_used()>=128)) {
+        pressure_epoch_active=true;++pressure_epoch_activations;
+      }
+    }
     if (!new_request(m) || !directory_ready(m)) return;
     const auto now=physical_cycle();
     if (query_uid!=m->get_request_uid()) {
@@ -146,7 +160,11 @@ class ep_l2_ro_runtime : public ep_l2_ro::tag_port {
   }
   void record_accepted(mem_fetch *m) {
     if(demand(m))++accepted_global_reads;
-    if(candidate(m))++accepted_candidates;
+    if(candidate(m)) {
+      ++accepted_candidates;
+      if(c.m_config.m_ro_pressure_epoch && !pressure_epoch_active)
+        ++pressure_native_accepted;
+    }
     if (observed_uid==m->get_request_uid()) {
       for (unsigned r=0;r<6;++r) if (blocked_mask&(uint64_t(1)<<r)) {
         uint64_t duration=physical_cycle()-first_wait[r];wait_cycles[r]+=duration;
@@ -214,6 +232,10 @@ class ep_l2_ro_runtime : public ep_l2_ro::tag_port {
       if(c.m_tag_array->block_is_modified(i) || (c.m_ep_l2_payload.handle_live(resident) &&
           (c.m_ep_l2_payload.inspect(resident).pending_sector_mask.any() || c.m_ep_l2_payload.inspect(resident).pins)))return false;
     }
+    // Both predicates are existing indexed Tag/LineMSHR admission results.
+    // No address CAM or new target directory is introduced. Before activation
+    // there is no RO owner; after activation all old RO ownership rules stay.
+    if(c.m_config.m_ro_pressure_epoch && !pressure_epoch_active)return false;
     return p!=HIT;
   }
   unsigned needed(mem_fetch *m,handle h) const {
@@ -436,6 +458,9 @@ void l2_cache::ro_print(FILE *f,unsigned slice) const {
     }
   }
   if(m_ro){
+  fprintf(f,"EPL2ROP5|ADMISSION|slice=%u|policy_pressure_epoch=%u|active=%u|activations=%llu|native_before_activation=%llu|control_bits_per_slice=1|query_ports_added=0|directory_entries_added=0|epoch_reset=INIT_ONLY_ONE_COMMANDLIST_EPOCH\n",
+    slice,m_config.m_ro_pressure_epoch,m_ro->pressure_epoch_active,
+    (unsigned long long)m_ro->pressure_epoch_activations,(unsigned long long)m_ro->pressure_native_accepted);
   const auto &s=m_ro->tx->stats;
   fprintf(f,"EPL2ROV1|SUMMARY|slice=%u|detach=%u|bypass=%u|accepted_global_reads=%llu|accepted_oracle_candidates=%llu|accepted_ro=%llu|transactions=%llu|merges=%llu|detached=%llu|lower_sectors=%llu|concurrent_duplicate_sectors=%llu|responses=%llu|ro_bank_fill_ops=%llu|ro_bank_response_ops=%llu|live=%u|manifest=%s|scope=%s\n",
     slice,m_config.m_ro_tag_detach,m_config.m_ro_line_mshr_bypass,
@@ -478,3 +503,7 @@ void l2_cache::ro_frontend_cycle(mem_fetch *mf) {if(m_ro){
   // behind an RO owner before access() gets a chance to reject the violation.
   m_ro->check_access(mf);m_ro->frontend_cycle(mf);
 }}
+
+// CPU protocol probes expose counters only; they perform no query or mutation.
+bool l2_cache::ro_pressure_epoch_active_for_test() const {return m_ro && m_ro->pressure_epoch_active;}
+unsigned long long l2_cache::ro_query_count_for_test() const {return m_ro?m_ro->query_count:0;}

   mutable std::array<std::array<uint64_t,16>,6> wait_hist{};
+  // One physical control bit per slice. Set only at the timed frontend on observed pressure,
+  // never by preview, and never clear while any epoch owner may remain live.
+  bool pressure_epoch_active=false;
+  uint64_t pressure_epoch_activations=0,pressure_native_accepted=0;

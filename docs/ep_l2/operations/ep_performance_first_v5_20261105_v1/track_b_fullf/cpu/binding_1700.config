# NEW FINITE CPU FIXTURE ONLY; no application authority
# SPECULATIVE_CALIBRATION_D512: B0-Banked at 850 MHz.
# This is byte-for-byte semantically identical to b0_banked_850.config except
# for the global persistent descriptor-pool capacity: 256 -> 512.
-gpgpu_adaptive_cache_config 0
-gpgpu_ep_l2_assert_fixed_l1_assoc 1
-gpgpu_cache:dl1 S:4:128:128,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_l1_banks 4
-gpgpu_l1_latency 20
-gpgpu_cache:dl2 S:64:128:16,L:B:m:L:P,A:128:1,128:0,32
-gpgpu_ep_l2_descriptor_pool_size 512
-gpgpu_ep_l2_descriptor_per_line_cap 32
-gpgpu_ep_l2_wad_entries 128
-gpgpu_ep_l2_payload_mode 2
-gpgpu_dram_partition_queues 64:128:64:64
-gpgpu_frfcfs_dram_sched_queue_size 128
-gpgpu_dram_return_queue_size 192
-gpgpu_clock_domains 1132.0:1132.0:1132.0:1700.0

# DRAFT ONLY: not native-qualified and not application launch authority.
# Append after the SAME accepted H0 base/trace/target/nonresearch overlays.
# Same future binary and uncapped whole commandlist; E revalidates full trace bytes.
-gpgpu_ep_l2_wbuf_entries 16
-gpgpu_ep_l2_payload_mode 2
-gpgpu_ep_l2_descriptor_pool_size 512
-gpgpu_ep_l2_descriptor_per_line_cap 32
-gpgpu_ep_l2_wad_entries 128
-gpgpu_ep_l2_bank_ops 1
-gpgpu_ep_l2_static_s64 0
-gpgpu_ep_l2_wb_local_cap 0
-gpgpu_ep_l2_mq2 0
-gpgpu_ep_l2_rg1 0
-gpgpu_ep_l2_ideal_meta 0

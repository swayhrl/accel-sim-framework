diff --git a/tests/ep_l2/test_v5_cold_filter.cc b/tests/ep_l2/test_v5_cold_filter.cc
new file mode 100644
index 0000000..be386d0
--- /dev/null
+++ b/tests/ep_l2/test_v5_cold_filter.cc
@@ -0,0 +1,35 @@
+#include "ms_victim/native_fixture.h"
+int main(int argc,char **argv) {
+  assert(argc==4);const std::string mode=argv[3];
+  char two[]="2",sixteen[]="16",zero[]="0",one[]="1";
+  char *args[]={argv[0],argv[1],argv[2],two,sixteen,zero,zero,one};
+  victim_fixture f(args,"512:2:64:64","S:32:128:8,L:B:m:L:L,A:128:1,256:0,32");
+  auto cache=f.cache;auto dir=cache->tvd_for_test();assert(dir && dir->never_installed());
+  const bool enabled=mode!="off";
+  f.read(0);
+  assert(dir->never_installed());
+  assert(enabled ? (cache->tvd_lookup_queries_for_test()==0 && cache->tvd_cold_bypasses_for_test()>0)
+                 : (cache->tvd_lookup_queries_for_test()>0 && cache->tvd_cold_bypasses_for_test()==0));
+  std::vector<new_addr_type> lines;lines.push_back(0);
+  for(new_addr_type a=128;lines.size()<10;a+=128)
+    if(f.gpu->getMemoryConfig()->m_L2_config.set_index(a)==0)lines.push_back(a);
+  if(mode=="dirty")f.write(0);
+  for(unsigned i=1;i<9;++i)f.read(lines[i]);
+  assert(!dir->never_installed());
+  const auto bypasses=cache->tvd_cold_bypasses_for_test();
+  const auto queries=cache->tvd_lookup_queries_for_test();
+  if(mode=="dirty") {
+    assert(cache->ep_l2_wad_contains(0));
+    auto r=f.make(0,false);const auto uid=r->get_request_uid();f.send(r);
+    for(unsigned i=0;i<6;++i)f.step();
+    assert(cache->tvd_lookup_queries_for_test()>queries);
+    f.complete_writebacks(); f.wait(uid);
+  } else {
+    f.read(0);assert(cache->tvd_lookup_queries_for_test()>queries);
+  }
+  assert(cache->tvd_cold_bypasses_for_test()==bypasses);
+  f.finish();assert(!dir->occupied() && !dir->never_installed());
+  f.read(lines[9]);assert(cache->tvd_cold_bypasses_for_test()==bypasses);
+  f.finish();printf("V5_COLD_FILTER_PASS|mode=%s|queries=%llu|bypasses=%llu\n",
+      mode.c_str(),cache->tvd_lookup_queries_for_test(),cache->tvd_cold_bypasses_for_test());
+}
diff --git a/tests/ep_l2/test_v5_cold_proof.cc b/tests/ep_l2/test_v5_cold_proof.cc
new file mode 100644
index 0000000..206bc82
--- /dev/null
+++ b/tests/ep_l2/test_v5_cold_proof.cc
@@ -0,0 +1,35 @@
+#include "../../src/gpgpu-sim/ep-l2-tvd-directory.h"
+#include <cstdio>
+using D=ep_l2_tvd_directory<>;
+int main(){
+  for(bool dirty:{false,true}) {
+    D d(1,true,true);D::ticket t;ep_l2::PayloadHandle h(0,1);
+    assert(d.never_installed());
+    auto p=d.preview_install(0,dirty);
+    assert(d.commit_install(p,0,h,1,dirty?1:0,1,dirty,1,t)==D::INVALID_INPUT);
+    assert(d.never_installed()); // unsuccessful producer never sets false-positive
+    assert(d.commit_install(p,0,h,1,dirty?1:0,0,dirty,1,t)==D::OK);
+    assert(!d.never_installed() && d.occupied()==1); // SET precedes visibility
+    const auto o=d.preview_ticket(t,1,D::READ_OP);D::read_lease l;
+    assert(o.status==D::READ_READY && d.begin_read(o,1,l)==D::OK);
+    ep_l2::PayloadHandle released;
+    assert(d.reclaim(t,released,1)==(dirty?D::WAIT_WRITEBACK:D::PINNED));
+    assert(!d.never_installed());
+    assert(d.cancel_read(l)==D::OK);
+    if(dirty) {
+      assert(d.bind_writeback(t,23)==D::OK);
+      assert(d.lower_accept(t,false,2)==D::DATA_TRANSFER_UNPROVEN);
+      assert(d.lower_accept(t,true,2)==D::OK);
+      assert(!d.epoch_ready() && !d.never_installed());
+      assert(d.set_done(t,3)==D::OK);
+    }
+    assert(d.reclaim(t,released,4)==D::OK);
+    assert(!d.occupied() && !d.never_installed()); // sticky; no unsafe empty reset
+    assert(d.reclaim(t,released,4)==D::STALE);
+    auto q=d.preview_install(128,true);
+    assert(d.commit_install(q,128,h,1,1,0,true,5,t)==D::OK);
+    assert(d.rollback_staged(t,6)==D::OK);
+    assert(!d.occupied() && !d.never_installed());
+  }
+  printf("V5_COLD_PROOF_PASS|profiles=2|checks=failed_commit,set_before_visible,reader_pin,mandatory_WB,lower_data,stale_ticket,rollback,sticky_empty\n");
+}

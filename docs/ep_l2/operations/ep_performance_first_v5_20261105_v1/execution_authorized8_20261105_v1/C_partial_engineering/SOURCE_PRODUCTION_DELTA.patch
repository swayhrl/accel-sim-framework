   // Clean missing-sector fallback/reclaim drops the old directory visibility
   // before an ordinary miss is issued. Dirty entries must first complete WB.
+  reclaim_plan preview_reserved_reclaim(ticket t) const {
+    reclaim_plan p;p.source=t;
+    if(!live(t))return p;
+    const entry&e=m_entries[t.index];
+    if(e.mandatory()){p.status=WAIT_WRITEBACK;return p;}
+    if(e.readers){p.status=PINNED;return p;}
+    // erase() bumps incarnation after decrementing CLEAN count. Exhaustion
+    // MUST be rejected before that decrement, not after partial publication.
+    if(e.incarnation==std::numeric_limits<std::uint64_t>::max())
+      throw std::overflow_error("reclaim incarnation exhausted before READ");
+    if(e.status==CLEAN && !m_clean_count)
+      throw std::logic_error("CLEAN count inconsistent before reserved reclaim");
+    p.status=OK;p.payload=e.payload;p.old_state=e.status;
+    p.valid=e.valid_sectors;p.dirty=e.dirty_sectors;return p;
+  }
+  result commit_reserved_reclaim(const reclaim_plan&p,Handle&released,cycle_type now) {
+    if(p.status!=OK)return p.status;
+    if(!live(p.source))return STALE;
+    const entry&e=m_entries[p.source.index];
+    if(e.readers)return PINNED;
+    if(e.status!=p.old_state||!same(e.payload,p.payload)||
+       e.valid_sectors!=p.valid||e.dirty_sectors!=p.dirty)return STALE;
+    if(e.mandatory())return WAIT_WRITEBACK;
+    if(e.incarnation==std::numeric_limits<std::uint64_t>::max())
+      throw std::overflow_error("reclaim incarnation exhausted before COMMIT");
+    const unsigned count_before=m_clean_count;
+    if(e.status==CLEAN && !count_before)
+      throw std::logic_error("reserved reclaim count underflow");
+    const unsigned count_target=count_before-(e.status==CLEAN?1:0);
+    // One selected-row erase and one actual signed-count update are published
+    // in the caller's paid COMMIT beat. No callback/enqueue occurs in between.
+    const result r=reclaim(p.source,released,now);
+    if(r!=OK)return r;
+    if(m_clean_count!=count_target)
+      throw std::logic_error("reserved reclaim count publication mismatch");
+    return OK;
+  }

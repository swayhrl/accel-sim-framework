@@ -0,0 +1,28 @@
+// Fixture reuse only. Old main/selectors are never called.
+#define main frozen_old_test_main_not_executed
+#include "test_tvd_production.cc"
+#undef main
+int main(int argc,char**argv){
+  assert(argc==4);bool real=std::string(argv[3])=="real";
+  scenario f(argv[1],argv[2],true,true,false,1,2,1,16);
+  auto step=[&](){
+    f.part->cache_cycle(f.gpu->gpu_sim_cycle);
+    if(real){f.part->dram_cycle();f.part->dram_cycle();f.part->dram_cycle();}
+    else {f.part->simple_dram_model_cycle();f.part->simple_dram_model_cycle();f.part->simple_dram_model_cycle();}
+    ++f.gpu->gpu_sim_cycle;f.collect();
+  };
+  auto wait=[&](unsigned uid){for(unsigned n=0;n<200000&&!f.responses.count(uid);++n)step();assert(f.responses.count(uid));};
+  for(unsigned i=0;i<12;++i){unsigned uid=f.push(i*128,true);wait(uid);}
+  for(unsigned n=0;n<400000&&f.part->busy();++n)step();
+  assert(!f.part->busy());assert(!f.sp->ep_l2_wad_occupancy());
+  assert(f.sp->l2_char_no_resource_leak());assert(f.cache()->ft_drained());
+  const auto&q=f.cache()->quota_row_port_for_test();
+  assert(q.pending()==0);assert(q.stats().acks>=20);
+  assert(q.stats().read_beats&&q.stats().commit_beats&&q.stats().holds);
+  printf("PASS PRODUCTION_HANDSHAKE path=%s K=%u rows=%llu READ=%llu COMMIT=%llu holds=%llu L2ticks=%llu cycles=%llu\n",
+    real?"bounded_real_DRAM_returnq":"bounded_simple_latency_queue",q.lanes(),
+    (unsigned long long)q.stats().acks,(unsigned long long)q.stats().read_beats,
+    (unsigned long long)q.stats().commit_beats,(unsigned long long)q.stats().holds,
+    f.cache()->quota_l2_tick_for_test(),(unsigned long long)f.gpu->gpu_sim_cycle);
+  puts("PASS actual_credit_tracker_packet_drained no_hidden_completion_ingress");
+}
diff --git a/tests/ep_l2/test_quota_row_port_v5.cc b/tests/ep_l2/test_quota_row_port_v5.cc
new file mode 100644
index 0000000..73a1971
--- /dev/null
+++ b/tests/ep_l2/test_quota_row_port_v5.cc
@@ -0,0 +1,37 @@
+#include <cassert>
+#include <cstdio>
+#include "../../src/gpgpu-sim/ep-l2-quota-row-port.h"
+using P=ep_l2_quota_row_port;
+int main(){
+  P::key a(1,5,0,1,5,7,2),b(2,6,1,2,6,8,3),c(1,7,2,3,7,9,2);
+  for(unsigned k=1;k<=2;++k){
+    P p(k);assert(!p.ready(a,1));assert(!p.ready(a,1));
+    assert(p.stats().read_beats==1&&p.pending()==1);
+    assert(!p.ready(b,1));
+    if(k==2)assert(p.pending()==2);else assert(p.pending()==1);
+    assert(!p.ready(c,1));assert(p.pending()==k);
+    assert(p.ready(a,2));p.commit(a,2);
+    if(k==2){assert(p.ready(b,2));p.commit(b,2);}
+    assert(!p.ready(c,2));assert(p.pending()==0);
+    assert(p.stats().commit_beats==1&&p.stats().acks==k);
+    assert(!p.ready(c,3));assert(p.ready(c,7));p.commit(c,7);
+    assert(p.pending()==0&&p.stats().read_beats==2&&p.stats().commit_beats==2);
+    bool bad=false;try{p.commit(c,7);}catch(const std::logic_error&){bad=true;}assert(bad);
+    printf("PASS K%u fixed_port_batch read=%llu commit=%llu acks=%llu\n",k,
+      (unsigned long long)p.stats().read_beats,(unsigned long long)p.stats().commit_beats,
+      (unsigned long long)p.stats().acks);
+  }
+  P p(2);assert(!p.ready(a,1));
+  auto same=a;same.uid=9;assert(!p.ready(same,1));
+  assert(p.stats().row_conflicts==1&&p.pending()==1);
+  assert(p.cancel(a));assert(!p.ready(b,1)&&p.pending()==0);
+  assert(!p.ready(b,2)&&p.pending()==1);
+  assert(p.ready(b,3));assert(p.ready(b,3));assert(p.pending()==1);
+  p.commit(b,3);assert(p.pending()==0);
+  int d[2]={-1,1};assert(P::merged_count(64,64,d,2,2)==64);
+  int z[2]={0,0};assert(P::merged_count(64,64,z,2,2)==64);
+  int up[2]={1,1};bool bad=false;try{P::merged_count(63,64,up,2,2);}catch(...){bad=true;}assert(bad);
+  bad=false;int rev[2]={1,-1};try{P::merged_count(64,64,rev,2,2);}catch(...){bad=true;}assert(bad);
+  auto other=b;other.generation++;bad=false;try{p.commit(other,3);}catch(...){bad=true;}assert(bad);
+  puts("PASS same_row_conflict cancel_no_refund repeated_DRAM_poll delta_order identity_no_steal");
+}

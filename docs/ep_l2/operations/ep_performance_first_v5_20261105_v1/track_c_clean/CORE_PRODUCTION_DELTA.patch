+     m_tvd->at(t.index).status!=tvd_directory::WB_INFLIGHT)
+    throw std::logic_error("stale WB completion before credit/packet release");
+  return m_quota_row_port.ready(quota_key(2,mf->get_request_uid(),t),m_quota_l2_tick);
+}

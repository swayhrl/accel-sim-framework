diff --git a/gpu-simulator/accel-sim.cc b/gpu-simulator/accel-sim.cc
index 7a520f7..9b03677 100644
--- a/gpu-simulator/accel-sim.cc
+++ b/gpu-simulator/accel-sim.cc
@@ -92,6 +92,8 @@ void accel_sim_framework::simulation_loop() {
       fflush(stdout);
       break;
     }
+    if(commandlist_index==commandlist.size()&&kernels_info.empty())
+      m_gpgpu_sim->quota_request_terminal_cleanup();
   }
 
   // cleanup() reports a completed kernel as soon as its CTA work retires.
@@ -102,6 +104,7 @@ void accel_sim_framework::simulation_loop() {
     m_gpgpu_sim->ro_end_epoch();
     printf("EPL2ROV1|COMMANDLIST_END|complete=1|commands=%zu\n", commandlist.size());

+ int next(){double sm=std::min(ct,std::min(it,dt));int m=0;if(lt<=sm){sm=lt;m|=8;lt+=lp;}if(it<=sm){m|=2;it+=ip;}if(dt<=sm){m|=4;dt+=dp;}if(ct<=sm){m|=1;ct+=cp;}return m;}
+};

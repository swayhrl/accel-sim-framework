{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storage-Ops V9 source V2 canonical target transaction manifest",
  "type": "object",
  "required": ["source_filesystem_identity", "source_root", "source_frozen_commit", "selector_sha256", "genuine164_destination_root", "source_file_inventory_sha256", "source_directory_inventory_sha256", "files", "directories", "source_originals_action"],
  "properties": {
    "source_filesystem_identity": {"type": "string", "minLength": 1},
    "source_root": {"type": "string", "pattern": "^/"},
    "source_frozen_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "selector_sha256": {"$ref": "#/$defs/sha256"},
    "source_file_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "source_directory_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "genuine164_destination_root": {"type": "string", "pattern": "^/root/share/mnt164/huangrulin/host174_storage_recovery/174new_archive/20261016_storageops_02/increments/20261018_v9_cold_source_01/"},
    "source_originals_action": {"const": "SOURCE_KEEP_NO_RELEASE_AUTHORITY"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "directories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/directory"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native": {
      "type": "object",
      "required": ["relative_path", "type", "dev", "inode", "nlink", "size", "allocated", "uid", "gid", "mode", "mtime_ns", "ctime_ns"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "dev": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "nlink": {"type": "integer", "minimum": 1},
        "size": {"type": "integer", "minimum": 0},
        "allocated": {"type": "integer", "minimum": 0},
        "uid": {"type": "integer", "minimum": 0},
        "gid": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4095},
        "mtime_ns": {"type": "integer"},
        "ctime_ns": {"type": "integer"}
      }
    },
    "file": {"allOf": [{"$ref": "#/$defs/native"}, {"required": ["sha256"], "properties": {"type": {"const": "regular"}, "nlink": {"const": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}]},
    "directory": {"allOf": [{"$ref": "#/$defs/native"}, {"properties": {"type": {"const": "directory"}}}]}
  },
  "$comment": "Runtime additionally rejects noncanonical paths, symlink traversal, duplicate paths, missing parent metadata, wrong real164 mount, selector/hash/txid mismatch, unowned destination, and any production source release. Receipt states and source deletion chains are separate from this immutable manifest."
}

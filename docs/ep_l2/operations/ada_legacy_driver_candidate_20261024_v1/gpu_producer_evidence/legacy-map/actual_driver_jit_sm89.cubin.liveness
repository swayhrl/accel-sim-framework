//--------------------- .text.jit_leaf            --------------------------
	.section	.text.jit_leaf,"ax",@progbits
	.sectioninfo	@"SHI_REGISTERS=8"
	.align	128
                                                                                         // +-----------+--------+-----------+
                                                                                         // |   GPR     | PRED   |   UGPR    |
                                                                                         // |           |        |           |
                                                                                         // |           |        |           |
                                                                                         // | # 012345  |  # 0   | # 012345  |
                                                                                         // +-----------+--------+-----------+
        .global         jit_leaf                                                         // |           |        |           |
        .type           jit_leaf,@function                                               // |           |        |           |
        .size           jit_leaf,(.L_x_1 - jit_leaf)                                     // |           |        |           |
        .other          jit_leaf,@"STO_CUDA_ENTRY STV_DEFAULT"                           // |           |        |           |
jit_leaf:                                                                                // |           |        |           |
.text.jit_leaf:                                                                          // |           |        |           |
        /*0000*/                   MOV R1, c[0x0][0x28] ;                                // | 1  ^      |        |           |
        /*0010*/                   S2R R2, SR_CTAID.X ;                                  // | 2  :^     |        |           |
        /*0020*/                   S2R R3, SR_TID.X ;                                    // | 3  ::^    |        |           |
        /*0030*/                   IMAD R2, R2, c[0x0][0x0], R3 ;                        // | 3  :xv    |        |           |
        /*0040*/                   ISETP.GE.U32.AND P0, PT, R2, c[0x0][0x168], PT ;      // | 2  :v     |  1 ^   |           |
        /*0050*/               @P0 EXIT ;                                                // | 2  ::     |  1 v   |           |
        /*0060*/                   MOV R5, 0x11 ;                                        // | 3  ::  ^  |        |           |
        /*0070*/                   ULDC.64 UR4, c[0x0][0x118] ;                          // | 3  ::  :  |        | 2     ^^  |
        /*0080*/                   MOV R3, 0x4 ;                                         // | 4  ::^ :  |        | 2     ::  |
        /*0090*/                   IMAD R5, R2.reuse, R5, 0x5 ;                          // | 4  :v: x  |        | 2     ::  |
        /*00a0*/                   IMAD.WIDE.U32 R2, R2, R3, c[0x0][0x160] ;             // | 4  :xx :  |        | 2     ::  |
        /*00b0*/                   STG.E [R2.64], R5 ;                                   // | 4  :vv v  |        | 2     vv  |
        /*00c0*/                   EXIT ;                                                // | 1  :      |        |           |
.L_x_0:                                                                                  // +...........+........+...........+
        /*00d0*/                   BRA `(.L_x_0);                                        // | 1  :      |        |           |
.L_x_1:                                                                                  // +-----------+--------+-----------+

                                                                                         // Legend:
                                                                                         //     ^       : Register assignment
                                                                                         //     v       : Register usage
                                                                                         //     x       : Register usage and reassignment
                                                                                         //     :       : Register in use
                                                                                         //     <space> : Register not in use
                                                                                         //     #       : Number of occupied registers


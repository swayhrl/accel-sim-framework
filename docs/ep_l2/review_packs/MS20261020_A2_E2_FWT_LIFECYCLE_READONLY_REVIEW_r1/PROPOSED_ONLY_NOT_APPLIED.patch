+@contextmanager
+def defer_sigterm_until_owned_runs_retire():
+    """Main-thread only: stop new dispatch, retain original wait-owning parent.
+
+    SIGKILL/external tree teardown is outside this graceful-shutdown contract.
+    Original per-run timeout/resource guards remain active in runner.execute.
+    """
+    stopping = SimpleNamespace(requested=False)
+    previous = signal.signal(signal.SIGTERM, lambda _signum, _frame: setattr(stopping, "requested", True))
+    try:
+        yield stopping
+    finally:
+        signal.signal(signal.SIGTERM, previous)
+

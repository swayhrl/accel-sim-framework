+  assert(s.ready_snapshot_digest==s.consumed_snapshot_digest && s.snapshot_bytes_ready==s.snapshot_bytes_consumed);
+  s.print(stdout);std::puts("ALL_DATA_NATIVE_LDST_SPACES_PENDING_REGISTER_STORE_COMPLETION PASS");

diff --git a/tests/ep_l2/test_ideal_meta.cc b/tests/ep_l2/test_ideal_meta.cc
new file mode 100644
index 00000000..7abb08ae
--- /dev/null
+++ b/tests/ep_l2/test_ideal_meta.cc
@@ -0,0 +1,59 @@
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include "../../src/gpgpu-sim/gpu-cache.h"
+
+static mem_fetch *token(unsigned i) {
+  return reinterpret_cast<mem_fetch *>(static_cast<uintptr_t>(i + 1));
+}
+static mem_access_sector_mask_t sector(unsigned i) {
+  mem_access_sector_mask_t s; s.set(i); return s;
+}
+int main() {
+  // The ordinary OFF allocator still refuses at the independent limits.
+  mshr_table off(2, 1, 4, 2, false);
+  off.add_for_test(0x1000, token(0), sector(0));
+  off.add_for_test(0x1000, token(1), sector(0));
+  assert(off.full_reason(0x1000) == mshr_table::EP_L2_BLOCK_PER_ADDRESS_CAP);
+  off.add_for_test(0x2000, token(2), sector(0));
+  assert(off.full_reason(0x3000) == mshr_table::EP_L2_BLOCK_LINE_MSHR_FULL);
+
+  // Cross the original pool, line, and same-address limits many times. No
+  // guessed large capacity is substituted: real descriptor storage grows.
+  for (unsigned count : {1024u, 2048u}) {
+    mshr_table ideal(2, 1, 4, 2, true);
+    for (unsigned i = 0; i < count; ++i) {
+      const new_addr_type line = i < count / 2 ? 0x4000 : 0x8000 + i * 128;
+      assert(ideal.full_reason(line) == mshr_table::EP_L2_BLOCK_NONE);
+      ideal.add_for_test(line, token(i), sector(i % 4));
+    }
+    assert(ideal.descriptor_count_used() == count);
+    assert(ideal.descriptor_pool_capacity() >= count);
+    assert(ideal.num_entries_used() == 1 + count / 2);
+    bool atomic = false;
+    // Partial fill only releases the matching sectors. A response remains
+    // owned until commit; repeated peek is non-destructive.
+    ideal.mark_ready(0x4000, atomic, sector(0));
+    assert(!atomic);
+    assert(ideal.num_response_ready_targets() == count / 8);
+    assert(ideal.peek_next_access() == ideal.peek_next_access());
+    assert(ideal.descriptor_count_used() == count);
+    for (unsigned s = 1; s < 4; ++s) ideal.mark_ready(0x4000, atomic, sector(s));
+    for (unsigned i = count / 2; i < count; ++i)
+      ideal.mark_ready(0x8000 + i * 128, atomic, sector(i % 4));
+    std::set<mem_fetch *> responded;
+    while (ideal.access_ready()) {
+      assert(responded.insert(ideal.peek_next_access()).second);
+      ideal.commit_next_access();
+    }
+    assert(responded.size() == count);
+    assert(ideal.descriptor_count_used() == 0 && ideal.num_entries_used() == 0);
+    // Reuse all dynamic IDs after drain.
+    ideal.add_for_test(0x100000, token(count + 1), sector(3));
+    ideal.mark_ready(0x100000, atomic, sector(3));
+    assert(ideal.peek_next_access() == token(count + 1));
+    ideal.commit_next_access();
+    assert(ideal.descriptor_count_used() == 0);
+  }
+  std::puts("Lane4 I_META allocator/sector/response/doubling tests: PASS");
+}
diff --git a/tests/ep_l2/test_ideal_meta_integrated.cc b/tests/ep_l2/test_ideal_meta_integrated.cc
new file mode 100644
index 00000000..0f372d53
--- /dev/null
+++ b/tests/ep_l2/test_ideal_meta_integrated.cc
@@ -0,0 +1,41 @@
+#include "ideal_test_fixture.h"
+#include <set>
+
+int main(int argc, char **argv) {
+  assert(argc == 3);
+  Fixture f(argv[1],argv[2]);
+  std::set<mem_fetch *> expected;
+  // 200 lines x 4 sectors x 2 independent requesters exceed both original
+  // Line-MSHR128 and descriptor512 while preserving real sector lower reads.
+  for (unsigned line=0; line<200; ++line) for (unsigned s=0;s<4;++s)
+    for (unsigned copy=0;copy<2;++copy) {
+      auto mf=f.make(0x100000+line*128+s*32);expected.insert(mf);f.push(mf);
+    }
+  for(unsigned n=0;n<40;++n) {
+    auto mf=f.make(0x100000);expected.insert(mf);f.push(mf);
+  }
+  unsigned peak_lines=0,peak_descriptors=0;
+  for(unsigned i=0;i<12000;++i) {
+    f.cycle();
+    peak_lines=std::max(peak_lines,f.sp->ep_l2_line_mshr_entries());
+    peak_descriptors=std::max(peak_descriptors,f.sp->ep_l2_descriptor_count_used());
+    if(f.sp->ep_l2_descriptor_count_used()==1640)break;
+  }
+  assert(peak_lines>128 && peak_descriptors>512);
+  assert(f.sp->ep_l2_descriptor_count_used()==1640);
+  assert(f.sp->ep_l2_line_mshr_entries()==200);
+  f.part->l2_char_release_dram_issue_hold();
+  std::set<mem_fetch *> received;
+  for(unsigned i=0;i<100000 && f.part->busy();++i) {
+    f.cycle();
+    while(auto mf=f.sp->pop()) {
+      assert(expected.count(mf) && received.insert(mf).second);delete mf;
+    }
+  }
+  assert(received==expected);
+  assert(f.sp->ep_l2_lower_read_issue_count()==800);
+  assert(f.sp->ep_l2_descriptor_count_used()==0);
+  assert(!f.part->busy() && f.sp->l2_char_no_resource_leak());
+  f.sp->print_ep_l2_b0_snapshot(stdout,static_cast<unsigned long long>(-1));
+  std::printf("Lane4 I_META production 1640-request/200-line/800-sector/per-address/backpressure: PASS; peak_lines=%u peak_descriptors=%u\n",peak_lines,peak_descriptors);
+}
diff --git a/tests/ep_l2/test_ideal_read_hit.cc b/tests/ep_l2/test_ideal_read_hit.cc
new file mode 100644
index 00000000..236654a6
--- /dev/null
+++ b/tests/ep_l2/test_ideal_read_hit.cc
@@ -0,0 +1,73 @@
+#include "ideal_test_fixture.h"
+
+static void check_known(const std::vector<ep_l2_ideal::Byte> &v,
+                        uint64_t address, unsigned value, unsigned count=32) {
+  assert(v.size() == count);
+  for (unsigned i = 0; i < count; ++i)
+    assert(v[i].address == address+i && v[i].value_known && v[i].value == value);
+}
+
+int main(int argc, char **argv) {
+  assert(argc == 3);
+  {
+    Fixture f(argv[1], argv[2]);
+    f.sp->ep_l2_ideal_seed(0x1000, std::vector<uint8_t>(128, 17));
+    auto r = f.make(0x1020); f.push(r);
+    for (unsigned i = 0; i < 5; ++i) { f.cycle(); assert(f.sp->ep_l2_ideal_reads_served()==0); }
+    auto value = f.read_response(r); check_known(value,0x1020,17);
+    assert(f.gpu->gpu_sim_cycle >= 6); // same nonzero ROP delay as normal hit
+    assert(f.sp->ep_l2_lower_read_issue_count() == 0);
+    // Cold data is a declared symbol, not a fabricated numeric zero.
+    r = f.make(0x2000); f.push(r); value = f.read_response(r);
+    for (auto b : value) assert(!b.value_known && b.version == 0);
+    f.drain();
+  }
+  {
+    Fixture f(argv[1],argv[2]);
+    auto a=f.make(0x3000), b=f.make(0x4000); f.push(a); f.push(b);
+    f.until_reply();
+    for(unsigned i=0;i<20;++i)f.cycle();
+    assert(f.sp->ep_l2_ideal_reads_served()==1);
+    assert(f.sp->ep_l2_icntl2_occupancy()==1);
+    f.read_response(a); f.read_response(b); f.drain();
+  }
+  {
+    Fixture f(argv[1],argv[2]);
+    f.sp->ep_l2_ideal_seed(0x5000,std::vector<uint8_t>(128,3));
+    auto w=f.make(0x5000,true,16); auto r=f.make(0x5000);
+    ep_l2_ideal::ReferenceMemory::Data data{}; data.fill(99);
+    f.sp->ep_l2_ideal_known_write(w,data); f.push(w); f.push(r);
+    f.until_reply(); assert(f.sp->top()==w);
+    for(unsigned i=0;i<20;++i)f.cycle();
+    // An older producer waiting for its real completion cannot be erased.
+    assert(f.sp->ep_l2_ideal_reads_served()==0);
+    assert(f.sp->ep_l2_ideal_dependency_waits()>0);
+    assert(f.sp->pop()==w); delete w;
+    auto value=f.read_response(r); assert(value.size()==32);
+    for(unsigned i=0;i<32;++i) {
+      assert(value[i].value_known && value[i].value==(i<16?99:3));
+      assert((value[i].version>0)==(i<16));
+    }
+    // A younger write cannot retroactively change an already served read.
+    auto before=f.make(0x5000), younger=f.make(0x5000,true);
+    f.push(before); f.push(younger); f.until_reply();
+    auto snapshot=f.sp->ep_l2_ideal_response(before);
+    for(unsigned i=0;i<10;++i)f.cycle();
+    assert(snapshot==f.sp->ep_l2_ideal_response(before));
+    assert(f.sp->pop()==before); delete before;
+    f.until_reply(); assert(f.sp->pop()==younger); delete younger;
+    r=f.make(0x5000);f.push(r);value=f.read_response(r);
+    for(auto byte:value) assert(!byte.value_known && byte.version>0);
+    f.drain();
+  }
+  {
+    // The exact production arbiter enforces a real same-bank fill/read
+    // conflict even though the ideal read has no resident payload owner.
+    ep_l2_payload_store p(2);
+    assert(p.request(ep_l2_payload_store::RESIDENT,0,true,1)==ep_l2_payload_store::GRANTED);
+    assert(p.request(ep_l2_payload_store::IDEAL_REFERENCE,4,false,1)==ep_l2_payload_store::BANK_TRUE_CONTENTION);
+    assert(p.request(ep_l2_payload_store::IDEAL_REFERENCE,4,false,2)==ep_l2_payload_store::GRANTED);
+    assert(p.bank_true_conflict_ops()==1 && p.pending_operations()==0);
+  }
+  std::puts("Lane4 I_READ_HIT production latency/backpressure/byte-version/RAW/WAR/bank tests: PASS");
+}

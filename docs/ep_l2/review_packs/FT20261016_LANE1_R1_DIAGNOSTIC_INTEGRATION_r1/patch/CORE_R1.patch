+static void combined_pressure(const char *base,const char *overlay) {
+  fixture f(base,overlay,1,16,1024,true,true);
+  std::map<new_addr_type,std::array<unsigned long long,4>> memory;
+  for(unsigned i=0;i<50;++i) {

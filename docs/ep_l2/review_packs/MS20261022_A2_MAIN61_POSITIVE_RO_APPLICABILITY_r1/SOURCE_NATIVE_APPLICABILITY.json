  "call_chains": [
    {
      "topic": "certificate_loading",
      "path": "src/gpgpu-sim/ep-l2-ro-runtime.inc",
      "first_line": 34,
      "last_line": 71,
      "finding": "SHA exact manifest/ranges; EP_L2_RO_ORACLE_V1; whole_commandlist; TRACE_MODEL_CLOSED_WORLD + empty unresolved_opcodes for positive; canonical GPU global VA without translation aliases. Empty fallback is a separate status/scope, not measured zero."
    },
    {
      "topic": "range_grammar",
      "path": "src/gpgpu-sim/ep-l2-ro-oracle.h",
      "first_line": 18,
      "last_line": 53,
      "finding": "first_line,last_line_inclusive; lowercase16hex endpoints;128B aligned; inclusive ascending nonoverlap ranges. Runtime validates grammar/hash, not offline classification completeness."
    },
    {
      "topic": "demand_and_new_miss",
      "path": "src/gpgpu-sim/ep-l2-ro-runtime.inc",
      "first_line": 99,
      "last_line": 157,
      "finding": "Only non-atomic GLOBAL_ACC_R on certified lines; one actual frontend-head query ticket/1 simulated cycle/1 port after actual native-directory readiness. accepted_oracle_candidates is accepted hook count, not all trace references or detach eligibility."
    },
    {
      "topic": "tag_owner_and_native_exclusion",
      "path": "src/gpgpu-sim/ep-l2-ro-runtime.inc",
      "first_line": 158,
      "last_line": 218,
      "finding": "Tag index+generation+payload+owner binding. M_ON target lookup through attached Tag only; M_OFF can use native line-MSHR. Dirty/pending/pinned native ownership and ordinary hit do not become new RO transactions. D512/address32 and M_OFF line128 remain real."
    },
    {
      "topic": "set_local_selection",
      "path": "src/gpgpu-sim/ep-l2-ro-runtime.inc",
      "first_line": 220,
      "last_line": 249,
      "finding": "Scan only incoming address set, in physical way order; first live transaction passing can_detach. Positive certificate alone does not imply pending live eligible victim or set pressure."
    },
    {
      "topic": "real_pressure_detach",
      "path": "src/gpgpu-sim/ep-l2-ft-cache.inc",
      "first_line": 299,
      "last_line": 334,
      "finding": "ft_access -> existing merge or Tag probe -> RESERVATION_FAIL -> m_ro->relieve(addr) -> tx.detach -> reprobe. Incoming request need not itself be certified for a same-set RO victim to relieve pressure; preview can convert reserved failure to MISS."
    },
    {
      "topic": "sticky_waiter_and_ready_restrictions",
      "path": "src/gpgpu-sim/ep-l2-ro-transactions.h",
      "first_line": 173,
      "last_line": 209,
      "finding": "merge sets reuse_seen=true until transaction retires. can_detach requires T && attached && !reuse_seen && (required & ~ready). Protection persists after merged waiter retires; all required-ready transactions are not detachable. This is conservative observed-reuse protection, not future-use oracle."
    },
    {
      "topic": "tag_detach_handshake",
      "path": "src/gpgpu-sim/ep-l2-ro-runtime.inc",
      "first_line": 158,
      "last_line": 175,
      "finding": "Check exact owner/generation; invalidate four sectors, clear Tag handle, increment generation. Detach does not free pinned payload/descriptor or create data-ready state."
    },
    {
      "topic": "real_lower_data_response",
      "path": "src/gpgpu-sim/ep-l2-ro-runtime.inc",
      "first_line": 275,
      "last_line": 343,
      "finding": "Issue actual sector lower packets with payload/generation; real DRAM return and sector versions; shared P1 bank response read; stable response/backpressure identity, no hidden buffer."
    },
    {
      "topic": "retirement",
      "path": "src/gpgpu-sim/ep-l2-ro-transactions.h",
      "first_line": 234,
      "last_line": 287,
      "finding": "Fill requires issued sectors and uses actual bank-write; descriptor freed only accepted response enqueue. Denied response retries real bank read."
    },
    {
      "topic": "retirement_final",
      "path": "src/gpgpu-sim/ep-l2-ro-transactions.h",
      "first_line": 356,
      "last_line": 362,
      "finding": "Only no waiters/prepared response and all required+issued ready: unpin; detached payload release only; release native line-MSHR iff M_OFF; retire instance."
    },
    {
      "topic": "epoch_and_closure",
      "path": "src/gpgpu-sim/ep-l2-ro-runtime.inc",
      "first_line": 347,
      "last_line": 414,
      "finding": "Runtime exists iff T||M; commandlist bound by SHA; epoch end requires FT/MSHR/MissQ/RO drain. Certified write/atomic and in-epoch host prefill guard retained. SUMMARY/CLOSURE/RESOURCE counters are per-slice cumulative, not critical-path attribution."
    }

diff --git a/src/gpgpu-sim/ep-l2-ft-cache.inc b/src/gpgpu-sim/ep-l2-ft-cache.inc
index 071ddd4d..580d60dd 100644
--- a/src/gpgpu-sim/ep-l2-ft-cache.inc
+++ b/src/gpgpu-sim/ep-l2-ft-cache.inc
@@ -6,0 +7,22 @@ unsigned long long l2_cache::ft_physical_cycle() const {
+l2_cache::resident_observation l2_cache::resident_observer_snapshot() const {
+  resident_observation s{};
+  s.role_occupied = m_ep_l2_payload.resident_used();
+  s.physical_capacity = m_ep_l2_payload.physical_slots();
+  s.physical_free = m_ep_l2_payload.free_slots();
+  s.physical_occupied = s.physical_capacity - s.physical_free;
+  for (unsigned i = 0; i < m_config.get_num_lines(); ++i) {
+    const auto h = tag_payload_handle(i);
+    if (!m_tag_array->get_block(i)->is_invalid_line() &&
+        m_ep_l2_payload.handle_live(h) &&
+        m_ep_l2_payload.inspect(h).allocation_role == ep_l2_payload_store::RESIDENT)
+      ++s.tag_visible;
+  }
+  if (m_ft_pending.landing_reserved &&
+      m_ep_l2_payload.handle_live(m_ft_pending.landing) &&
+      tag_payload_handle(m_ft_pending.tag_index) != m_ft_pending.landing)
+    s.pending_landing = 1;
+  assert(s.role_occupied >= s.tag_visible + s.pending_landing);
+  s.other_unbound = s.role_occupied - s.tag_visible - s.pending_landing;
+  return s;
+}
+
diff --git a/src/gpgpu-sim/gpu-cache.h b/src/gpgpu-sim/gpu-cache.h
index 4f881212..95d95af3 100644
--- a/src/gpgpu-sim/gpu-cache.h
+++ b/src/gpgpu-sim/gpu-cache.h
@@ -2159 +2159,7 @@ class ep_l2_payload_store {
-  unsigned resident_free() const { return k_resident_slots - resident_used(); }
+  // Legacy nominal RESIDENT-role headroom, not free Tags or unified slots.
+  static unsigned nominal_resident_headroom(unsigned occupied, unsigned capacity) {
+    return occupied < capacity ? capacity - occupied : 0;
+  }
+  unsigned resident_free() const {
+    return nominal_resident_headroom(resident_used(), k_resident_slots);
+  }
@@ -2708,0 +2715,5 @@ class l2_cache : public data_cache {
+  struct resident_observation {
+    unsigned tag_visible, pending_landing, role_occupied, other_unbound;
+    unsigned physical_capacity, physical_occupied, physical_free;
+  };
+  resident_observation resident_observer_snapshot() const;

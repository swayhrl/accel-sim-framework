+  assert(f.cache->ep_l2_descriptor_count_used()==0 && f.cache->ep_l2_payload_pending_operations()==0);
+  assert(f.cache->ft_copy_lines()==50 && f.cache->ft_staging_reads()==50 && f.cache->ft_lower_accepts()==50);

@@ -0,0 +1,64 @@
+// Production regression source; NOT_RUN until exact R1.1 libraries/admission.
+#include "ideal_test_fixture.h"
+
+static mem_access_sector_mask_t sector(unsigned s) {
+  mem_access_sector_mask_t m; m.set(s); return m;
+}
+
+static bool warm(Fixture &f, uint64_t address, unsigned s) {
+  unsigned long long grants[4];
+  for (unsigned b=0;b<4;++b) grants[b]=f.sp->ft_bank_grants_for_test(b);
+  const unsigned offset=f.sp->ft_memcpy_offset_for_test();
+  bool accepted=f.sp->ft_try_force_l2_tag_update(address,
+      f.gpu->gpu_sim_cycle+f.gpu->gpu_tot_sim_cycle,sector(s));
+  for (unsigned b=0;b<4;++b) assert(grants[b]==f.sp->ft_bank_grants_for_test(b));
+  assert(f.sp->ft_memcpy_offset_for_test()==offset+unsigned(accepted));
+  return accepted;
+}
+
+static void unknown(const std::vector<ep_l2_ideal::Byte> &value) {
+  assert(value.size()==32);
+  for (auto b:value) assert(b.version==0 && !b.value_known);
+}
+
+static std::vector<ep_l2_ideal::Byte> read(Fixture &f,uint64_t address) {
+  auto r=f.make(address);f.push(r);auto value=f.read_response(r);f.drain();return value;
+}
+
+int main(int argc,char **argv) {
+  assert(argc==3);Fixture f(argv[1],argv[2]);
+  const uint64_t a=0x100004000ULL, conflict=a+0x1000;
+  f.sp->ep_l2_ideal_seed(a+64,std::vector<uint8_t>(32,17));
+  assert(warm(f,a,0));assert(warm(f,a+32,1));
+  unknown(read(f,a));unknown(read(f,a+32));
+  auto w=f.make(a,true);ep_l2_ideal::ReferenceMemory::Data data{};data.fill(91);
+  f.sp->ep_l2_ideal_known_write(w,data);f.push(w);
+  f.until_reply();assert(f.sp->top()==w);assert(f.sp->pop()==w);delete w;f.drain();
+  auto produced=read(f,a);
+  for (auto b:produced) assert(b.version>0 && b.value_known && b.value==91);
+  // Dirty refusal is before reference mutation; old GPU producer remains visible.
+  assert(!warm(f,a,0));assert(read(f,a)==produced);
+  // An ordinary allocation read bypasses only the ideal read-service entry.
+  // It really evicts dirty A, performs WB/set_done and fills a clean victim.
+  active_mask_t active;active.set(0);mem_access_byte_mask_t bytes;
+  for (unsigned b=0;b<32;++b) bytes.set(b);
+  auto native=f.alloc->alloc(conflict,L1_WR_ALLOC_R,active,bytes,sector(0),32,false,
+      f.gpu->gpu_sim_cycle,0,0,0,nullptr,0);
+  f.push(native);f.until_reply();assert(f.sp->top()==native);
+  assert(f.sp->pop()==native);delete native;f.drain();
+  assert(f.sp->ft_cache_for_test()->ft_copy_lines()==1);
+  assert(f.sp->ft_cache_for_test()->ft_lower_accepts()==1);
+  // Later clean/quiescent prefill is allowed, even after a completed producer.
+  assert(warm(f,a+32,1));assert(read(f,a)==produced);
+  assert(warm(f,a,0));unknown(read(f,a));unknown(read(f,a+32));
+  assert(warm(f,a,0));unknown(read(f,a));
+  // A held real response blocks prefill and preserves its snapshot.
+  auto held=f.make(a);f.push(held);f.until_reply();
+  const auto snapshot=f.sp->ep_l2_ideal_response(held);
+  assert(!warm(f,a,0));assert(snapshot==f.sp->ep_l2_ideal_response(held));
+  assert(f.sp->pop()==held);delete held;f.drain();assert(warm(f,a,0));
+  // Unselected byte/sector state is not globally reset by host initialization.
+  auto untouched=read(f,a+64);
+  for (auto b:untouched) assert(b.version==0 && b.value_known && b.value==17);
+  f.drain();std::puts("IDEAL_HOST_PREFILL_REAL_GPU_WRITE_WB_REINIT_REFUSAL_RESPONSE PASS");
+}
diff --git a/tests/ep_l2/test_ideal_host_prefill_reference.cc b/tests/ep_l2/test_ideal_host_prefill_reference.cc
new file mode 100644
index 00000000..7ec7c85d
--- /dev/null
+++ b/tests/ep_l2/test_ideal_host_prefill_reference.cc
@@ -0,0 +1,44 @@
+// Header-only regression source; execution requires approved build admission.
+#include <cassert>
+#include <cstdio>
+#include "../../src/gpgpu-sim/ep-l2-ideal-reference.h"
+
+int main() {
+  using ep_l2_ideal::ReferenceMemory;
+  ReferenceMemory memory;
+  const uint64_t line = 0x100004000ULL;
+  ReferenceMemory::Mask all{}, selected{}, other{};
+  all.fill(true);
+  for (unsigned b = 32; b < 64; ++b) selected[b] = true;
+  for (unsigned b = 0; b < 32; ++b) other[b] = true;
+  ReferenceMemory::Data data{}; data.fill(91);
+  memory.seed(line, std::vector<uint8_t>(128, 17));
+  memory.write(line, all, &data);
+  auto before = memory.read(line, all);
+  assert(before[0].version > 0);
+  memory.host_prefill(line, selected);
+  auto after = memory.read(line, all);
+  for (unsigned b = 0; b < 128; ++b) {
+    if (selected[b]) {
+      // Replacement host bytes are unknown symbols, never fabricated zero data.
+      assert(after[b].version == 0 && !after[b].value_known);
+    } else assert(after[b] == before[b]);
+  }
+  // Snapshots already handed to responses remain immutable value copies.
+  assert(before[32].version > 0 && before[32].value_known && before[32].value == 91);
+  memory.host_prefill(line, selected);
+  assert(memory.read(line, all) == after);
+  memory.write(line, other);
+  auto next = memory.read(line, all);
+  assert(next[0].version > before[0].version && !next[0].value_known);
+  assert(next[32].version == 0 && !next[32].value_known);
+  // No truncation or reference aliasing of addresses above 4GiB.
+  memory.seed(line & 0xffffffffULL, std::vector<uint8_t>(128, 7));
+  memory.host_prefill(line, other);
+  for (auto b : memory.read(line & 0xffffffffULL, all))
+    assert(b.value_known && b.value == 7);
+  ReferenceMemory fresh;
+  fresh.host_prefill(line, selected);
+  for (auto b : fresh.read(line, selected)) assert(b.version == 0 && !b.value_known);
+  std::puts("IDEAL_HOST_PREFILL_REFERENCE_SECTOR_SNAPSHOT_MONOTONIC_ADDRESS PASS");
+}
diff --git a/tests/ep_l2/test_ideal_meta.cc b/tests/ep_l2/test_ideal_meta.cc
new file mode 100644
index 00000000..7abb08ae
--- /dev/null
+++ b/tests/ep_l2/test_ideal_meta.cc
@@ -0,0 +1,59 @@
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include "../../src/gpgpu-sim/gpu-cache.h"
+
+static mem_fetch *token(unsigned i) {
+  return reinterpret_cast<mem_fetch *>(static_cast<uintptr_t>(i + 1));
+}
+static mem_access_sector_mask_t sector(unsigned i) {
+  mem_access_sector_mask_t s; s.set(i); return s;
+}
+int main() {
+  // The ordinary OFF allocator still refuses at the independent limits.
+  mshr_table off(2, 1, 4, 2, false);
+  off.add_for_test(0x1000, token(0), sector(0));
+  off.add_for_test(0x1000, token(1), sector(0));
+  assert(off.full_reason(0x1000) == mshr_table::EP_L2_BLOCK_PER_ADDRESS_CAP);
+  off.add_for_test(0x2000, token(2), sector(0));
+  assert(off.full_reason(0x3000) == mshr_table::EP_L2_BLOCK_LINE_MSHR_FULL);
+
+  // Cross the original pool, line, and same-address limits many times. No
+  // guessed large capacity is substituted: real descriptor storage grows.
+  for (unsigned count : {1024u, 2048u}) {
+    mshr_table ideal(2, 1, 4, 2, true);
+    for (unsigned i = 0; i < count; ++i) {
+      const new_addr_type line = i < count / 2 ? 0x4000 : 0x8000 + i * 128;
+      assert(ideal.full_reason(line) == mshr_table::EP_L2_BLOCK_NONE);
+      ideal.add_for_test(line, token(i), sector(i % 4));
+    }
+    assert(ideal.descriptor_count_used() == count);
+    assert(ideal.descriptor_pool_capacity() >= count);
+    assert(ideal.num_entries_used() == 1 + count / 2);
+    bool atomic = false;
+    // Partial fill only releases the matching sectors. A response remains
+    // owned until commit; repeated peek is non-destructive.
+    ideal.mark_ready(0x4000, atomic, sector(0));
+    assert(!atomic);
+    assert(ideal.num_response_ready_targets() == count / 8);
+    assert(ideal.peek_next_access() == ideal.peek_next_access());
+    assert(ideal.descriptor_count_used() == count);
+    for (unsigned s = 1; s < 4; ++s) ideal.mark_ready(0x4000, atomic, sector(s));
+    for (unsigned i = count / 2; i < count; ++i)
+      ideal.mark_ready(0x8000 + i * 128, atomic, sector(i % 4));
+    std::set<mem_fetch *> responded;
+    while (ideal.access_ready()) {
+      assert(responded.insert(ideal.peek_next_access()).second);
+      ideal.commit_next_access();
+    }
+    assert(responded.size() == count);
+    assert(ideal.descriptor_count_used() == 0 && ideal.num_entries_used() == 0);
+    // Reuse all dynamic IDs after drain.
+    ideal.add_for_test(0x100000, token(count + 1), sector(3));
+    ideal.mark_ready(0x100000, atomic, sector(3));
+    assert(ideal.peek_next_access() == token(count + 1));
+    ideal.commit_next_access();
+    assert(ideal.descriptor_count_used() == 0);
+  }
+  std::puts("Lane4 I_META allocator/sector/response/doubling tests: PASS");
+}

+++ b/tests/ep_l2/test_ft_host_prefill.cc
@@ -0,0 +1,198 @@
+// Drive actual GPU memcpy -> partition -> Tag/payload and normal WB/response.
+#include <cassert>
+#include <csignal>
+#include <cstdio>
+#include <set>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>

# Append after the SAME original H0 base/trace/target/non-research overlays.
# No L1/ICNT/DRAM/ROP/latency/queue/geometry options are changed here.
-gpgpu_ep_l2_wbuf_entries 16
-gpgpu_ep_l2_payload_mode 2
-gpgpu_ep_l2_descriptor_pool_size 512
-gpgpu_ep_l2_descriptor_per_line_cap 32
-gpgpu_ep_l2_wad_entries 128
-gpgpu_ep_l2_bank_ops 1
-gpgpu_ep_l2_static_s64 0
-gpgpu_ep_l2_wb_local_cap 0
-gpgpu_ep_l2_mq2 0
-gpgpu_ep_l2_rg1 0
-gpgpu_ep_l2_ideal_meta 0
-gpgpu_ep_l2_ideal_read_hit 0
-gpgpu_ep_l2_ideal_wb 0
-gpgpu_ep_l2_payload_policy 0
-gpgpu_ep_l2_feature_unified_payload 0
-gpgpu_ep_l2_feature_ro_pending_state 0
-gpgpu_ep_l2_feature_tvd 0
-gpgpu_ep_l2_feature_adaptive_policy 0
-gpgpu_ep_l2_ft_mode 1
-gpgpu_ep_l2_diag_copy_free 1
-gpgpu_ep_l2_diag_l2_data_free 0
-gpgpu_ep_l2_ms_observer 0

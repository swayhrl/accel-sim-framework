+    assert(f.admit(missing)!=RESERVATION_FAIL);f.issue();
+    assert(f.port.packets.size()==1);packet=f.port.packets.front();f.port.packets.pop_front();
+    assert(!packet->ro_lower_packet());while(!f.fill(packet)){}
+    f.consume(3);f.finish();

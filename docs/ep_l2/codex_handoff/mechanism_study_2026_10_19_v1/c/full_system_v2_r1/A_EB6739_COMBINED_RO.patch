+    if (!m_features.line_mshr_bypass) m_shared.release_ro_line(e.line);
+    e.live = false;
+  }
+  mshr_table &m_shared;
+  payload_port &m_port;
+  std::vector<entry> m_slots;  // fixed bound: one completion per physical slot
+  switches m_features;
+  const oracle_certificate &m_oracle;
+  uint64_t m_epoch;
+  bool m_epoch_open;
+};
+}  // namespace ep_l2_ro

+  }
+  const entry &get(identity h) const {
+    return const_cast<transactions *>(this)->get(h);
+  }
+  void retire_if_done(entry &e) {
+    if (!e.waiters.empty() || e.prepared || (e.required & ~e.ready) ||
+        (e.issued & ~e.ready)) return;

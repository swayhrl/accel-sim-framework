diff --git a/tests/ep_l2/test_ro_transactions.cc b/tests/ep_l2/test_ro_transactions.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c27ed80cc355e99923c9779a197a243cc4c699e3
--- /dev/null

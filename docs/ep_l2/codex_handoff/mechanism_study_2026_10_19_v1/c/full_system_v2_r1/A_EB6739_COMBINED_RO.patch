+  // requester capacity or extra hardware port. Sample on real lower acceptance;
+  // fills/retirements cannot increase either pending-lower peak.
+  void observe_lower_peaks() {
+    std::array<new_addr_type,1168> lines;
+    unsigned n=0;
+    for(const auto &e:m_slots)
+      if(e.live && (e.issued&~e.ready))lines[n++]=e.line;
+    stats.peak_lower_transactions=std::max(stats.peak_lower_transactions,n);
+    std::sort(lines.begin(),lines.begin()+n);
+    const unsigned unique=std::unique(lines.begin(),lines.begin()+n)-lines.begin();
+    stats.peak_independent_lower_lines=std::max(stats.peak_independent_lower_lines,unique);
+  }
+  void observe_peaks() {
+    stats.peak_transactions=std::max(stats.peak_transactions,live_transactions());
+    stats.peak_shared_descriptors=std::max(stats.peak_shared_descriptors,m_shared.descriptor_count_used());
+    stats.peak_shared_lines=std::max(stats.peak_shared_lines,m_shared.num_entries_used());
+  }
+  struct waiter {
+    mshr_table::ro_descriptor_handle descriptor;
+    // Chain membership only. Request pointer and sector mask live exclusively
+    // in the existing sharedD512 descriptor, never in a second waiter record.
+    waiter(mshr_table::ro_descriptor_handle d, mem_fetch *, unsigned)
+      : descriptor(d) {}
+  };
+  unsigned waiter_mask(const waiter &w) const {
+    return m_shared.ro_descriptor_sectors(w.descriptor).to_ulong();
+  }
+  mem_fetch *waiter_request(const waiter &w) const {
+    return m_shared.ro_descriptor_request(w.descriptor);
+  }
+  struct entry {
+    bool live, attached, reuse_seen, prepared, response_chosen;
+    unsigned required, issued, ready, prepared_index;
+    identity h; tag_binding tag; new_addr_type line; uint64_t epoch, prepared_cycle;
+    std::vector<waiter> waiters;
+    entry() : live(false), attached(false), reuse_seen(false), prepared(false),response_chosen(false),
+      required(0), issued(0), ready(0), prepared_index(0), line(0), epoch(0), prepared_cycle(0) {}
+  };
+  static void check_mask(unsigned mask) {
+    if (!mask || (mask & ~15U)) throw std::invalid_argument("invalid sector mask");
+  }
+  static unsigned bits(unsigned mask) {
+    return (mask & 1) + ((mask >> 1) & 1) + ((mask >> 2) & 1) + ((mask >> 3) & 1);
+  }
+  static mem_access_sector_mask_t sector_mask(unsigned mask) {
+    return mem_access_sector_mask_t(mask);
+  }
+  entry &get(identity h) {
+    if (h.payload_id >= m_slots.size() || !m_slots[h.payload_id].live ||
+        !(m_slots[h.payload_id].h == h) || !m_port.live(h, m_slots[h.payload_id].line))

diff --git a/src/gpgpu-sim/ep-l2-ro-mshr.inc b/src/gpgpu-sim/ep-l2-ro-mshr.inc
new file mode 100644
index 0000000000000000000000000000000000000000..de0e5b504072158b100111f0f0aaa004e2cf1260
--- /dev/null
+++ b/src/gpgpu-sim/ep-l2-ro-mshr.inc
@@ -0,0 +1,107 @@
+// Included once in gpu-cache.cc after mshr_table declarations.
+// Uses the existing native line table and D512 free-list only.
+unsigned mshr_table::ro_targets_on_line(new_addr_type line) const {
+  if (!m_ro_descriptor_count) return 0;
+  unsigned count = 0;
+  for (unsigned i = 0; i < m_descriptor_pool.size(); ++i)
+    if (m_descriptor_pool[i].m_ro_external &&
+        m_descriptor_pool[i].m_ro_line == line) ++count;
+  return count;
+}
+
+unsigned mshr_table::targets_on_line(new_addr_type line) const {
+  table::const_iterator entry = m_data.find(line);
+  return ro_targets_on_line(line) +
+         (entry == m_data.end() ? 0 : entry->second.m_list.size());
+}
+
+bool mshr_table::reserve_ro_descriptor(
+    new_addr_type line, mem_fetch *mf, const mem_access_sector_mask_t &sectors,
+    ro_descriptor_handle &result) {
+  result = ro_descriptor_handle();
+  if (!m_descriptor_pool_size || !mf || sectors.none() ||
+      targets_on_line(line) >= m_descriptor_per_line_cap ||
+      m_free_descriptor_ids.empty()) return false;
+  for (unsigned n = 0; n < m_descriptor_pool.size(); ++n)
+    if (m_descriptor_pool[n].m_mf == mf) return false;
+  const unsigned id = m_free_descriptor_ids.back();
+  ep_l2_descriptor &d = m_descriptor_pool[id];
+  assert(!d.m_mf && !d.m_ro_external);
+  // Never permit a generation wrap to turn a stale descriptor into a live one.
+  assert(d.m_ro_generation != ~0ULL);
+  ++d.m_ro_generation;
+  d.m_mf = mf; d.m_sectors = sectors; d.m_ro_external = true;
+  d.m_ro_line = line; d.m_response_queued = false;
+  m_free_descriptor_ids.pop_back();
+  ++m_ro_descriptor_count;
+  result = ro_descriptor_handle(id, d.m_ro_generation);
+  return true;
+}
+
+bool mshr_table::ro_descriptor_live(const ro_descriptor_handle &h) const {
+  return h.valid() && h.id < m_descriptor_pool.size() &&
+         m_descriptor_pool[h.id].m_ro_external &&
+         m_descriptor_pool[h.id].m_ro_generation == h.generation;
+}
+
+void mshr_table::release_ro_descriptor(const ro_descriptor_handle &h) {
+  assert(ro_descriptor_live(h));
+  ep_l2_descriptor &d = m_descriptor_pool[h.id];
+  const unsigned long long generation = d.m_ro_generation;
+  d = ep_l2_descriptor();
+  d.m_ro_generation = generation;
+  --m_ro_descriptor_count;
+  m_free_descriptor_ids.push_back(h.id);
+}
+
+bool mshr_table::reserve_ro_line(new_addr_type line) {
+  if (m_data.find(line) != m_data.end() || m_data.size() >= m_num_entries)
+    return false;
+  m_data[line].m_ro_line_owner = true;
+  return true;
+}
+
+void mshr_table::bind_ro_line(new_addr_type line, ep_l2::PayloadHandle h) {
+  assert(m_data.at(line).m_ro_line_owner); m_data.at(line).m_ro_handle=h;
+}
+bool mshr_table::lookup_ro_line(new_addr_type line, ep_l2::PayloadHandle &h) const {
+  auto it=m_data.find(line);
+  if(it==m_data.end() || !it->second.m_ro_line_owner)return false;
+  h=it->second.m_ro_handle;return true;
+}
+
+void mshr_table::release_ro_line(new_addr_type line) {
+  table::iterator e = m_data.find(line);
+  assert(e != m_data.end() && e->second.m_ro_line_owner);
+  assert(e->second.m_pending_sectors.none() && ro_targets_on_line(line) == 0);
+  e->second.m_ro_line_owner = false;
+  if (e->second.m_list.empty()) m_data.erase(e);
+}
+
+void mshr_table::ro_line_issue(new_addr_type line,
+                              const mem_access_sector_mask_t &mask) {
+  table::iterator e = m_data.find(line);
+  assert(e != m_data.end() && e->second.m_ro_line_owner);
+  assert((mask & e->second.m_issued_sectors).none());
+  e->second.m_issued_sectors |= mask;
+  e->second.m_pending_sectors |= mask;
+}
+
+void mshr_table::ro_line_ready(new_addr_type line,
+                              const mem_access_sector_mask_t &mask) {
+  table::iterator e = m_data.find(line);
+  assert(e != m_data.end() && e->second.m_ro_line_owner);
+  assert((mask & ~e->second.m_pending_sectors).none());
+  e->second.m_pending_sectors &= ~mask;
+  e->second.m_ready_sectors |= mask;
+}
+
+
+mem_fetch *mshr_table::ro_descriptor_request(const ro_descriptor_handle &h) const {
+  if (!ro_descriptor_live(h)) throw std::logic_error("stale shared RO descriptor");
+  return m_descriptor_pool[h.id].m_mf;
+}
+mem_access_sector_mask_t mshr_table::ro_descriptor_sectors(const ro_descriptor_handle &h) const {
+  if (!ro_descriptor_live(h)) throw std::logic_error("stale shared RO descriptor");
+  return m_descriptor_pool[h.id].m_sectors;
+}
diff --git a/src/gpgpu-sim/ep-l2-ro-oracle.h b/src/gpgpu-sim/ep-l2-ro-oracle.h
new file mode 100644
index 0000000000000000000000000000000000000000..6a098854b8921fd4651d4280107d62cd4307d472
--- /dev/null
+++ b/src/gpgpu-sim/ep-l2-ro-oracle.h
@@ -0,0 +1,70 @@
+#ifndef EP_L2_RO_ORACLE_H
+#define EP_L2_RO_ORACLE_H
+#include <algorithm>
+#include <cstdint>
+#include <istream>
+#include <iterator>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace ep_l2_ro {
+// Experimental, shared read-only input. The launch preflight verifies the
+// complete manifest/artifact/trace hashes before handing these bytes to Core.
+// This parser validates the range grammar, not cryptographic hashes itself.
+class oracle_certificate {
+ public:
+  oracle_certificate(std::istream &verified_ranges,
+                     const std::string &verified_manifest_sha256,
+                     const std::string &scope)
+      : m_manifest(verified_manifest_sha256) {
+    if ((scope != "TRACE_MODEL_CLOSED_WORLD" && scope != "NO_READONLY_CERTIFICATION") || m_manifest.size() != 64 ||
+        m_manifest.find_first_not_of("0123456789abcdef") != std::string::npos)
+      throw std::invalid_argument("unverified oracle scope/identity");
+    std::string line;
+    if (!std::getline(verified_ranges,line))
+      throw std::invalid_argument("empty oracle input");
+    if (!line.empty() && line.back()=='\r') line.pop_back();
+    if (line != "first_line,last_line_inclusive")
+      throw std::invalid_argument("unsupported oracle range grammar");
+    while (std::getline(verified_ranges,line)) {
+      if (!line.empty() && line.back()=='\r') line.pop_back();
+      if (line.size()!=33 || line[16]!=',' ||
+          line.substr(0,16).find_first_not_of("0123456789abcdef")!=std::string::npos ||
+          line.substr(17).find_first_not_of("0123456789abcdef")!=std::string::npos)
+        throw std::invalid_argument("corrupt oracle range");
+      uint64_t first=std::stoull(line.substr(0,16),NULL,16);
+      uint64_t last=std::stoull(line.substr(17),NULL,16);
+      if (first%128 || last%128 || first>last ||
+          (!m_ranges.empty() && first<=m_ranges.back().second))
+        throw std::invalid_argument("unaligned/overlapping oracle range");
+      m_ranges.push_back(std::make_pair(first,last));
+    }
+    if (!verified_ranges.eof()) throw std::invalid_argument("incomplete oracle read");
+    if(scope=="NO_READONLY_CERTIFICATION" && !m_ranges.empty())
+      throw std::invalid_argument("native fallback must certify zero lines");
+  }
+  bool contains(uint64_t line) const {
+    if (line%128) return false;
+    auto it=std::upper_bound(m_ranges.begin(),m_ranges.end(),
+                            std::make_pair(line,~uint64_t(0)));
+    if (it==m_ranges.begin()) return false;
+    --it;return line<=it->second;
+  }
+  const std::string &manifest_sha256() const { return m_manifest; }
+  bool overlaps_bytes(uint64_t address,uint64_t count) const {
+    if (!count) return false;
+    if (count-1>~uint64_t(0)-address) throw std::invalid_argument("host range overflow");
+    const auto first=address&~uint64_t(127),last=(address+count-1)&~uint64_t(127);
+    auto it=std::lower_bound(m_ranges.begin(),m_ranges.end(),std::make_pair(first,uint64_t(0)));
+    if (it!=m_ranges.begin() && std::prev(it)->second>=first) return true;
+    return it!=m_ranges.end() && it->first<=last;
+  }
+  unsigned range_count() const { return m_ranges.size(); }
+ private:
+  std::string m_manifest;
+  std::vector<std::pair<uint64_t,uint64_t> > m_ranges;
+};
+} // namespace ep_l2_ro
+#endif

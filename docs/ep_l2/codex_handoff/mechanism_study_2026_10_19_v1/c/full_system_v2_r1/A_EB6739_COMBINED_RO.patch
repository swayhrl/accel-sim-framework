+    check_mask(mask);
+    entry &e = get(h);
+    if ((mask & ~e.issued) || (mask & e.ready))
+      throw std::logic_error("unexpected or repeated fill");
+    if (e.attached && !m_port.tag_matches(e.tag, h, e.line))
+      throw std::logic_error("stale attached fill tag generation");

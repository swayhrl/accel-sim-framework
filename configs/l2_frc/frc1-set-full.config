# One FRC sector entry makes its set-full fallback deterministic.  Keep two L2
# ways so the conventional fallback can reserve a different victim while the
# FRC fetch still owns its delayed-swap candidate.
-gpgpu_l2_frc_enable 1
-gpgpu_l2_frc_entries 1
-gpgpu_l2_frc_assoc 1
-gpgpu_l2_frc_lookup_latency 0
-gpgpu_l2_frc_swap_latency 0
-gpgpu_l2_frc_conservative_timing 0
-gpgpu_cache:dl2 S:1:128:2,L:B:m:L:L,A:192:4,32:0,32

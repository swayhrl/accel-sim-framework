# 256 partition-local sector entries / L2 subpartition, 8-way, paper timing.
# 256 x 32 bytes equals two conventional 32-set x 128-byte L2 ways.
-gpgpu_l2_frc_enable 1
-gpgpu_l2_frc_entries 256
-gpgpu_l2_frc_assoc 8
-gpgpu_l2_frc_lookup_latency 0
-gpgpu_l2_frc_swap_latency 0
-gpgpu_l2_frc_conservative_timing 0

# One-way L2 plus 128 partition-local FRC sectors (one conventional L2 way
# of payload per slice) in paper timing mode.
-gpgpu_l2_frc_enable 1
-gpgpu_l2_frc_entries 128
-gpgpu_l2_frc_assoc 8
-gpgpu_l2_frc_lookup_latency 0
-gpgpu_l2_frc_swap_latency 0
-gpgpu_l2_frc_conservative_timing 0
-gpgpu_cache:dl2 S:32:128:1,L:B:m:L:P,A:192:4,32:0,32

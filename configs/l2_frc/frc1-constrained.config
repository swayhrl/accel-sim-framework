# Forward-progress stress: every partition FIFO is four entries deep, and the
# conventional L2 has one MSHR.  Shallower attempted controls did not drain
# this trace, so retain this known-good constrained point for comparison.
# Keep four miss-queue slots because the cache treats a queue of one as full
# even before it can enqueue a single miss.
-gpgpu_l2_frc_enable 1
-gpgpu_l2_frc_entries 1
-gpgpu_l2_frc_assoc 1
-gpgpu_l2_frc_lookup_latency 0
-gpgpu_l2_frc_swap_latency 0
-gpgpu_l2_frc_conservative_timing 0
-gpgpu_l2_latebind_stats 1
-gpgpu_dram_partition_queues 4:4:4:4
-gpgpu_cache:dl2 S:1:128:1,L:B:m:L:L,A:1:1,4:0,32

# Conventional constrained-resource control.  Four entries are the smallest
# partition FIFO depth that lets this dirty writeback trace drain; use one MSHR
# to retain an independently meaningful L2 admission constraint.
-gpgpu_l2_frc_enable 0
-gpgpu_l2_latebind_stats 1
-gpgpu_dram_partition_queues 4:4:4:4
-gpgpu_cache:dl2 S:1:128:1,L:B:m:L:L,A:1:1,4:0,32

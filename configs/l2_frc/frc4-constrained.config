# Four-sector counterpart to frc1-constrained.config.  This keeps one L2 MSHR
# and four-entry partition FIFOs while allowing a same-set read burst to use
# four independent FRC transaction slots.
-gpgpu_l2_frc_enable 1
-gpgpu_l2_frc_entries 4
-gpgpu_l2_frc_assoc 4
-gpgpu_l2_frc_lookup_latency 0
-gpgpu_l2_frc_swap_latency 0
-gpgpu_l2_frc_conservative_timing 0
-gpgpu_l2_latebind_stats 1
-gpgpu_dram_partition_queues 4:4:4:4
-gpgpu_cache:dl2 S:1:128:1,L:B:m:L:L,A:1:1,4:0,32

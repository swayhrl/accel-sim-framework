# C14 Path N contrast microdiagnostic final geometry override.
# Exact-page F7-like L2 with Segment N=8 and Lseg=5.
-gpgpu_vm_fair_arm 0
-gpgpu_vm_l2_tlb_entries 320
-gpgpu_vm_l2_tlb_assoc 16
-gpgpu_vm_l2_tlb_mode 0
-gpgpu_vm_weight_segmentation_enable 1
-gpgpu_vm_weight_segment_entries 8
-gpgpu_vm_weight_segment_lookup_latency 5

# C14 Path P microdiagnostic final geometry override.
# Appended after the immutable C12 platform configuration by the C14 launcher.
# This is exact-page L2 (not SUBENTRY_16), with the C12 F7 capacity allocation.
-gpgpu_vm_fair_arm 0
-gpgpu_vm_l2_tlb_entries 320
-gpgpu_vm_l2_tlb_assoc 16
-gpgpu_vm_l2_tlb_mode 0
-gpgpu_vm_weight_segmentation_enable 1
-gpgpu_vm_weight_segment_entries 8
-gpgpu_vm_weight_segment_lookup_latency 10

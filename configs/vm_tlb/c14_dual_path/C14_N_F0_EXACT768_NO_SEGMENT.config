# C14 Path N microdiagnostic final geometry override.
# Exact-page L2 F0-like reference, deliberately without Segment.
-gpgpu_vm_fair_arm 0
-gpgpu_vm_l2_tlb_entries 768
-gpgpu_vm_l2_tlb_assoc 16
-gpgpu_vm_l2_tlb_mode 0
-gpgpu_vm_weight_segmentation_enable 0
# Disabled Segment requires zero charged descriptors and zero service latency;
# preserve the inherited registration path solely as ordinary-PTW PA mapping.
-gpgpu_vm_weight_segment_entries 0
-gpgpu_vm_weight_segment_lookup_latency 0

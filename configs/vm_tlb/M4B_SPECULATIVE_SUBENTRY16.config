# SPECULATIVE_CANDIDATE only.  This inherits the frozen M4C paper-platform
# shell and changes exactly the L2 interpretation selected by C1.
#
# REFERENCE_APPROX_SUBENTRY_16: a 768-entry, 16-way L2 stores 16 64KiB leaves
# per group.  Existing M4C L1/L2 port counts and service latencies are retained
# as MODEL_DECISIONs; this file is not a target-paper timing reconstruction.
-gpgpu_n_clusters 35
-gpgpu_n_cores_per_cluster 1
-gpgpu_clock_domains 1500:1500:1500:3500.5
-gpgpu_unified_l1d_size 128
-gpgpu_cache:dl1 S:4:128:256,L:T:m:L:L,A:384:48,16:0,32
-gpgpu_n_mem 12
-gpgpu_n_sub_partition_per_mchannel 2
-gpgpu_cache:dl2 S:64:128:16,L:B:m:L:P,A:192:4,32:0,32
-gpgpu_vm_mode 2
-gpgpu_vm_page_size 65536
-gpgpu_vm_l1_tlb_entries 32
-gpgpu_vm_l1_tlb_assoc 32
-gpgpu_vm_l1_tlb_ports 1
-gpgpu_vm_l1_tlb_lookup_latency 10
-gpgpu_vm_l2_tlb_entries 768
-gpgpu_vm_l2_tlb_assoc 16
-gpgpu_vm_l2_tlb_ports 1
-gpgpu_vm_l2_tlb_lookup_latency 80
-gpgpu_vm_l2_tlb_mode 1
-gpgpu_vm_translation_mshr_entries 32
-gpgpu_vm_pwq_entries 32
-gpgpu_vm_walkers 16
-gpgpu_vm_ptw_mode 1
-gpgpu_vm_pt_levels 4
-gpgpu_vm_virtual_address_bits 49
-gpgpu_vm_pwc_mode 1
-gpgpu_vm_pwc_entries 128
-gpgpu_vm_pwc_lookup_latency 1

# ATA-like reference: exact aggregated tags within one eight-SM cluster.
# The model uses the paper's 7-cycle tag lookup, 14-cycle line access, and
# four aggregate-tag requests per cluster per cycle.
-c2p_cache_enable 1
-c2p_cache_oracle_only 0
-c2p_cache_collect_oracle 1
-c2p_cache_scheme 1
-c2p_cache_ata_cluster_issue_width 4
-c2p_cache_ata_tag_latency 7
-c2p_cache_peer_line_latency 14

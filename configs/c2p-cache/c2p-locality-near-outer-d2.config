# Two-tier far-L1 sensitivity: outer group4 targets pay two extra cycles on
# the request and two on the return, in addition to canonical tag/return time.
-c2p_cache_locality_observe 1
-c2p_cache_locality_group_size 4
-c2p_cache_locality_aware_candidate_order 1
-c2p_cache_locality_outer_probe_extra_latency 2
-c2p_cache_locality_outer_return_extra_latency 2

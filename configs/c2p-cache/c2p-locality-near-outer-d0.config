# Two-tier far-L1 sensitivity: local group4 candidates are selected first,
# but all targets retain the canonical remote latency.  This isolates the
# ordering effect from a distance-dependent network delay.
-c2p_cache_locality_observe 1
-c2p_cache_locality_group_size 4
-c2p_cache_locality_aware_candidate_order 1
-c2p_cache_locality_outer_probe_extra_latency 0
-c2p_cache_locality_outer_return_extra_latency 0

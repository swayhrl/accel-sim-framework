# Outer-tail admission integration control.  A zero threshold admits every
# eligible tail, so this must be behaviorally identical to local-first C2P.
-c2p_cache_locality_observe 1
-c2p_cache_locality_group_size 4
-c2p_cache_locality_aware_candidate_order 1
-c2p_cache_outer_admission_policy 1
-c2p_cache_outer_admission_score_threshold 0
-c2p_cache_outer_admission_initial_score 0
-c2p_cache_outer_admission_explore_period 0

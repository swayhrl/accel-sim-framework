# Paper-oriented sensitivity point: valid 64KiB, 128B-line, 32-way L1D.
# 16 sets x 32 ways x 128B = 64KiB.  The paper's table says "4 sets" as
# well as 64KiB, which is arithmetically inconsistent; this is the primary
# capacity-preserving interpretation.
-gpgpu_n_clusters 64
-gpgpu_occupancy_sm_number 64
-gpgpu_cache:dl1 S:16:128:32,L:T:m:L:L,A:512:8,16:0,32
-gpgpu_l1_banks 4
-gpgpu_l1_latency 4

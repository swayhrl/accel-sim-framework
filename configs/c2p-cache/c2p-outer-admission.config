# C2P+ outer-only admission policy.  Same 64 x four-bin 3-bit table capacity
# as AddrTopo confirmation; a periodic exploration probe keeps labels alive.
-c2p_cache_locality_observe 1
-c2p_cache_locality_group_size 4
-c2p_cache_locality_aware_candidate_order 1
-c2p_cache_outer_admission_policy 1
-c2p_cache_outer_admission_score_threshold 4
-c2p_cache_outer_admission_initial_score 4
-c2p_cache_outer_admission_explore_period 64

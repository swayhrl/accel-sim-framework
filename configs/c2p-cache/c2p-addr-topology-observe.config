# Read-only C2P+ feature study.  Candidate issue, target arbitration, and
# fallback remain exhaustive C2P+; only first-post-miss observations are added.
-c2p_cache_separate_target_tag_port 1
-c2p_cache_max_candidate_probes 0
-c2p_cache_adaptive_probe_policy 0
-c2p_cache_adaptive_probe_observe_tail 1
-c2p_cache_adaptive_probe_observe_addr_topology 1

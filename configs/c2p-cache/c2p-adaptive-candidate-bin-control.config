# Exhaustive C2P+ control for the candidate-count observation.  The read-only
# tail observation runs in both pair members; it does not alter issue timing.
-c2p_cache_separate_target_tag_port 1
-c2p_cache_max_candidate_probes 0
-c2p_cache_adaptive_probe_policy 0
-c2p_cache_adaptive_probe_observe_tail 1

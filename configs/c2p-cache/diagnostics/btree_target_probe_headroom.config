# Diagnostic only: separates finite target-probe headroom from Snapshot
# filtering quality.  The paper does not specify a 32-entry/32-cycle remote
# probe escape; this run enlarges both limits without changing Bloom geometry,
# engine count, remote timing, or the baseline hierarchy.
-c2p_cache_target_probe_queue_size 256
-c2p_cache_probe_timeout 4096

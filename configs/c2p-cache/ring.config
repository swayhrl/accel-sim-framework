# RING-like reference: chip-wide CCN discovery with the C2P paper's two-cycle
# hop and seven-cycle copied-tag lookup assumptions.  Requests reserve the
# directed links they traverse; a single global injector is not a ring.
-c2p_cache_enable 1
-c2p_cache_oracle_only 0
-c2p_cache_collect_oracle 1
-c2p_cache_scheme 3
-c2p_cache_ring_hop_latency 2
-c2p_cache_remote_tag_latency 7
-c2p_cache_peer_line_latency 14
# CCN [Dublish et al., TACO 2016] sends new misses directly to L2 when its
# finite request queues/buffers are congested.  This is distinct from C2P's
# query-queue escape and is tracked as c2p_ring_queue_bypasses.
-c2p_cache_ring_queue_fallback 1
# CCN-RT [Dublish et al.] samples each source SM for 1M scalar instructions
# in a 10M-instruction epoch.  Sources below 5% observed remote-hit rate send
# later misses directly to L2 while their copied tags remain searchable.
-c2p_cache_ring_link_pipeline 1
-c2p_cache_ring_request_throttle 1
-c2p_cache_ring_throttle_sample_instructions 1000000
-c2p_cache_ring_throttle_period_instructions 10000000
-c2p_cache_ring_throttle_min_hit_percent 5

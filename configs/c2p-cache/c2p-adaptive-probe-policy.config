# C2P+ PC-hash confirmation package. First candidate always probes; after a
# miss, one 64 PC-hash x 4 candidate-bin, 3-bit score selects lower fallback
# or confirmation through ordinal four. Hit +2 / miss -1 and threshold 4
# encode a roughly one-third break-even hit probability; exploration prevents
# a cold or unlucky bucket from being permanently censored.
-c2p_cache_separate_target_tag_port 1
-c2p_cache_max_candidate_probes 0
-c2p_cache_adaptive_probe_policy 1
-c2p_cache_adaptive_probe_score_threshold 4
-c2p_cache_adaptive_probe_explore_period 64
-c2p_cache_adaptive_probe_package_policy 1

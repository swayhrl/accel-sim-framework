# C2P+ bin-aware confirmation package with an address-region x requester-
# cluster feature hash.  This is deliberately capacity-matched to the PC
# policy: 64 feature buckets x four candidate-count bins, 3 bits each. Every
# bin uses this table; there is no PC-indexed low-bin side policy. All remaining
# knobs are identical to c2p-adaptive-package-policy.config.
-c2p_cache_separate_target_tag_port 1
-c2p_cache_max_candidate_probes 0
-c2p_cache_adaptive_probe_policy 1
-c2p_cache_adaptive_probe_score_threshold 4
-c2p_cache_adaptive_probe_explore_period 64
-c2p_cache_adaptive_probe_package_policy 1
-c2p_cache_adaptive_probe_addr_topology_policy 1
-c2p_cache_adaptive_probe_observe_tail 1

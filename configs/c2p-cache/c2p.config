# Paper-shaped Snapshot Matrix C2P defaults.  Values absent from the paper are
# recorded in the model contract and remain explicit here.
-c2p_cache_enable 1
-c2p_cache_oracle_only 0
-c2p_cache_ideal_peer 0
-c2p_cache_collect_oracle 1
-c2p_cache_scheme 0
-c2p_cache_bf_engines 128
-c2p_cache_bf_latency 2
# Default preserves the paper's 64 banks x (64 BF + 16 tag-mask) rows and
# four total encodings (one tag mask plus three BF hashes).
-c2p_cache_snapshot_bf_rows_per_bank 64
-c2p_cache_bf_hashes 3
-c2p_cache_snapshot_latency 2
-c2p_cache_remote_tag_latency 7
-c2p_cache_remote_return_latency 2
# Canonical C2P keeps candidate order unchanged and has no outer-tail policy.
# Pin both defaults so timing sensitivity replays can audit their resolved
# configurations rather than relying on C++ constructor defaults.
-c2p_cache_locality_aware_candidate_order 0
-c2p_cache_outer_admission_policy 0
-c2p_cache_snapshot_copies 4
-c2p_cache_query_queue_size 256
-c2p_cache_update_queue_size 1024
-c2p_cache_update_transport_bytes_per_cycle 128
# The paper continuously refreshes one column after another; a long idle gap
# turns the insertion-only BF into stale metadata after ordinary evictions.
-c2p_cache_snapshot_rebuild_interval 0
-c2p_cache_probe_timeout 32
# The paper requires finite target-side contention/fallback.  Pin the backend
# default explicitly so a future default change cannot silently alter a replay.
-c2p_cache_target_probe_queue_size 32
# The port-bypass switch is a separate counterfactual diagnostic and is never
# enabled by a canonical paper-comparison replay.
-c2p_cache_diagnostic_target_port_bypass 0

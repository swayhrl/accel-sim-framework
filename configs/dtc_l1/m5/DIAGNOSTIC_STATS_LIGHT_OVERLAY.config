# SIM_HOST A3 host-cost-only diagnostic overlay. Apply after an unchanged M5
# PAPER_* config and DIAGNOSTIC_HOST_CUTOFF_2M.config.
# It is never a formal identity until same-trace/same-cutoff equivalence passes.
# Source anchors: gpu-sim.cc:2600-2603 writes a gzip perf-counter sample at
# gpgpu_runtime_stat frequency; mem_latency_stat.cc gates latency histograms on
# gpgpu_memlatency_stat.  The M5 strict parser consumes neither output family.
-gpgpu_runtime_stat 500000
-gpgpu_memlatency_stat 0
# ptx-stats.cc currently still updates its internal map at 0; this suppresses
# only the final line-stat file and is retained to measure that limited effect.
-enable_ptx_file_line_stats 0
